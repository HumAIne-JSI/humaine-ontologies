<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns="http://www.example.org/activelearningontology#">
		 
		  <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://www.example.org/SwarmLearningOntology">
        <rdfs:comment>Initial version of the formal ontology representing generic concepts and processes in Swarm Learning systems. Developed within HumAIne progect</rdfs:comment>
    </owl:Ontology>

<owl:Class rdf:about="#SwarmLearning">
    <rdfs:label xml:lang="en">SwarmLearning</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the top-level class for the entire Swarm Learning system.</rdfs:comment>
</owl:Class>

<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Classes -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->
<!--  -->
 
<owl:Class rdf:about="#SLPipeline">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">SLPipeline</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the pipeline or workflow that guides the entire Swarm Learning process.</rdfs:comment>
</owl:Class>

<!-- SLPipeline SubClasses -->

<!-- LocalTraining SubClass -->

<owl:Class rdf:about="#LocalTraining">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">LocalTraining</rdfs:label>
    <rdfs:comment xml:lang="en">The stage in the Swarm Learning pipeline where models are trained locally on each node's data.</rdfs:comment>
</owl:Class>

<!-- DataCollection SubClass -->

<owl:Class rdf:about="#DataCollection">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">DataCollection</rdfs:label>
    <rdfs:comment xml:lang="en">The initial stage in the Swarm Learning pipeline where data is collected at each node.</rdfs:comment>
</owl:Class>

<!-- ModelAggregation SubClass -->

<owl:Class rdf:about="#ModelAggregation">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">ModelAggregation</rdfs:label>
    <rdfs:comment xml:lang="en">The stage where local models are aggregated into a global model, combining the knowledge from each node.</rdfs:comment>
</owl:Class>

<!--  Evaluation SubClass -->

<owl:Class rdf:about="#Evaluation">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">Evaluation</rdfs:label>
    <rdfs:comment xml:lang="en">The stage where the aggregated model is evaluated using predefined metrics.</rdfs:comment>
</owl:Class>

<!--  FeedbackLoop SubClass -->

<owl:Class rdf:about="#FeedbackLoop">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">FeedbackLoop</rdfs:label>
    <rdfs:comment xml:lang="en">A stage in the Swarm Learning pipeline that feeds evaluation results back into the system for continuous improvement.</rdfs:comment>
</owl:Class>

<!--  DataPreprocessing SubClass (optional) -->

<owl:Class rdf:about="#DataPreprocessing">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">DataPreprocessing</rdfs:label>
    <rdfs:comment xml:lang="en">An optional stage where raw data is cleaned, normalized, or transformed before local training.</rdfs:comment>
</owl:Class>

<!--  ModelDeployment SubClass (optional) -->

<owl:Class rdf:about="#ModelDeployment">
    <rdfs:subClassOf rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">ModelDeployment</rdfs:label>
    <rdfs:comment xml:lang="en">An optional stage where the final aggregated model is deployed for production use or further tasks.</rdfs:comment>
</owl:Class>


<!-- SLModel class representing different types of models in Swarm Learning -->
<owl:Class rdf:about="#SLModel">
<rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">SLModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents different types of models used or produced in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- Subclass for HybridModel -->
<owl:Class rdf:about="#HybridModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">HybridModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models that combine multiple techniques, such as transfer learning or ensemble methods.</rdfs:comment>
</owl:Class>

<!-- Subclass for NeuralNetworkModel -->
<owl:Class rdf:about="#NeuralNetworkModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">NeuralNetworkModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models based on neural network architectures.</rdfs:comment>
</owl:Class>

<!-- Subclass for EnsembleModel -->
<owl:Class rdf:about="#EnsembleModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">EnsembleModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models created using ensemble learning techniques (e.g., bagging, boosting).</rdfs:comment>
</owl:Class>

<!-- Subclass for TransferLearningModel -->
<owl:Class rdf:about="#TransferLearningModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">TransferLearningModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models that apply transfer learning techniques, leveraging knowledge from one task to improve another.</rdfs:comment>
</owl:Class>

<!-- Subclass for BayesianModel -->
<owl:Class rdf:about="#BayesianModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">BayesianModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models based on Bayesian inference, useful for probabilistic reasoning.</rdfs:comment>
</owl:Class>

<!-- Subclass for SupportVectorModel -->
<owl:Class rdf:about="#SupportVectorModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">SupportVectorModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models based on support vector machines, often used for classification and regression.</rdfs:comment>
</owl:Class>

<!-- Subclass for DecisionTreeModel -->
<owl:Class rdf:about="#DecisionTreeModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">DecisionTreeModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models that use decision tree algorithms, common in ensemble methods.</rdfs:comment>
</owl:Class>

<!-- Subclass for ReinforcementLearningModel -->
<owl:Class rdf:about="#ReinforcementLearningModel">
    <rdfs:subClassOf rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">ReinforcementLearningModel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents models trained using reinforcement learning.</rdfs:comment>
</owl:Class>


<!--  SLNode Class -->

<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">SLNode</rdfs:label>
    <rdfs:comment xml:lang="en">Represents individual nodes that participate in the Swarm Learning process.</rdfs:comment>
</owl:Class>


<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#processesData"/>
            <owl:someValuesFrom rdf:resource="#ProcessedData"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>


<!-- TrainingNode subclass -->
<owl:Class rdf:about="#TrainingNode">
    <rdfs:subClassOf rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">TrainingNode</rdfs:label>
    <rdfs:comment xml:lang="en">A node responsible for training local models using its dataset.</rdfs:comment>
</owl:Class>

<!-- AggregatorNode subclass -->
<owl:Class rdf:about="#AggregatorNode">
    <rdfs:subClassOf rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">AggregatorNode</rdfs:label>
    <rdfs:comment xml:lang="en">A node responsible for aggregating models from multiple TrainingNodes.</rdfs:comment>
</owl:Class>

<!-- ValidationNode subclass (optional, if applicable) -->
<owl:Class rdf:about="#ValidationNode">
    <rdfs:subClassOf rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">ValidationNode</rdfs:label>
    <rdfs:comment xml:lang="en">A node focused on evaluating the aggregated model.</rdfs:comment>
</owl:Class>


<!--  class representing datasets in the Swarm Learning process -->
<owl:Class rdf:about="#Data">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <rdfs:comment xml:lang="en">Represents datasets used at various stages in the Swarm Learning process.</rdfs:comment>
</owl:Class>

<!-- RawData subclass -->
<owl:Class rdf:about="#RawData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">RawData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents raw, unprocessed data collected at each node in the system.</rdfs:comment>
</owl:Class>

<!-- ProcessedData subclass -->
<owl:Class rdf:about="#ProcessedData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">ProcessedData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents data that has undergone preprocessing before being used in training.</rdfs:comment>
</owl:Class>

<!-- TrainingData subclass -->
<owl:Class rdf:about="#TrainingData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">TrainingData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the dataset used for training models at each node.</rdfs:comment>
</owl:Class>

<!-- ValidationData subclass -->
<owl:Class rdf:about="#ValidationData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">ValidationData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the dataset used for validating models, either at the node level or the aggregation stage.</rdfs:comment>
</owl:Class>

<!-- AggregatedData subclass (optional) -->
<owl:Class rdf:about="#AggregatedData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">AggregatedData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents data resulting from the aggregation of multiple datasets, if relevant.</rdfs:comment>
</owl:Class>

<!-- TestingData subclass -->
<owl:Class rdf:about="#TestingData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">TestingData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the dataset used for testing models after training and validation.</rdfs:comment>
</owl:Class>

<!-- MetadataEnhancedData subclass -->
<owl:Class rdf:about="#MetadataEnhancedData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">MetadataEnhancedData</rdfs:label>
    <rdfs:comment xml:lang="en">Represents datasets enriched with metadata, such as annotations or additional features.</rdfs:comment>
</owl:Class>


<!-- CommunicationProtocol class representing protocols for communication between nodes in Swarm Learning -->
<!-- CommunicationProtocol as the main protocol class -->
<owl:Class rdf:about="#CommunicationProtocol">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">CommunicationProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the communication protocols used between nodes in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- MessagePassingProtocol remains as a subclass -->
<owl:Class rdf:about="#MessagePassingProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">MessagePassingProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents communication protocols based on message passing.</rdfs:comment>
</owl:Class>

<!-- FederatedLearningProtocol remains as a subclass -->
<owl:Class rdf:about="#FederatedLearningProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">FederatedLearningProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols specific to federated learning.</rdfs:comment>
</owl:Class>

<!-- PeerToPeerProtocol remains as a subclass -->
<owl:Class rdf:about="#PeerToPeerProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">PeerToPeerProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents communication protocols where nodes communicate directly in a decentralized manner.</rdfs:comment>
</owl:Class>

<!-- New ProvenanceProtocol class under CommunicationProtocol -->
<owl:Class rdf:about="#ProvenanceProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">ProvenanceProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols for ensuring data provenance and integrity.</rdfs:comment>
</owl:Class>

<!-- ProvenanceTrackingProtocol now as a subclass of ProvenanceProtocol -->
<owl:Class rdf:about="#ProvenanceTrackingProtocol">
    <rdfs:subClassOf rdf:resource="#ProvenanceProtocol"/>
    <rdfs:label xml:lang="en">ProvenanceTrackingProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols designed to track the provenance of data.</rdfs:comment>
</owl:Class>

<!-- BlockchainProtocol now as a subclass of ProvenanceProtocol -->
<owl:Class rdf:about="#BlockchainProtocol">
    <rdfs:subClassOf rdf:resource="#ProvenanceProtocol"/>
    <rdfs:label xml:lang="en">BlockchainProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents blockchain-based protocols for tracking provenance.</rdfs:comment>
</owl:Class>

<!-- SecureCommunicationProtocol remains a subclass of CommunicationProtocol -->
<owl:Class rdf:about="#SecureCommunicationProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">SecureCommunicationProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols that ensure secure communication between nodes.</rdfs:comment>
</owl:Class>

<!-- TLSProtocol remains a subclass of SecureCommunicationProtocol -->
<owl:Class rdf:about="#TLSProtocol">
    <rdfs:subClassOf rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:label xml:lang="en">TLSProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols relying on TLS for encryption and security.</rdfs:comment>
</owl:Class>

<!-- EndToEndEncryptionProtocol remains a subclass of SecureCommunicationProtocol -->
<owl:Class rdf:about="#EndToEndEncryptionProtocol">
    <rdfs:subClassOf rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:label xml:lang="en">EndToEndEncryptionProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents end-to-end encryption protocols for secure communication.</rdfs:comment>
</owl:Class>

<!-- PointToPointProtocol subclass of CommunicationProtocol -->
<owl:Class rdf:about="#PointToPointProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">PointToPointProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols for direct communication between specific pairs of nodes in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- BroadcastProtocol subclass of CommunicationProtocol -->
<owl:Class rdf:about="#BroadcastProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">BroadcastProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols that broadcast messages or updates to all nodes in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- SynchronizationProtocol subclass of CommunicationProtocol -->
<owl:Class rdf:about="#SynchronizationProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">SynchronizationProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Represents protocols that ensure data or model synchronization between nodes, particularly in asynchronous learning environments.</rdfs:comment>
</owl:Class>

<!-- EvaluationMetrics class representing the metrics used to evaluate models in the Swarm Learning process -->

<owl:Class rdf:about="#EvaluationMetrics">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">EvaluationMetrics</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the metrics used to evaluate the performance of models in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- AccuracyMetric subclass -->
<owl:Class rdf:about="#AccuracyMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">AccuracyMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents evaluation metrics based on the accuracy of the model.</rdfs:comment>
</owl:Class>

<!-- LatencyMetric subclass -->
<owl:Class rdf:about="#LatencyMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">LatencyMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents time-based performance metrics, such as latency in model training or inference.</rdfs:comment>
</owl:Class>

<!-- ResourceUsageMetric subclass -->
<owl:Class rdf:about="#ResourceUsageMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">ResourceUsageMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents metrics related to the usage of resources, such as CPU, memory, or network bandwidth.</rdfs:comment>
</owl:Class>

<!-- F1ScoreMetric subclass (optional) -->
<owl:Class rdf:about="#F1ScoreMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">F1ScoreMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the F1 score, combining precision and recall in classification tasks.</rdfs:comment>
</owl:Class>

<!-- PrecisionMetric subclass (optional) -->
<owl:Class rdf:about="#PrecisionMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">PrecisionMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the precision of a model, indicating how many predicted positives are correct.</rdfs:comment>
</owl:Class>

<!-- RecallMetric subclass (optional) -->
<owl:Class rdf:about="#RecallMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">RecallMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the recall of a model, indicating how many actual positives are correctly predicted.</rdfs:comment>
</owl:Class>

<!-- AUCMetric subclass -->
<owl:Class rdf:about="#AUCMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">AUCMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the area under the ROC curve (AUC), a performance metric for binary classification.</rdfs:comment>
</owl:Class>

<!-- ThroughputMetric subclass -->
<owl:Class rdf:about="#ThroughputMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">ThroughputMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the throughput of data processing or model inference, useful for high-performance or real-time systems.</rdfs:comment>
</owl:Class>

<!-- ErrorRateMetric subclass -->
<owl:Class rdf:about="#ErrorRateMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">ErrorRateMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the error rate of a model, often used to track the rate of incorrect predictions.</rdfs:comment>
</owl:Class>

<!-- DiversityMetric subclass for Ensemble or Hybrid models -->
<owl:Class rdf:about="#DiversityMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">DiversityMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the diversity among models in an ensemble or hybrid model, indicating how independently they contribute to the final outcome.</rdfs:comment>
</owl:Class>

<!-- ConvergenceMetric subclass for Neural Networks -->
<owl:Class rdf:about="#ConvergenceMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">ConvergenceMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the convergence metric for neural networks, measuring how fast the model stabilizes during training.</rdfs:comment>
</owl:Class>

<!-- RewardMetric subclass for Reinforcement Learning -->
<owl:Class rdf:about="#RewardMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">RewardMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the cumulative rewards obtained during the training of a reinforcement learning model.</rdfs:comment>
</owl:Class>

<!-- LearningEfficiencyMetric subclass for Reinforcement Learning -->
<owl:Class rdf:about="#LearningEfficiencyMetric">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">LearningEfficiencyMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the efficiency of learning in a reinforcement learning model, indicating how effectively the agent balances exploration and exploitation.</rdfs:comment>
</owl:Class>



<!-- SystemInfrastructure class representing physical and virtual resources supporting Swarm Learning -->
<owl:Class rdf:about="#SystemInfrastructure">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">SystemInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the physical and virtual resources supporting the Swarm Learning system, such as servers, cloud instances, and networks.</rdfs:comment>
</owl:Class>

<!-- PhysicalInfrastructure subclass -->
<owl:Class rdf:about="#PhysicalInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">PhysicalInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents physical resources, such as servers, networking hardware, and data centers, that support Swarm Learning.</rdfs:comment>
</owl:Class>

<!-- VirtualInfrastructure subclass -->
<owl:Class rdf:about="#VirtualInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">VirtualInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents virtualized resources, such as cloud instances or containers, that support Swarm Learning.</rdfs:comment>
</owl:Class>

<!-- NetworkInfrastructure subclass -->
<owl:Class rdf:about="#NetworkInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">NetworkInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents networking components like switches, routers, and links that enable communication between Swarm Learning nodes.</rdfs:comment>
</owl:Class>

<!-- StorageInfrastructure subclass -->
<owl:Class rdf:about="#StorageInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">StorageInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents storage systems for datasets, models, or logs in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- CloudInfrastructure subclass (optional) -->
<owl:Class rdf:about="#CloudInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">CloudInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents cloud-based resources, such as cloud computing services or storage, used in the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- EdgeInfrastructure subclass -->
<owl:Class rdf:about="#EdgeInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">EdgeInfrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents edge computing resources, such as IoT devices or local servers, that support Swarm Learning close to data sources.</rdfs:comment>
</owl:Class>



<!-- Property: latency -->

<!-- HumanParticipant class representing humans involved in the Swarm Learning system -->
<owl:Class rdf:about="#HumanParticipant">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">HumanParticipant</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans involved in various stages of the Swarm Learning system.</rdfs:comment>
</owl:Class>

<!-- HumanAnnotator subclass -->
<owl:Class rdf:about="#HumanAnnotator">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">HumanAnnotator</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans involved in annotating or labeling data in the Swarm Learning process.</rdfs:comment>
</owl:Class>

<!-- HumanMonitor subclass -->
<owl:Class rdf:about="#HumanMonitor">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">HumanMonitor</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans monitoring the system's operation and model performance.</rdfs:comment>
</owl:Class>

<!-- HumanOperator subclass (optional) -->
<owl:Class rdf:about="#HumanOperator">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">HumanOperator</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans managing or configuring system components, such as pipelines or infrastructure.</rdfs:comment>
</owl:Class>

<!-- HumanEvaluator subclass (optional) -->
<owl:Class rdf:about="#HumanEvaluator">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">HumanEvaluator</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans responsible for evaluating models or system performance based on their judgment.</rdfs:comment>
</owl:Class>

<!-- HumanDecisionMaker subclass -->
<owl:Class rdf:about="#HumanDecisionMaker">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">HumanDecisionMaker</rdfs:label>
    <rdfs:comment xml:lang="en">Represents humans responsible for making decisions based on model outputs or system processes in the Swarm Learning system.</rdfs:comment>
</owl:Class>

