    <rdfs:domain rdf:resource="#SupportVectorModel"/>
    <rdfs:range rdf:resource="#PrecisionMetric"/>
    <rdfs:label xml:lang="en">hasPrecisionMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a SupportVectorModel to its PrecisionMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking DecisionTreeModel to AccuracyMetric -->
<owl:ObjectProperty rdf:about="#hasAccuracyMetric">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="#AccuracyMetric"/>
    <rdfs:label xml:lang="en">hasAccuracyMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DecisionTreeModel to its AccuracyMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking DecisionTreeModel to PrecisionMetric -->
<owl:ObjectProperty rdf:about="#hasPrecisionMetric">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="#PrecisionMetric"/>
    <rdfs:label xml:lang="en">hasPrecisionMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DecisionTreeModel to its PrecisionMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking DecisionTreeModel to ResourceUsageMetric -->
<owl:ObjectProperty rdf:about="#hasResourceUsageMetric">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="#ResourceUsageMetric"/>
    <rdfs:label xml:lang="en">hasResourceUsageMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DecisionTreeModel to its ResourceUsageMetric, tracking resource usage (e.g., memory, CPU).</rdfs:comment>
</owl:ObjectProperty>

<!-- Describes the size of the dataset -->
<owl:DatatypeProperty rdf:about="#dataSize">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">dataSize</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the size of the dataset (e.g., number of instances).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Represents the timestamp when the data was collected -->
<owl:DatatypeProperty rdf:about="#collectionTime">
    <rdfs:domain rdf:resource="#RawData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">collectionTime</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the timestamp when the data was collected at the node.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the format of the dataset (e.g., CSV, JSON, XML) -->
<owl:DatatypeProperty rdf:about="#dataFormat">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">dataFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the format of the dataset (e.g., CSV, JSON, XML).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the source type of the dataset (e.g., sensor data, user logs, external API) -->
<owl:DatatypeProperty rdf:about="#sourceType">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">sourceType</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the source of the dataset (e.g., sensor data, user logs, external API).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the quality of the dataset (e.g., noise level, percentage of missing values) -->
<owl:DatatypeProperty rdf:about="#dataQuality">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">dataQuality</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the quality of the dataset (e.g., noise level, missing values).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAnonymization -->
<owl:DatatypeProperty rdf:about="#hasAnonymization">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">hasAnonymization</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies whether the data has been anonymized (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAugmentation -->
<owl:DatatypeProperty rdf:about="#hasAugmentation">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">hasAugmentation</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies whether the data has been augmented (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: isFederated -->
<owl:DatatypeProperty rdf:about="#isFederated">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">isFederated</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the data is used in a federated learning scenario (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: isStreaming -->
<owl:DatatypeProperty rdf:about="#isStreaming">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">isStreaming</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies whether the data is part of a continuous streaming process (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Represents the numeric result of an evaluation metric -->
<owl:DatatypeProperty rdf:about="#metricValue">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">metricValue</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the numeric result of an evaluation metric (e.g., accuracy, F1 score).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Represents the time at which the evaluation was conducted -->
<owl:DatatypeProperty rdf:about="#evaluationTime">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">evaluationTime</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the time at which the evaluation was conducted.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Defines the unit of the metric (e.g., ms for latency, percentage for accuracy) -->
<owl:DatatypeProperty rdf:about="#metricUnit">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">metricUnit</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the unit of the metric (e.g., ms for latency, percentage for accuracy).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Represents the threshold for the metric, if applicable (e.g., minimum accuracy requirement) -->
<owl:DatatypeProperty rdf:about="#threshold">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">threshold</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the threshold for the metric, if applicable (e.g., minimum accuracy requirement for model acceptance).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the type of communication protocol (e.g., synchronous, asynchronous) -->
<owl:DatatypeProperty rdf:about="#protocolType">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">protocolType</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the type of communication protocol (e.g., synchronous, asynchronous).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Captures the average latency of the communication protocol -->
<owl:DatatypeProperty rdf:about="#latency">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">Captures the average latency of the communication protocol, useful for performance assessment.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the bandwidth consumption of the communication protocol (optional) -->
<owl:DatatypeProperty rdf:about="#bandwidth">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">bandwidth</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the bandwidth consumption of the communication protocol, useful in large-scale distributed systems.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Defines the type of encryption used by a secure communication protocol -->
<owl:DatatypeProperty rdf:about="#encryptionType">
    <rdfs:domain rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">encryptionType</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the type of encryption used by a secure communication protocol (e.g., AES, RSA).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the reliability of a communication protocol (e.g., in terms of packet loss or retries) -->
<owl:DatatypeProperty rdf:about="#reliability">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">reliability</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the reliability of a communication protocol, such as packet loss or retries.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the type of infrastructure (e.g., physical, virtual, cloud) -->
<owl:DatatypeProperty rdf:about="#infrastructureType">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">infrastructureType</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the type of infrastructure, such as physical, virtual, or cloud.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Captures the capacity of the infrastructure (e.g., storage in GB, compute power in cores) -->
<owl:DatatypeProperty rdf:about="#capacity">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Captures the capacity of the infrastructure, such as storage in GB or compute power in cores.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the uptime or availability of the infrastructure -->
<owl:DatatypeProperty rdf:about="#uptime">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">uptime</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the uptime or availability of the infrastructure, usually represented as a percentage of time available.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the latency of communication between infrastructure components -->
<owl:DatatypeProperty rdf:about="#latency">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the latency of communication between infrastructure components, especially in distributed or edge systems.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Describes the role of the human in the system (e.g., annotator, monitor, evaluator) -->
<owl:DatatypeProperty rdf:about="#role">
    <rdfs:domain rdf:resource="#HumanParticipant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">role</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the role of the human in the system (e.g., annotator, monitor, evaluator).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Represents the expertise level of the HumanParticipant (e.g., novice, expert) -->
<owl:DatatypeProperty rdf:about="#expertiseLevel">
    <rdfs:domain rdf:resource="#HumanParticipant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">expertiseLevel</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the expertise level of the HumanParticipant, such as novice, expert, or domain-specific knowledge.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the availability of HumanParticipant (e.g., for annotation, monitoring, or decision-making tasks) -->
<owl:DatatypeProperty rdf:about="#availability">
    <rdfs:domain rdf:resource="#HumanParticipant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">availability</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks whether the HumanParticipant is available for tasks, such as annotation, monitoring, or decision-making.</rdfs:comment>
</owl:DatatypeProperty>

<!-- SystemInfrastructure and its subclasses Properties -->
<!-- Property: latency -->
<owl:DatatypeProperty rdf:about="#latency">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the communication latency for this infrastructure resource (in milliseconds).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: capacity -->
<owl:DatatypeProperty rdf:about="#capacity">
    <rdfs:domain rdf:resource="#StorageInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the storage capacity of the resource (in GB or TB).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: location -->
<owl:DatatypeProperty rdf:about="#location">
    <rdfs:domain rdf:resource="#PhysicalInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">location</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the physical location of the infrastructure (e.g., data center location).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: cpuUsage (percentage of CPU used) -->
<owl:DatatypeProperty rdf:about="#cpuUsage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">cpuUsage</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the percentage of CPU resources being used by this infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: memoryUsage (percentage of memory used) -->
<owl:DatatypeProperty rdf:about="#memoryUsage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">memoryUsage</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the percentage of memory resources being used by this infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: bandwidthCapacity (total available bandwidth in Mbps or Gbps) -->
<owl:DatatypeProperty rdf:about="#bandwidthCapacity">
    <rdfs:domain rdf:resource="#NetworkInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">bandwidthCapacity</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the total available bandwidth (in Mbps or Gbps) for network communication.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: networkLatency (latency in milliseconds for network connections) -->
<owl:DatatypeProperty rdf:about="#networkLatency">
    <rdfs:domain rdf:resource="#NetworkInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">networkLatency</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the latency (in milliseconds) for network connections within the infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: powerConsumption (measured in watts) -->
<owl:DatatypeProperty rdf:about="#powerConsumption">
    <rdfs:domain rdf:resource="#PhysicalInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">powerConsumption</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the amount of power consumed by the physical infrastructure (in watts).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: carbonFootprint (CO2 emissions in kilograms) -->
<owl:DatatypeProperty rdf:about="#carbonFootprint">
    <rdfs:domain rdf:resource="#PhysicalInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">carbonFootprint</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the carbon footprint (in kilograms of CO2) associated with the infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: failureRate (percentage or number of failures in infrastructure) -->
<owl:DatatypeProperty rdf:about="#failureRate">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">failureRate</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the rate of failures or outages experienced by this infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: lastFailureTime (timestamp of the last failure) -->
<owl:DatatypeProperty rdf:about="#lastFailureTime">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">lastFailureTime</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the timestamp of the most recent failure for this infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Existential Quantification for the specific cases  -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->

<!-- every SLNode must run on at least one SystemInfrastructure -->

<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#runsOn"/>
            <owl:someValuesFrom rdf:resource="#SystemInfrastructure"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

 <!-- Every TrainingData must be used by at least one SLModel for training -->
<owl:Class rdf:about="#TrainingData">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usedForTraining"/>
            <owl:someValuesFrom rdf:resource="#SLModel"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Every CommunicationProtocol must be used by at least one SLNode -->
 <owl:Class rdf:about="#CommunicationProtocol">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usedByNode"/>
            <owl:someValuesFrom rdf:resource="#SLNode"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!--  Every HumanParticipant must interact with at least one component of SwarmLearning -->

<owl:Class rdf:about="#HumanParticipant">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#interactsWith"/>
            <owl:someValuesFrom rdf:resource="#SwarmLearning"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 


<!-- Each SLModel must be trained on exactly one dataset 
<owl:Class rdf:about="#SLModel">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usedForTraining"/>
            <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            <owl:onClass rdf:resource="#Data"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> -->


<!-- Every SLModel should be evaluated using at least one EvaluationMetrics instance -->

<owl:Class rdf:about="#SLModel">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#evaluatesModel"/>
            <owl:someValuesFrom rdf:resource="#EvaluationMetrics"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<owl:Class rdf:about="#SLModel">
    <rdfs:subClassOf>
        <!-- Restriction: Each SLModel can have exactly one role -->
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasModelRole"/>
            <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

 <!--Every SLNode should collect or process at least one instance of RawData or ProcessedData -->

<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#collectedAt"/>
            <owl:someValuesFrom rdf:resource="#RawData"/>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#processesData"/>
            <owl:someValuesFrom rdf:resource="#ProcessedData"/>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#processesRawData"/>
            <owl:someValuesFrom rdf:resource="#RawData"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!--Every SLNode should processes At Least One Model (Minimum Cardinality): -->

<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf>
        <!-- Restriction: Each SLNode must process at least one SLModel -->
        <owl:Restriction>
            <owl:onProperty rdf:resource="#processesModel"/>
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="#SLModel"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Each SLPipeline should involve at least one SLNode -->

<owl:Class rdf:about="#SLPipeline"> 
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasNode"/>
            <owl:someValuesFrom rdf:resource="#SLNode"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Each SLPipeline can have multiple feedback loops -->
<owl:Class rdf:about="#SLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasFeedbackLoop"/>
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="#FeedbackLoop"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Restriction: Each Data instance must have exactly one provenance tracking protocol 
<owl:Class rdf:about="#Data">
    <rdfs:subClassOf rdf:resource="#SwarmLearning"/>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#ensuresDataProvenance"/>
            <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            <owl:onClass rdf:resource="#ProvenanceProtocol"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>-->


<!-- Every FeedbackLoop should be based on at least one EvaluationMetrics -->

<owl:Class rdf:about="#FeedbackLoop">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#feedbackOf"/>
            <owl:someValuesFrom rdf:resource="#EvaluationMetrics"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Every HumanEvaluator must evaluate at least one SLModel -->

<owl:Class rdf:about="#HumanEvaluator">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#evaluatesModel"/>
            <owl:someValuesFrom rdf:resource="#SLModel"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

 <!--Every SecureCommunicationProtocol must be an instance of CommunicationProtocol -->
<owl:Class rdf:about="#SecureCommunicationProtocol">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usedInAggregation"/>
            <owl:someValuesFrom rdf:resource="#CommunicationProtocol"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!--If you have hybrid models in your ontology (such as TransferLearningHybrid or EnsembleHybrid), you can apply existential quantification to ensure that each SLModel has some hybrid form or structure 

<owl:Class rdf:about="#SLModel">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasHybridStructure"/>
            <owl:someValuesFrom rdf:resource="#HybridModel"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> -->

<!-- Each SLNode must use exactly one CommunicationProtocol -->
<owl:Class rdf:about="#SLNode">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#communicatesWith"/>
            <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            <owl:onClass rdf:resource="#CommunicationProtocol"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- If transfer learning is a concept in the ontology, you could express that SLModels must be linked to at least one TransferLearningHybrid instance to indicate hybridization for transfer learning

<owl:Class rdf:about="#SLModel">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasTransferLearningComponent"/>
            <owl:someValuesFrom rdf:resource="#TransferLearningHybrid"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> -->

