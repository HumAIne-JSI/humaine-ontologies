<!-- Data Properties for SwarmLearning -->
<owl:DatatypeProperty rdf:about="#SystemStatus">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">SystemStatus</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the current state of the Swarm Learning system (active, inactive, etc.).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#SystemVersion">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">SystemVersion</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the version of the Swarm Learning system.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#StartDate">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">StartDate</rdfs:label>
    <rdfs:comment xml:lang="en">Records the date the Swarm Learning system started its operation.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EndDate">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">EndDate</rdfs:label>
    <rdfs:comment xml:lang="en">Records when the Swarm Learning process ended or is scheduled to end.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Properties for SLPipeline stages (if applicable) -->

<!-- Tracks the time when a specific stage in the Swarm Learning pipeline starts -->
<owl:DatatypeProperty rdf:about="#startTime">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">startTime</rdfs:label>
    <rdfs:comment xml:lang="en">The time when a specific stage in the Swarm Learning pipeline starts.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Tracks the time when a specific stage in the Swarm Learning pipeline ends -->
<owl:DatatypeProperty rdf:about="#endTime">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">endTime</rdfs:label>
    <rdfs:comment xml:lang="en">The time when a specific stage in the Swarm Learning pipeline ends.</rdfs:comment>
</owl:DatatypeProperty>

<!-- General Properties for SLModel -->

<!--  modelAccuracy tracks the accuracy of the model represented as a floating-point value between 0 and 1 -->
<owl:DatatypeProperty rdf:about="#modelAccuracy">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">modelAccuracy</rdfs:label>
    <rdfs:comment xml:lang="en">Tracks the accuracy of the model, typically represented as a floating-point value between 0 and 1.</rdfs:comment>
</owl:DatatypeProperty>

<!-- modelTrainingTime Indicates the amount of time spent training the model.-->
<owl:DatatypeProperty rdf:about="#modelTrainingTime">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    <rdfs:label xml:lang="en">modelTrainingTime</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the time spent training the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- hasPretrainedState applied to any of the model types to indicate whether a model has been pretrained. -->

<owl:DatatypeProperty rdf:about="#hasPretrainedState">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">hasPretrainedState</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the model is pretrained (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- assign roles (like LocalModel or AggregatedModel) to each model instance -->

<owl:DatatypeProperty rdf:about="#hasModelRole">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasModelRole</rdfs:label>
    <rdfs:comment xml:lang="en">Assigns a role to the model in the Swarm Learning pipeline. Possible values:"LocalModel", "AggregatedModel", "PretrainedModel", "ValidationModel", "TestModel".</rdfs:comment>
</owl:DatatypeProperty>

<!-- Indicates if a model is trained using federated learning. -->

<owl:DatatypeProperty rdf:about="#hasFederatedTraining">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">hasFederatedTraining</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether the model was trained using federated learning (true/false).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Properties for HybridModel -->
<!--  usesTechniques specifies the techniques used in a HybridModel, such as transfer learning or ensemble learning. -->
<owl:DatatypeProperty rdf:about="#usesTechniques">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">usesTechniques</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the techniques used in a HybridModel, such as transfer learning or ensemble learning.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Properties for TransferLearningModel -->
<!--pretrainedTask for TransferLearningModel Specifies the task for which the TransferLearningModel was pretrained before being used in the Swarm Learning pipeline.-->
<owl:DatatypeProperty rdf:about="#pretrainedTask">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">pretrainedTask</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the task for which the model was pretrained, prior to being used in Swarm Learning.</rdfs:comment>
</owl:DatatypeProperty>

<!--Properties for NeuralNetworkModel -->
<!-- numberOfLayers Indicates the number of layers in a NeuralNetworkModel -->
<owl:DatatypeProperty rdf:about="#numberOfLayers">
    <rdfs:domain rdf:resource="#NeuralNetworkModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">numberOfLayers</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the number of layers in a neural network model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Hyperparameters as Properties of SLModel -->

<!-- Property: hasLearningRate -->
<owl:DatatypeProperty rdf:about="#hasLearningRate">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasLearningRate</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the learning rate for the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasBatchSize -->
<owl:DatatypeProperty rdf:about="#hasBatchSize">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasBatchSize</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the batch size for the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasNumberOfEpochs -->
<owl:DatatypeProperty rdf:about="#hasNumberOfEpochs">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasNumberOfEpochs</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of epochs used for training the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasDropoutRate -->
<owl:DatatypeProperty rdf:about="#hasDropoutRate">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasDropoutRate</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the dropout rate for the model, typically used to prevent overfitting in neural networks.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasL2Regularization -->
<owl:DatatypeProperty rdf:about="#hasL2Regularization">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasL2Regularization</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the L2 regularization parameter, used to prevent overfitting.</rdfs:comment>
</owl:DatatypeProperty>

