</owl:NamedIndividual> -->

<!--Additional Property for NeuralNetworkModel
 Property: hasMomentum -->
<!-- Property: hasMomentum (for NeuralNetworkModel) -->
<owl:DatatypeProperty rdf:about="#hasMomentum">
    <rdfs:domain rdf:resource="#NeuralNetworkModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasMomentum</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the momentum parameter used in optimization techniques like stochastic gradient descent.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: numberOfLayers (for NeuralNetworkModel) -->
<owl:DatatypeProperty rdf:about="#numberOfLayers">
    <rdfs:domain rdf:resource="#NeuralNetworkModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">numberOfLayers</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the number of layers in a neural network model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Additional Property for HybridModel:
 Property: hasWeightingCoefficient -->
<owl:DatatypeProperty rdf:about="#hasWeightingCoefficient">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasWeightingCoefficient</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the weighting coefficient used to balance multiple models in a HybridModel.</rdfs:comment>
</owl:DatatypeProperty>

<!--Additional Properties for EnsembleModel-->

<!-- Property: hasNumberOfBaseModels (for EnsembleModel) -->
<owl:DatatypeProperty rdf:about="#hasNumberOfBaseModels">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasNumberOfBaseModels</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of base models in an ensemble.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAggregationMethod (for EnsembleModel) -->
<owl:DatatypeProperty rdf:about="#hasAggregationMethod">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasAggregationMethod</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the aggregation method used in the ensemble model (e.g., voting, averaging).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Additional Properties for TransferLearningModel -->

<!-- Property: hasPretrainedModelPath (for TransferLearningModel) -->
<owl:DatatypeProperty rdf:about="#hasPretrainedModelPath">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasPretrainedModelPath</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the file path or location of the pretrained model used in transfer learning.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasFineTuningLayers (for TransferLearningModel) -->
<owl:DatatypeProperty rdf:about="#hasFineTuningLayers">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasFineTuningLayers</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies which layers of the model are fine-tuned during the transfer learning process.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Additional Properties for DecisionTreeModel -->

<!-- Property: hasMaxDepth (for DecisionTreeModel) -->
<owl:DatatypeProperty rdf:about="#hasMaxDepth">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasMaxDepth</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the maximum depth of a decision tree.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasMinSamplesPerSplit (for DecisionTreeModel) -->
<owl:DatatypeProperty rdf:about="#hasMinSamplesPerSplit">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasMinSamplesPerSplit</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the minimum number of samples required to split an internal node in a decision tree.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasCriterion (for DecisionTreeModel) -->
<owl:DatatypeProperty rdf:about="#hasCriterion">
    <rdfs:domain rdf:resource="#DecisionTreeModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasCriterion</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the function to measure the quality of a split in a decision tree (e.g., Gini impurity, information gain).</rdfs:comment>
</owl:DatatypeProperty>


<!-- Additional Properties for ReinforcementLearningModel: -->

<!-- Property: hasDiscountFactor (for ReinforcementLearningModel) -->
<owl:DatatypeProperty rdf:about="#hasDiscountFactor">
    <rdfs:domain rdf:resource="#ReinforcementLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasDiscountFactor</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the discount factor in reinforcement learning, determining how future rewards are weighed.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasExplorationRate (for ReinforcementLearningModel) -->
<owl:DatatypeProperty rdf:about="#hasExplorationRate">
    <rdfs:domain rdf:resource="#ReinforcementLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">hasExplorationRate</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the exploration rate in reinforcement learning, controlling the balance between exploration and exploitation.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasNumberOfEpisodes (for ReinforcementLearningModel) -->
<owl:DatatypeProperty rdf:about="#hasNumberOfEpisodes">
    <rdfs:domain rdf:resource="#ReinforcementLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">hasNumberOfEpisodes</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of episodes in which the agent learns in a reinforcement learning model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Additional Property for BayesianModel -->

<!-- Property: hasPriorDistribution (for BayesianModel) -->
<owl:DatatypeProperty rdf:about="#hasPriorDistribution">
    <rdfs:domain rdf:resource="#BayesianModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasPriorDistribution</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the prior distribution for Bayesian models (e.g., Gaussian, uniform).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Additional Property for SupportVectorModel-->

