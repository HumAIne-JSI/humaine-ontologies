<!-- # -->
<!-- ################################################################# -->
<!--  -->

<!-- Disjoint Classes for Top-Level Classes -->

<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#SLModel"/>
        <rdf:Description rdf:about="#HumanParticipant"/>
<!-- <rdf:Description rdf:about="#CommunicationProtocol"/> -->
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjoint Classes for Data Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#RawData"/>
        <rdf:Description rdf:about="#ProcessedData"/>
        <rdf:Description rdf:about="#TrainingData"/>
        <rdf:Description rdf:about="#ValidationData"/>
        <rdf:Description rdf:about="#TestingData"/>
        <rdf:Description rdf:about="#MetadataEnhancedData"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjoint Classes for HumanParticipant Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#HumanAnnotator"/>
        <rdf:Description rdf:about="#HumanMonitor"/>
        <rdf:Description rdf:about="#HumanOperator"/>
        <rdf:Description rdf:about="#HumanEvaluator"/>
        <rdf:Description rdf:about="#HumanDecisionMaker"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjoint Classes for SystemInfrastructure Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#PhysicalInfrastructure"/>
        <rdf:Description rdf:about="#VirtualInfrastructure"/>
        <rdf:Description rdf:about="#NetworkInfrastructure"/>
        <rdf:Description rdf:about="#StorageInfrastructure"/>
        <rdf:Description rdf:about="#CloudInfrastructure"/>
        <rdf:Description rdf:about="#EdgeInfrastructure"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjoint Classes for CommunicationProtocol Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#MessagePassingProtocol"/>
        <rdf:Description rdf:about="#FederatedLearningProtocol"/>
        <rdf:Description rdf:about="#BroadcastProtocol"/>
        <rdf:Description rdf:about="#PointToPointProtocol"/>
        <rdf:Description rdf:about="#PeerToPeerProtocol"/>
        <rdf:Description rdf:about="#SecureCommunicationProtocol"/>
    </owl:members>
</owl:AllDisjointClasses>

<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Object Properties -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->

<!-- Object Properties for SwarmLearning -->
<owl:ObjectProperty rdf:about="#hasPipeline">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">hasPipeline</rdfs:label>
    <rdfs:comment xml:lang="en">Links SwarmLearning to the SLPipeline that defines the learning workflow.</rdfs:comment>
</owl:ObjectProperty>

<!-- hasPipeline Inverse Property -->

<owl:ObjectProperty rdf:about="#pipelineOf">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="#SwarmLearning"/>
    <owl:inverseOf rdf:resource="#hasPipeline"/>
    <rdfs:label xml:lang="en">pipelineOf</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLPipeline to the SwarmLearning system it is part of.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#includesModel">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">includesModel</rdfs:label>
    <rdfs:comment xml:lang="en">Links SwarmLearning to models being used or aggregated in the process.</rdfs:comment>
</owl:ObjectProperty>

<!-- includesModel Inverse Property -->
<owl:ObjectProperty rdf:about="#modelOf">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="#SwarmLearning"/>
    <owl:inverseOf rdf:resource="#includesModel"/>
    <rdfs:label xml:lang="en">modelOf</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the SwarmLearning system that includes it.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasNode">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">hasNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links SwarmLearning to its participating SLNodes.</rdfs:comment>
</owl:ObjectProperty>

<!-- hasNode Inverse Property -->
<owl:ObjectProperty rdf:about="#nodeOf">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SwarmLearning"/>
    <owl:inverseOf rdf:resource="#hasNode"/>
    <rdfs:label xml:lang="en">nodeOf</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNode to the SwarmLearning system or SLPipeline it belongs to.</rdfs:comment>
</owl:ObjectProperty>

<!-- usesData Property -->

<owl:ObjectProperty rdf:about="#usesData">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">usesData</rdfs:label>
    <rdfs:comment xml:lang="en">Links SwarmLearning to the datasets used across its nodes.</rdfs:comment>
</owl:ObjectProperty>

<!-- usesData Inverse Property -->

<owl:ObjectProperty rdf:about="#dataUsedBy">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="#SwarmLearning"/>
    <owl:inverseOf rdf:resource="#usesData"/>
    <rdfs:label xml:lang="en">dataUsedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Links Data to the SwarmLearning system or stages that use it.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#monitoredBy">
    <rdfs:domain rdf:resource="#SwarmLearning"/>
    <rdfs:range rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">monitoredBy</rdfs:label>
    <rdfs:comment xml:lang="en">Links SwarmLearning to human participants monitoring or interacting with the system.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Properties for SLPipeline and its Subclasses -->

<!-- Links the Swarm Learning pipeline to its various stages (e.g., DataCollection, LocalTraining, etc.) -->
<owl:ObjectProperty rdf:about="#hasStage">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">hasStage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the Swarm Learning pipeline to its various stages (DataCollection, LocalTraining, etc.).</rdfs:comment>
</owl:ObjectProperty>

<!-- Links stages like DataCollection or LocalTraining to the datasets used during data collection or training -->
<owl:ObjectProperty rdf:about="#usesData">
    <rdfs:domain rdf:resource="#DataCollection"/>
    <rdfs:domain rdf:resource="#LocalTraining"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">usesData</rdfs:label>
    <rdfs:comment xml:lang="en">Links stages of the Swarm Learning pipeline to the datasets used during data collection or training.</rdfs:comment>
</owl:ObjectProperty>

<!-- Definition of hasFeedbackLoop as an Object Property -->
<owl:ObjectProperty rdf:about="#hasFeedbackLoop">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="#FeedbackLoop"/>
    <rdfs:label xml:lang="en">hasFeedbackLoop</rdfs:label>
    <rdfs:comment xml:lang="en">Links the SLPipeline to its associated FeedbackLoop instances.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links the  LocalTraining or TrainingNode to the models being trained -->

<owl:ObjectProperty rdf:about="#trainsModel">
    <rdfs:domain>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#LocalTraining"/>
                <rdf:Description rdf:about="#TrainingNode"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">trainsModel</rdfs:label>
    <rdfs:comment xml:lang="en">Links LocalTraining or TrainingNode to the models being trained.</rdfs:comment>
</owl:ObjectProperty>

<!-- trainsModel Inverse Property -->
<owl:ObjectProperty rdf:about="#trainedBy">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#LocalTraining"/>
                <rdf:Description rdf:about="#TrainingNode"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:range>
    <owl:inverseOf rdf:resource="#trainsModel"/>
    <rdfs:label xml:lang="en">trainedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the LocalTraining stage or TrainingNode that trained it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links the ModelAggregation stage and AggregatorNode to the models being aggregated into a global model -->
<owl:ObjectProperty rdf:about="#aggregatesModel">
    <rdfs:domain>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ModelAggregation"/>
                <rdf:Description rdf:about="#AggregatorNode"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">aggregatesModel</rdfs:label>
    <rdfs:comment xml:lang="en">Links ModelAggregation or AggregatorNode to the models being aggregated.</rdfs:comment>
</owl:ObjectProperty>

<!-- aggregatesModel Inverse Property -->
<owl:ObjectProperty rdf:about="#aggregatedBy">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ModelAggregation"/>
                <rdf:Description rdf:about="#AggregatorNode"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:range>
    <owl:inverseOf rdf:resource="#aggregatesModel"/>
    <rdfs:label xml:lang="en">aggregatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the ModelAggregation stage or AggregatorNode that aggregated it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links Evaluation, ValidationNode, HumanEvaluator, and EvaluationMetrics to the SLModel they evaluate.-->

<owl:ObjectProperty rdf:about="#evaluatesModel">
    <rdfs:domain>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#Evaluation"/>
                <rdf:Description rdf:about="#ValidationNode"/>
                <rdf:Description rdf:about="#HumanEvaluator"/>
                <rdf:Description rdf:about="#EvaluationMetrics"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">evaluatesModel</rdfs:label>
    <rdfs:comment xml:lang="en">Links Evaluation, ValidationNode, HumanEvaluator, and EvaluationMetrics to the SLModel they evaluate.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links the FeedbackLoop stage to the models or stages that receive feedback for improvement -->
<owl:ObjectProperty rdf:about="#feedbackTo">
    <rdfs:domain rdf:resource="#FeedbackLoop"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">feedbackTo</rdfs:label>
    <rdfs:comment xml:lang="en">Links the FeedbackLoop stage to the models or stages that receive feedback for improvement.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links each pipeline stage to the nodes performing the operation (e.g., data collection, training) -->
<owl:ObjectProperty rdf:about="#hasNode">
    <rdfs:domain rdf:resource="#SLPipeline"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">hasNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links each pipeline stage to the nodes performing the operation (e.g., data collection, training).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#collectedAt">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#RawData"/>
    <rdfs:label xml:lang="en">collectedAt</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNode to the RawData it collects.</rdfs:comment>
</owl:ObjectProperty> 

<!-- Links TrainingData to SLModel, indicating which models are trained on this data -->
<owl:ObjectProperty rdf:about="#usedForTraining">
    <rdfs:domain rdf:resource="#TrainingData"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">usedForTraining</rdfs:label>
    <rdfs:comment xml:lang="en">Links TrainingData to the SLModel that uses it for training.</rdfs:comment>
</owl:ObjectProperty>

<!-- Inverse for usedForTraining-->
<owl:ObjectProperty rdf:about="#trainedOn">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="#TrainingData"/>
    <owl:inverseOf rdf:resource="#usedForTraining"/>
    <rdfs:label xml:lang="en">trainedOn</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the TrainingData it was trained on.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links ValidationData to SLModel, indicating which models are validated on this data -->
<owl:ObjectProperty rdf:about="#usedForValidation">
    <rdfs:domain rdf:resource="#ValidationData"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">usedForValidation</rdfs:label>
    <rdfs:comment xml:lang="en">Links ValidationData to the SLModel that uses it for validation.</rdfs:comment>
</owl:ObjectProperty>

<!-- Inverse of usedForValidation -->

<owl:ObjectProperty rdf:about="#validatedOn">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="#ValidationData"/>
    <owl:inverseOf rdf:resource="#usedForValidation"/>
    <rdfs:label xml:lang="en">validatedOn</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the ValidationData it was validated on.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links ProcessedData to the RawData from which it was generated -->
<owl:ObjectProperty rdf:about="#processedFrom">
    <rdfs:domain rdf:resource="#ProcessedData"/>
    <rdfs:range rdf:resource="#RawData"/>
    <rdfs:label xml:lang="en">processedFrom</rdfs:label>
    <rdfs:comment xml:lang="en">Links ProcessedData to the RawData it was generated from.</rdfs:comment>
</owl:ObjectProperty>

 <!-- Inverse for processedFrom -->

<owl:ObjectProperty rdf:about="#producedProcessedData">
    <rdfs:domain rdf:resource="#RawData"/>
    <rdfs:range rdf:resource="#ProcessedData"/>
    <owl:inverseOf rdf:resource="#processedFrom"/>
    <rdfs:label xml:lang="en">producedProcessedData</rdfs:label>
    <rdfs:comment xml:lang="en">Links RawData to the ProcessedData it produced.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: processesData link SLNode with ProcessedData, indicating that an SLNode processes some data.-->
<owl:ObjectProperty rdf:about="#processesData">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#ProcessedData"/>
    <rdfs:label xml:lang="en">processesData</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNode to the ProcessedData it processes.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#processesRawData">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#RawData"/>
    <rdfs:label xml:lang="en">processesRawData</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNode to the RawData it processes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links TestingData to SLModel, indicating which models are tested on this data -->
<owl:ObjectProperty rdf:about="#usedForTesting">
    <rdfs:domain rdf:resource="#TestingData"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">usedForTesting</rdfs:label>
    <rdfs:comment xml:lang="en">Links TestingData to the SLModel that uses it for testing.</rdfs:comment>
</owl:ObjectProperty>

<!-- Inverse of usedForTesting -->

<owl:ObjectProperty rdf:about="#testedOn">
    <rdfs:domain rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="#TestingData"/>
    <owl:inverseOf rdf:resource="#usedForTesting"/>
    <rdfs:label xml:lang="en">testedOn</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLModel to the TestingData it was tested on.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links MetadataEnhancedData to the base Data it enhances with additional features or metadata -->
<owl:ObjectProperty rdf:about="#metadataOf">
    <rdfs:domain rdf:resource="#MetadataEnhancedData"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">metadataOf</rdfs:label>
    <rdfs:comment xml:lang="en">Links MetadataEnhancedData to the base Data it enhances.</rdfs:comment>
</owl:ObjectProperty>

<!--  Inverse for metadataOf -->

<owl:ObjectProperty rdf:about="#enhancesData">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="#MetadataEnhancedData"/>
    <owl:inverseOf rdf:resource="#metadataOf"/>
    <rdfs:label xml:lang="en">enhancesData</rdfs:label>
    <rdfs:comment xml:lang="en">Links Data to the MetadataEnhancedData that enhances it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links Data to labels associated with it (for labeled data in supervised learning) -->
<owl:ObjectProperty rdf:about="#hasLabel">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasLabel</rdfs:label>
    <rdfs:comment xml:lang="en">Links Data to labels associated with it (for labeled data used in supervised learning).</rdfs:comment>
</owl:ObjectProperty>


<!-- Links EvaluationMetrics to the SLPipeline stage where the metric is measured -->
<owl:ObjectProperty rdf:about="#measuredIn">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">measuredIn</rdfs:label>
    <rdfs:comment xml:lang="en">Links EvaluationMetrics to the SLPipeline stage where the metric is measured.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links EvaluationMetrics to FeedbackLoop, showing how evaluation feeds into system improvement -->
<owl:ObjectProperty rdf:about="#feedbackOf">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#FeedbackLoop"/>
    <rdfs:label xml:lang="en">feedbackOf</rdfs:label>
    <rdfs:comment xml:lang="en">Links EvaluationMetrics to the FeedbackLoop, indicating how evaluation informs improvements.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links EvaluationMetrics to the SLNode where the metric was calculated -->
<owl:ObjectProperty rdf:about="#calculatedForNode">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">calculatedForNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links EvaluationMetrics to the SLNode where the metric was calculated, allowing for node-specific performance tracking.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links CommunicationProtocol to the SLNode that uses the protocol -->
<owl:ObjectProperty rdf:about="#usedByNode">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">usedByNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links CommunicationProtocol to the SLNode that uses the protocol for communication.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links CommunicationProtocol to ModelAggregation to specify how aggregation is conducted -->
<owl:ObjectProperty rdf:about="#usedInAggregation">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#ModelAggregation"/>
    <rdfs:label xml:lang="en">usedInAggregation</rdfs:label>
    <rdfs:comment xml:lang="en">Links CommunicationProtocol to the ModelAggregation process, specifying how nodes exchange models during aggregation.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links one SLNode to another node with which it communicates, via a protocol -->
<owl:ObjectProperty rdf:about="#communicatesWith">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">communicatesWith</rdfs:label>
    <rdfs:comment xml:lang="en">Links one SLNode to another node with which it communicates via a communication protocol.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links one SLNode to SLModel it processes-->

<owl:ObjectProperty rdf:about="#processesModel">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:label xml:lang="en">processesModel</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNode to the SLModel it processes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links an SLNode to the SystemInfrastructure it operates on -->
<owl:ObjectProperty rdf:about="#runsOn">
    <rdfs:domain rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">runsOn</rdfs:label>
    <rdfs:comment xml:lang="en">Links an SLNode to the SystemInfrastructure it runs on (e.g., a physical server, cloud instance, or container).</rdfs:comment>
</owl:ObjectProperty>

<!-- Inverse for runsOn -->
<owl:ObjectProperty rdf:about="#hostsNode">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <owl:inverseOf rdf:resource="#runsOn"/>
    <rdfs:label xml:lang="en">hostsNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links SystemInfrastructure to the SLNodes that run on it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links SystemInfrastructure to the Data it hosts or stores -->
<owl:ObjectProperty rdf:about="#hostsData">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">hostsData</rdfs:label>
    <rdfs:comment xml:lang="en">Links SystemInfrastructure to the Data it hosts or stores, such as datasets or models.</rdfs:comment>
</owl:ObjectProperty>

<!-- Inverse for hostsData -->

<owl:ObjectProperty rdf:about="#storedIn">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <owl:inverseOf rdf:resource="#hostsData"/>
    <rdfs:label xml:lang="en">storedIn</rdfs:label>
    <rdfs:comment xml:lang="en">Links Data to the SystemInfrastructure it is stored in.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links NetworkInfrastructure to the SLNode or SLPipeline stages it supports -->
<owl:ObjectProperty rdf:about="#providesNetworkFor">
    <rdfs:domain rdf:resource="#NetworkInfrastructure"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">providesNetworkFor</rdfs:label>
    <rdfs:comment xml:lang="en">Links NetworkInfrastructure to the SLNodes or SLPipeline stages it supports for communication.</rdfs:comment>
</owl:ObjectProperty>

<!--  Inverse for providesNetworkFor -->

<owl:ObjectProperty rdf:about="#networkedBy">
    <rdfs:domain>
        <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#SLNode"/>
                <rdf:Description rdf:about="#SLPipeline"/>
            </owl:unionOf>
        </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="#NetworkInfrastructure"/>
    <owl:inverseOf rdf:resource="#providesNetworkFor"/>
    <rdfs:label xml:lang="en">networkedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Links SLNodes or SLPipeline stages to the NetworkInfrastructure that supports them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links SystemInfrastructure resources to the SLNode or process they are dynamically allocated to -->
<owl:ObjectProperty rdf:about="#allocatedTo">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">allocatedTo</rdfs:label>
    <rdfs:comment xml:lang="en">Links SystemInfrastructure resources to the SLNode or process they are dynamically allocated to.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links HumanParticipant to system components they interact with -->
<owl:ObjectProperty rdf:about="#interactsWith">
    <rdfs:domain rdf:resource="#HumanParticipant"/>
    <rdfs:range rdf:resource="#SwarmLearning"/>
    <rdfs:label xml:lang="en">interactsWith</rdfs:label>
    <rdfs:comment xml:lang="en">Links HumanParticipant to system components they interact with, such as SLNodes, Data, or SLModels.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links HumanAnnotator to the Data they annotate or label -->
<owl:ObjectProperty rdf:about="#annotatesData">
    <rdfs:domain rdf:resource="#HumanAnnotator"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">annotatesData</rdfs:label>
    <rdfs:comment xml:lang="en">Links HumanAnnotator to the Data they annotate or label in the system.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links HumanMonitor to the system components they monitor (e.g., infrastructure or pipeline) -->
<owl:ObjectProperty rdf:about="#monitorsSystem">
    <rdfs:domain rdf:resource="#HumanMonitor"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">monitorsSystem</rdfs:label>
    <rdfs:comment xml:lang="en">Links HumanMonitor to the SystemInfrastructure or SLPipeline components they monitor.</rdfs:comment>
</owl:ObjectProperty>


<!-- Links HumanDecisionMaker to models or system processes they make decisions for -->
<owl:ObjectProperty rdf:about="#makesDecisionFor">
    <rdfs:domain rdf:resource="#HumanDecisionMaker"/>
    <rdfs:range rdf:resource="#SLModel"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">makesDecisionFor</rdfs:label>
    <rdfs:comment xml:lang="en">Links HumanDecisionMaker to the SLModel or SLPipeline they are making decisions for.</rdfs:comment>
</owl:ObjectProperty>

<!-- Links SLMOdel subclasses to their evaluation metrics -->

<!-- Object Property linking HybridModel to DiversityMetric -->
<owl:ObjectProperty rdf:about="#hasDiversityMetric">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="#DiversityMetric"/>
    <rdfs:label xml:lang="en">hasDiversityMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a HybridModel to its DiversityMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property linking EnsembleModel to DiversityMetric -->
<owl:ObjectProperty rdf:about="#hasDiversityMetric">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="#DiversityMetric"/>
    <rdfs:label xml:lang="en">hasDiversityMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links an EnsembleModel to its DiversityMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property linking NeuralNetworkModel to ConvergenceMetric -->
<owl:ObjectProperty rdf:about="#hasConvergenceMetric">
    <rdfs:domain rdf:resource="#NeuralNetworkModel"/>
    <rdfs:range rdf:resource="#ConvergenceMetric"/>
    <rdfs:label xml:lang="en">hasConvergenceMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a NeuralNetworkModel to its ConvergenceMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property linking ReinforcementLearningModel to RewardMetric -->
<owl:ObjectProperty rdf:about="#hasRewardMetric">
    <rdfs:domain rdf:resource="#ReinforcementLearningModel"/>
    <rdfs:range rdf:resource="#RewardMetric"/>
    <rdfs:label xml:lang="en">hasRewardMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ReinforcementLearningModel to its RewardMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property linking ReinforcementLearningModel to LearningEfficiencyMetric -->
<owl:ObjectProperty rdf:about="#hasLearningEfficiencyMetric">
    <rdfs:domain rdf:resource="#ReinforcementLearningModel"/>
    <rdfs:range rdf:resource="#LearningEfficiencyMetric"/>
    <rdfs:label xml:lang="en">hasLearningEfficiencyMetric</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ReinforcementLearningModel to its LearningEfficiencyMetric.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking CommunicationProtocol to SLNode -->
<owl:ObjectProperty rdf:about="#usedByNode">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">usedByNode</rdfs:label>
    <rdfs:comment xml:lang="en">Links CommunicationProtocol to the SLNode that uses it for communication.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking CommunicationProtocol to ModelAggregation -->
<owl:ObjectProperty rdf:about="#usedInAggregation">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resensuresDataProvenanceource="#ModelAggregation"/>
    <rdfs:label xml:lang="en">usedInAggregation</rdfs:label>
    <rdfs:comment xml:lang="en">Links CommunicationProtocol to the ModelAggregation process, specifying how nodes exchange models during aggregation.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking ProvenanceProtocol (which includes ProvenanceTrackingProtocol and BlockchainProtocol) to Data -->
<!-- Property linking ProvenanceProtocol to Data -->
<owl:ObjectProperty rdf:about="#ensuresDataProvenance">
    <rdfs:domain rdf:resource="#ProvenanceProtocol"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">ensuresDataProvenance</rdfs:label>
    <rdfs:comment xml:lang="en">Links ProvenanceProtocol to the Data it tracks for provenance.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking SecureCommunicationProtocol, TLSProtocol, and EndToEndEncryptionProtocol to SLNode or SLPipeline -->
<owl:ObjectProperty rdf:about="#providesSecureCommunication">
    <rdfs:domain rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:domain rdf:resource="#TLSProtocol"/>
    <rdfs:domain rdf:resource="#EndToEndEncryptionProtocol"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:range rdf:resource="#SLPipeline"/>
    <rdfs:label xml:lang="en">providesSecureCommunication</rdfs:label>
    <rdfs:comment xml:lang="en">Links secure communication protocols to the SLNode or SLPipeline stages they secure.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property linking SynchronizationProtocol to SLNodes -->
<owl:ObjectProperty rdf:about="#synchronizesNodes">
    <rdfs:domain rdf:resource="#SynchronizationProtocol"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">synchronizesNodes</rdfs:label>
    <rdfs:comment xml:lang="en">Links SynchronizationProtocol to the SLNodes it synchronizes, ensuring that they are aligned in the learning process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: allocatedResources (amount of resources allocated to a specific SLNode) -->
<owl:ObjectProperty rdf:about="#allocatedResources">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">allocatedResources</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the resources allocated to a specific SLNode.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: reallocatedTo (links SystemInfrastructure to a new SLNode if resources are reallocated) -->
<owl:ObjectProperty rdf:about="#reallocatedTo">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#SLNode"/>
    <rdfs:label xml:lang="en">reallocatedTo</rdfs:label>
    <rdfs:comment xml:lang="en">Links SystemInfrastructure to a new SLNode if its resources are reallocated dynamically.</rdfs:comment>
</owl:ObjectProperty>

