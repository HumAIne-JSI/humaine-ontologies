    <rdfs:domain rdf:resource="#ReasoningLatencyMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">reasoning latency value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the time (in seconds) taken by the model to perform reasoning tasks.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: inferenceThroughputValue (ThroughputMetric -> float) -->
