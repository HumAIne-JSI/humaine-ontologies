    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">inference throughput value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the rate of inference made by the model, typically measured as data processed per second.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: classificationAccuracyValue (ClassificationMetric -> float) -->
<owl:DatatypeProperty rdf:about="#classificationAccuracyValue">
    <rdfs:domain rdf:resource="#ClassificationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">classification accuracy value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the accuracy value for classification tasks, typically measured as a percentage.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: reasoningCorrectnessValue (ReasoningMetric -> float) -->
<owl:DatatypeProperty rdf:about="#reasoningCorrectnessValue">
    <rdfs:domain rdf:resource="#ReasoningMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">reasoning correctness value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the correctness value for reasoning tasks, typically expressed as a ratio or percentage.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: predictionErrorValue (PredictionMetric -> float) -->
<owl:DatatypeProperty rdf:about="#predictionErrorValue">
    <rdfs:domain rdf:resource="#PredictionMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">prediction error value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the error value for prediction tasks, typically represented as a floating-point value.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: convergenceTimeValue (ConvergenceTimeMetric -> float) -->
<owl:DatatypeProperty rdf:about="#convergenceTimeValue">
    <rdfs:domain rdf:resource="#ConvergenceTimeMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">convergence time value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the time it takes for a model (especially neural networks) to converge, measured in seconds.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: logicConsistencyValue (LogicConsistencyMetric -> float) -->
<owl:DatatypeProperty rdf:about="#logicConsistencyValue">
    <rdfs:domain rdf:resource="#LogicConsistencyMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">logic consistency value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the consistency of symbolic reasoning with formal logic, typically expressed as a percentage.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: completenessValue (CompletenessMetric -> float) -->
<owl:DatatypeProperty rdf:about="#completenessValue">
    <rdfs:domain rdf:resource="#CompletenessMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">completeness value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the completeness of the reasoning process, typically expressed as a percentage or ratio.</rdfs:comment>
</owl:DatatypeProperty>

