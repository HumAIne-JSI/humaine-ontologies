<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns="http://www.example.org/activelearningontology#">
		 
		  <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://www.example.org/SwarmLearningOntology">
        <rdfs:comment>Initial version of the formal ontology representing generic concepts and processes in NeuroSymbolic Learning systems. Developed within HumAIne progect</rdfs:comment>
    </owl:Ontology>
	
	
<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Classes -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->

<!-- Declaration of the NeuroSymbolicLearning Top Class -->
<owl:Class rdf:about="#NeuroSymbolicLearning">
    <rdfs:label xml:lang="en">Neuro-Symbolic Learning</rdfs:label>
    <rdfs:comment xml:lang="en">This is the top-level class for the Neuro-Symbolic Learning ontology. It represents the entire system structure, serving as an umbrella for various components like models, data, and infrastructure.</rdfs:comment>
</owl:Class>

<!--  NSLModel Class -->
<owl:Class rdf:about="#NSLModel">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">NSL Model</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents models used in the NSL system, including neural networks, symbolic reasoning models, and hybrid models.</rdfs:comment>
</owl:Class>

<!-- Subclasses of NSLModel -->
<!-- Subclass NeuralNetworkModel -->

<owl:Class rdf:about="#NeuralNetworkModel">
    <rdfs:subClassOf rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">Neural Network Model</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents models based on neural networks within the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclasses OF NeuralNetworkModel -->

<owl:Class rdf:about="#FeedforwardNeuralNetwork">
    <rdfs:subClassOf rdf:resource="#NeuralNetworkModel"/>
    <rdfs:label xml:lang="en">Feedforward Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents feedforward neural networks (FNNs) without any recurrent connections.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RecurrentNeuralNetwork">
    <rdfs:subClassOf rdf:resource="#NeuralNetworkModel"/>
    <rdfs:label xml:lang="en">Recurrent Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents recurrent neural networks (RNNs), which have connections between neurons that form directed cycles.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ConvolutionalNeuralNetwork">
    <rdfs:subClassOf rdf:resource="#NeuralNetworkModel"/>
    <rdfs:label xml:lang="en">Convolutional Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents convolutional neural networks (CNNs), commonly used for image and spatial data processing.</rdfs:comment>
</owl:Class>

<!-- Subclass SymbolicReasoningModel -->

<owl:Class rdf:about="#SymbolicReasoningModel">
    <rdfs:subClassOf rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">Symbolic Reasoning Model</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents models based on symbolic reasoning in the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclasses of SymbolicReasoningModel -->

<owl:Class rdf:about="#RuleBasedSystem">
    <rdfs:subClassOf rdf:resource="#SymbolicReasoningModel"/>
    <rdfs:label xml:lang="en">Rule-Based System</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents symbolic models that operate based on a set of predefined rules (e.g., expert systems).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LogicProgrammingModel">
    <rdfs:subClassOf rdf:resource="#SymbolicReasoningModel"/>
    <rdfs:label xml:lang="en">Logic Programming Model</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents models using logic programming, typically based on formal logic such as Prolog.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OntologicalReasoningModel">
    <rdfs:subClassOf rdf:resource="#SymbolicReasoningModel"/>
    <rdfs:label xml:lang="en">Ontological Reasoning Model</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents models that use ontologies and knowledge bases for reasoning.</rdfs:comment>
</owl:Class>

<!-- Subclass HybridModel -->

<owl:Class rdf:about="#HybridModel">
    <rdfs:subClassOf rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">Hybrid Model</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents models that combine neural network and symbolic reasoning approaches within the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclasses of HybridModel -->

<owl:Class rdf:about="#NeuralGuidedSymbolicModel">
    <rdfs:subClassOf rdf:resource="#HybridModel"/>
    <rdfs:label xml:lang="en">Neural-Guided Symbolic Model</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents hybrid models where neural network outputs guide symbolic reasoning.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SymbolicallyEnhancedNeuralModel">
    <rdfs:subClassOf rdf:resource="#HybridModel"/>
    <rdfs:label xml:lang="en">Symbolically-Enhanced Neural Model</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents hybrid models where symbolic logic enhances the behavior of neural networks.</rdfs:comment>
</owl:Class>

<!-- Subclass ProbabilisticReasoningModel-->

<owl:Class rdf:about="#ProbabilisticReasoningModel">
    <rdfs:subClassOf rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">Probabilistic Reasoning Model</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents models that incorporate probabilistic reasoning, combining logic and uncertainty handling.</rdfs:comment>
</owl:Class>

<!-- Optional Subclass for Probabilistic Models -->

<owl:Class rdf:about="#ProbabilisticReasoningModel">
    <rdfs:subClassOf rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">Probabilistic Reasoning Model</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents models that incorporate probabilistic reasoning, combining logic and uncertainty handling.</rdfs:comment>
</owl:Class>

<!-- Declaration of NSLPipeline Class -->
<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">NSL Pipeline</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the pipeline through which data is processed, models are trained, and inferences are made in the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclasses of NSLPipeline Stages -->

<owl:Class rdf:about="#DataProcessingStage">
    <rdfs:subClassOf rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">Data Processing Stage</rdfs:label>
    <rdfs:comment xml:lang="en">This stage represents data preparation, cleaning, transformation, and feature extraction tasks.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ModelTrainingStage">
    <rdfs:subClassOf rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">Model Training Stage</rdfs:label>
    <rdfs:comment xml:lang="en">This stage represents training of the NSLModel on the data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReasoningStage">
    <rdfs:subClassOf rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">Reasoning Stage</rdfs:label>
    <rdfs:comment xml:lang="en">This stage represents symbolic reasoning or hybrid reasoning operations.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InferenceStage">
    <rdfs:subClassOf rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">Inference Stage</rdfs:label>
    <rdfs:comment xml:lang="en">This stage represents the model inference, where the model makes predictions or decisions.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EvaluationStage">
    <rdfs:subClassOf rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">Evaluation Stage</rdfs:label>
    <rdfs:comment xml:lang="en">This stage represents the evaluation of the model’s performance using specific metrics.</rdfs:comment>
</owl:Class>

<!-- NSLTask Top Class -->
<owl:Class rdf:about="#NSLTask">
 <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">NSL Task</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents specific tasks in the NSL system, such as classification, prediction, or reasoning, which influence the design of the NSLPipeline.</rdfs:comment>
</owl:Class>

<!-- Subclasses of NSLTask -->
<owl:Class rdf:about="#ClassificationTask">
    <rdfs:subClassOf rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">Classification Task</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents tasks where the NSL system performs classification of data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReasoningTask">
    <rdfs:subClassOf rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">Reasoning Task</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents tasks where the NSL system performs symbolic reasoning or logical inference.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PredictionTask">
    <rdfs:subClassOf rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">Prediction Task</rdfs:label>
    <rdfs:comment xml:lang="en">This subclass represents tasks where the NSL system predicts outcomes based on data.</rdfs:comment>
</owl:Class>

<!-- Declaration of Data Class -->
<owl:Class rdf:about="#Data">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the data used in NSL systems, including raw data, processed data, labeled data, and metadata-enhanced data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Data">
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the various types of data used in the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclass: Training Data -->
<owl:Class rdf:about="#TrainingData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">Training Data</rdfs:label>
    <rdfs:comment xml:lang="en">Data used for training the models in the system.</rdfs:comment>
</owl:Class>

<!-- Subclass: Testing Data -->
<owl:Class rdf:about="#TestingData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">Testing Data</rdfs:label>
    <rdfs:comment xml:lang="en">Data used for testing and evaluating the performance of models.</rdfs:comment>
</owl:Class>

<!-- Subclass: Metadata Enhanced Data -->
<owl:Class rdf:about="#MetadataEnhancedData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">Metadata Enhanced Data</rdfs:label>
    <rdfs:comment xml:lang="en">Data that has been enriched with additional metadata such as context, labels, or provenance.</rdfs:comment>
</owl:Class>

<!-- Subclass: Augmented Data -->
<owl:Class rdf:about="#AugmentedData">
    <rdfs:subClassOf rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">Augmented Data</rdfs:label>
    <rdfs:comment xml:lang="en">Data that has been augmented or synthetically generated to improve model performance.</rdfs:comment>
</owl:Class>

<!-- Declaration of HumanParticipant Class -->
<owl:Class rdf:about="#HumanParticipant">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">Human Participant</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents human agents who participate in the NSL system, such as human decision-makers and annotators.</rdfs:comment>
</owl:Class>

<!-- Human Participant Class -->
<owl:Class rdf:about="#HumanParticipant">
    <rdfs:label xml:lang="en">Human Participant</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a human involved in the NSL system, contributing to tasks like annotation, decision-making, or evaluation.</rdfs:comment>
</owl:Class>

<!-- Subclass: Human Annotator -->
<owl:Class rdf:about="#HumanAnnotator">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">Human Annotator</rdfs:label>
    <rdfs:comment xml:lang="en">A human participant responsible for providing annotations or labels for training data.</rdfs:comment>
</owl:Class>

<!-- Subclass: Human Decision Maker -->
<owl:Class rdf:about="#HumanDecisionMaker">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">Human Decision Maker</rdfs:label>
    <rdfs:comment xml:lang="en">A human participant responsible for making decisions based on the output of the NSL system.</rdfs:comment>
</owl:Class>

<!-- Subclass: Human Evaluator -->
<owl:Class rdf:about="#HumanEvaluator">
    <rdfs:subClassOf rdf:resource="#HumanParticipant"/>
    <rdfs:label xml:lang="en">Human Evaluator</rdfs:label>
    <rdfs:comment xml:lang="en">A human participant responsible for evaluating model performance and the effectiveness of the NSL pipeline.</rdfs:comment>
</owl:Class>

<!-- Declaration of CommunicationProtocol Class -->
<owl:Class rdf:about="#CommunicationProtocol">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">Communication Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols used in the NSL system, including peer-to-peer and secure communication protocols.</rdfs:comment>
</owl:Class>

<!-- Subclass: Secure Communication Protocol -->
<owl:Class rdf:about="#SecureCommunicationProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">Secure Communication Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols that ensure security through encryption or authentication.</rdfs:comment>
</owl:Class>

<!-- Subclass: Peer-to-Peer Protocol -->
<owl:Class rdf:about="#PeerToPeerProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">Peer-to-Peer Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols where nodes communicate directly with one another without centralized control.</rdfs:comment>
</owl:Class>

<!-- Subclass: Broadcast Protocol -->
<owl:Class rdf:about="#BroadcastProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">Broadcast Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols that allow broadcasting of messages or data to multiple nodes simultaneously.</rdfs:comment>
</owl:Class>

<!-- Subclass: End-to-End Encryption Protocol -->
<owl:Class rdf:about="#EndToEndEncryptionProtocol">
    <rdfs:subClassOf rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:label xml:lang="en">End-to-End Encryption Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents secure communication protocols that provide end-to-end encryption, ensuring only the sender and receiver can access the data.</rdfs:comment>
</owl:Class>

<!-- Subclass: Synchronization Protocol -->
<owl:Class rdf:about="#SynchronizationProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">Synchronization Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols that handle synchronization between system nodes or components.</rdfs:comment>
</owl:Class>

<!-- Subclass: Provenance Tracking Protocol -->
<owl:Class rdf:about="#ProvenanceTrackingProtocol">
    <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">Provenance Tracking Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents communication protocols that track the history and provenance of data as it moves through the system.</rdfs:comment>
</owl:Class>

<!-- Declaration of SystemInfrastructure Class -->
<owl:Class rdf:about="#SystemInfrastructure">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">System Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the infrastructure that supports the NSL system, including cloud, edge, and local infrastructure.</rdfs:comment>
</owl:Class>

<!-- System Infrastructure Class -->
<owl:Class rdf:about="#SystemInfrastructure">
    <rdfs:label xml:lang="en">System Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents the physical and virtual infrastructure that supports NSL operations, including cloud, edge, and on-premises environments.</rdfs:comment>
</owl:Class>

<!-- Subclass: Cloud Infrastructure -->
<owl:Class rdf:about="#CloudInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">Cloud Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents cloud-based infrastructure used to support NSL operations.</rdfs:comment>
</owl:Class>

<!-- Subclass: Edge Infrastructure -->
<owl:Class rdf:about="#EdgeInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">Edge Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents edge computing infrastructure, typically located closer to data sources for low-latency operations.</rdfs:comment>
</owl:Class>

<!-- Subclass: On-Premise Infrastructure -->
<owl:Class rdf:about="#OnPremiseInfrastructure">
    <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
    <rdfs:label xml:lang="en">On-Premise Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Represents traditional on-premises infrastructure hosted in local data centers.</rdfs:comment>
</owl:Class>

<!-- Declaration of EvaluationMetrics Class -->
<owl:Class rdf:about="#EvaluationMetrics">
    <rdfs:subClassOf rdf:resource="#NeuroSymbolicLearning"/>
    <rdfs:label xml:lang="en">Evaluation Metrics</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the metrics used to evaluate the performance of the NSL system, including accuracy, efficiency, and latency metrics.</rdfs:comment>
</owl:Class>

<!-- Subclasses of EvaluationMetrics -->
<!-- General Metrics -->
<owl:Class rdf:about="#GeneralMetrics">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">General Metrics</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents general metrics used across multiple pipeline stages.</rdfs:comment>
</owl:Class>

<!-- Task-Specific Metrics -->
<owl:Class rdf:about="#TaskSpecificMetrics">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">Task-Specific Metrics</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents metrics that are tied to specific tasks performed by the models.</rdfs:comment>
</owl:Class>

<!-- Subclass of Task-Specific Metrics -->
<owl:Class rdf:about="#ClassificationMetric">
    <rdfs:subClassOf rdf:resource="#TaskSpecificMetrics"/>
    <rdfs:label xml:lang="en">Classification Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric evaluates models used for classification tasks.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReasoningMetric">
    <rdfs:subClassOf rdf:resource="#TaskSpecificMetrics"/>
    <rdfs:label xml:lang="en">Reasoning Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric evaluates models involved in reasoning tasks.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PredictionMetric">
    <rdfs:subClassOf rdf:resource="#TaskSpecificMetrics"/>
    <rdfs:label xml:lang="en">Prediction Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric evaluates models performing prediction tasks, such as time-series forecasting.</rdfs:comment>
</owl:Class>

<!-- Model-Specific Metrics -->
<owl:Class rdf:about="#ModelSpecificMetrics">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">Model-Specific Metrics</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents metrics that are tied to specific types of models.</rdfs:comment>
</owl:Class>

<!-- Subclass of Model-Specific Metrics -->
<owl:Class rdf:about="#ConvergenceTimeMetric">
    <rdfs:subClassOf rdf:resource="#ModelSpecificMetrics"/>
    <rdfs:label xml:lang="en">Convergence Time Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the time taken for the neural network model to converge during training.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LogicConsistencyMetric">
    <rdfs:subClassOf rdf:resource="#ModelSpecificMetrics"/>
    <rdfs:label xml:lang="en">Logic Consistency Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures how well the symbolic reasoning model adheres to logical rules.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CompletenessMetric">
    <rdfs:subClassOf rdf:resource="#ModelSpecificMetrics"/>
    <rdfs:label xml:lang="en">Completeness Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures whether the model derives all possible conclusions from the given rules and knowledge base.</rdfs:comment>
</owl:Class>

<!-- Stage-Specific Metrics -->
<owl:Class rdf:about="#StageSpecificMetrics">
    <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">Stage-Specific Metrics</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents metrics that are specific to particular stages of the pipeline.</rdfs:comment>
</owl:Class>

<!-- DataProcessingMetrics -->
<owl:Class rdf:about="#DataProcessingMetrics">
    <rdfs:subClassOf rdf:resource="#StageSpecificMetrics"/>
    <rdfs:label xml:lang="en">Data Processing Metrics</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ProcessingEfficiencyMetric">
    <rdfs:subClassOf rdf:resource="#DataProcessingMetrics"/>
    <rdfs:label xml:lang="en">Processing Efficiency Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the efficiency of data processing tasks such as feature extraction and preprocessing.</rdfs:comment>
</owl:Class>

<!-- ModelTrainingMetrics -->
<owl:Class rdf:about="#ModelTrainingMetrics">
    <rdfs:subClassOf rdf:resource="#StageSpecificMetrics"/>
    <rdfs:label xml:lang="en">Model Training Metrics</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TrainingAccuracyMetric">
    <rdfs:subClassOf rdf:resource="#ModelTrainingMetrics"/>
    <rdfs:label xml:lang="en">Training Accuracy Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the accuracy of the model during the training stage.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ConvergenceTimeMetric">
    <rdfs:subClassOf rdf:resource="#ModelTrainingMetrics"/>
    <rdfs:label xml:lang="en">Convergence Time Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the time taken for the model to converge during training.</rdfs:comment>
</owl:Class>

<!-- ReasoningMetrics -->
<owl:Class rdf:about="#ReasoningMetrics">
    <rdfs:subClassOf rdf:resource="#StageSpecificMetrics"/>
    <rdfs:label xml:lang="en">Reasoning Metrics</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LogicConsistencyMetric">
    <rdfs:subClassOf rdf:resource="#ReasoningMetrics"/>
    <rdfs:label xml:lang="en">Logic Consistency Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures how consistent the model's reasoning is with logical rules.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReasoningLatencyMetric">
    <rdfs:subClassOf rdf:resource="#ReasoningMetrics"/>
    <rdfs:label xml:lang="en">Reasoning Latency Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the time taken by the model to perform reasoning tasks.</rdfs:comment>
</owl:Class>

<!-- InferenceMetrics -->
<owl:Class rdf:about="#InferenceMetrics">
    <rdfs:subClassOf rdf:resource="#StageSpecificMetrics"/>
    <rdfs:label xml:lang="en">Inference Metrics</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InferenceAccuracyMetric">
    <rdfs:subClassOf rdf:resource="#InferenceMetrics"/>
    <rdfs:label xml:lang="en">Inference Accuracy Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the accuracy of the model during the inference stage.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InferenceLatencyMetric">
    <rdfs:subClassOf rdf:resource="#InferenceMetrics"/>
    <rdfs:label xml:lang="en">Inference Latency Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the time taken by the model to make inferences.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ThroughputMetric">
    <rdfs:subClassOf rdf:resource="#InferenceMetrics"/>
    <rdfs:label xml:lang="en">Throughput Metric</rdfs:label>
    <rdfs:comment xml:lang="en">This metric measures the rate at which the model processes data or produces inferences.</rdfs:comment>
</owl:Class>
<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Disjoint axioms -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->
<!-- Disjoint Classes: Ensures each protocol type is distinct -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#SecureCommunicationProtocol"/>
        <rdf:Description rdf:about="#PeerToPeerProtocol"/>
        <rdf:Description rdf:about="#BroadcastProtocol"/>
         <rdf:Description rdf:about="#SynchronizationProtocol"/>
        <rdf:Description rdf:about="#ProvenanceTrackingProtocol"/>
    </owl:members>
</owl:AllDisjointClasses>
<!--  -->
<!-- ################################################################# -->
<!-- # -->
<!-- #    Cardinality constraints  -->
<!-- # -->
<!-- ################################################################# -->
<!--  -->


<!-- NSLTask requires at least one NSLModel -->
<owl:Class rdf:about="#NSLTask">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#requiresModel"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- NSLPipeline executes one or more NSLTasks -->
<owl:Restriction>
    <owl:onProperty rdf:resource="#executesTask"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:minCardinality>
</owl:Restriction> 

<!-- NSLPipeline must be linked to at least one evaluation metric for each stage -->
<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#evaluatesPipelineStage"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- (optional) Inference Stage must have at most 3 evaluation metrics -->
<owl:Class rdf:about="#InferenceStage">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#evaluatesInferenceStage"/>
            <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:maxCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Reasoning Task must be linked to at least one model -->
<owl:Class rdf:about="#ReasoningTask">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#requiresModel"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Prediction Task must be linked to at least one model -->
<owl:Class rdf:about="#PredictionTask">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#requiresModel"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- NSLPipeline must trigger at least one reevaluation at the pipeline level -->
<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#triggersPipelineReevaluation"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- NSLPipeline may also trigger task reevaluations -->
<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#triggersTaskReevaluation"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class> 

<!-- Feedback Loop triggers reevaluation with a limit 4 -->
<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#triggersPipelineReevaluation"/>
            <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:maxCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>  

<owl:Class rdf:about="#NSLPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#triggersTaskReevaluation"/>
            <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:maxCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>  

<!-- ModelTrainingStage must be executed by at least one infrastructure component -->
<owl:Class rdf:about="#ModelTrainingStage">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#executesPipelineStage"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- DataProcessingStage must be executed by at least one infrastructure component -->
<owl:Class rdf:about="#DataProcessingStage">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#executesPipelineStage"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- A model evaluation task must involve at least one human evaluator -->
<owl:Class rdf:about="#ModelEvaluationTask">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#evaluatesModel"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>
