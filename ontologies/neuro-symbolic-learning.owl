<!-- Data Property: datasetSize (Data -> integer) -->
<owl:DatatypeProperty rdf:about="#datasetSize">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">dataset size</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the size of the dataset in terms of the number of instances or records.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#preprocessingType">
    <rdfs:domain rdf:resource="#TrainingData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">preprocessing type</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the preprocessing method applied to the training data, such as normalization or balancing.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#batchSize">
    <rdfs:domain rdf:resource="#TrainingData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">batch size</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the size of data batches used in training.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#epochCount">
    <rdfs:domain rdf:resource="#TrainingData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">epoch count</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the number of epochs or iterations over the training data.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#splitRatio">
    <rdfs:domain rdf:resource="#TestingData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">split ratio</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the ratio of data split between training and testing, such as 80:20.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#validationType">
    <rdfs:domain rdf:resource="#TestingData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">validation type</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the method of validation for the testing data, such as cross-validation or holdout.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#metadataType">
    <rdfs:domain rdf:resource="#MetadataEnhancedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">metadata type</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the type of metadata added to the data, such as labels or provenance.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:ObjectProperty rdf:about="#generatedBy">
    <rdfs:domain rdf:resource="#MetadataEnhancedData"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">generated by</rdfs:label>
    <rdfs:comment xml:lang="en">Links metadata-enhanced data to the task or process that generated the metadata.</rdfs:comment>
</owl:ObjectProperty>
 
<owl:DatatypeProperty rdf:about="#augmentationMethod">
    <rdfs:domain rdf:resource="#AugmentedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">augmentation method</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the method used to augment the data, such as oversampling or noise injection.</rdfs:comment>
</owl:DatatypeProperty>
 
<owl:DatatypeProperty rdf:about="#augmentationPurpose">
    <rdfs:domain rdf:resource="#AugmentedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">augmentation purpose</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the purpose of augmenting the data, such as to address class imbalance or improve model generalization.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: encryptionType (SecureCommunicationProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#encryptionType">
    <rdfs:domain rdf:resource="#SecureCommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">encryption type</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the encryption method used in secure communication protocols (e.g., SSL/TLS).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: reliability (CommunicationProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#reliability">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">reliability</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the reliability level of the communication protocol, such as guaranteed delivery or best effort.</rdfs:comment>
</owl:DatatypeProperty>
<!--  -->

<!-- Data Property: encryptionType (EndToEndEncryptionProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#encryptionType">
    <rdfs:domain rdf:resource="#EndToEndEncryptionProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">encryption type</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the type of encryption used in the End-to-End Encryption Protocol, such as AES or RSA.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: keyManagementScheme (EndToEndEncryptionProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#keyManagementScheme">
    <rdfs:domain rdf:resource="#EndToEndEncryptionProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">key management scheme</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the method of key management in the encryption protocol, such as public-private key exchange or symmetric key management.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: latency (SynchronizationProtocol -> float) -->
<owl:DatatypeProperty rdf:about="#latency">
    <rdfs:domain rdf:resource="#SynchronizationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the time delay or latency introduced by the synchronization protocol, measured in milliseconds.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: consistencyModel (SynchronizationProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#consistencyModel">
    <rdfs:domain rdf:resource="#SynchronizationProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">consistency model</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the consistency model of the synchronization protocol, such as eventual consistency or strong consistency.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: provenanceGranularity (ProvenanceTrackingProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#provenanceGranularity">
    <rdfs:domain rdf:resource="#ProvenanceTrackingProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">provenance granularity</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the level of detail in provenance tracking, such as task-level or data file-level granularity.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: trackingMethod (ProvenanceTrackingProtocol -> string) -->
<owl:DatatypeProperty rdf:about="#trackingMethod">
    <rdfs:domain rdf:resource="#ProvenanceTrackingProtocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">tracking method</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the method used to track provenance, such as blockchain or logging mechanisms.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: latency (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#latency">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the network latency associated with the system infrastructure, measured in milliseconds.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: computationalPower (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#computationalPower">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">computational power</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the computational power of the system infrastructure, measured in TFLOPS (teraflops) or other units.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: storageCapacity (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#storageCapacity">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">storage capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the storage capacity available in the system infrastructure, typically measured in terabytes (TB).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: memoryCapacity (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#memoryCapacity">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">memory capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the memory capacity (RAM) available in the system infrastructure, typically measured in gigabytes (GB).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: bandwidth (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#bandwidth">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">bandwidth</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the network bandwidth available for data transfer, typically measured in Gbps (gigabits per second).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: replicationFactor (SystemInfrastructure -> int) -->
<owl:DatatypeProperty rdf:about="#replicationFactor">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:label xml:lang="en">replication factor</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the replication factor for data or tasks across different infrastructure nodes, typically an integer value.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: faultToleranceLevel (SystemInfrastructure -> string) -->
<owl:DatatypeProperty rdf:about="#faultToleranceLevel">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">fault tolerance level</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the level of fault tolerance in the system infrastructure, such as "basic" or "high".</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: energyConsumption (SystemInfrastructure -> float) -->
<owl:DatatypeProperty rdf:about="#energyConsumption">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">energy consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the total energy consumption of the system infrastructure, typically measured in kilowatt-hours (kWh).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: securityLevel (SystemInfrastructure -> string) -->
<owl:DatatypeProperty rdf:about="#securityLevel">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">security level</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the security level of the system infrastructure, such as "low", "medium", or "high".</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: firewallEnabled (SystemInfrastructure -> boolean) -->
<owl:DatatypeProperty rdf:about="#firewallEnabled">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">firewall enabled</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates whether a firewall is enabled for the system infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Property: supportsProtocol (SystemInfrastructure -> CommunicationProtocol) -->
<owl:ObjectProperty rdf:about="#supportsProtocol">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">supports protocol</rdfs:label>
    <rdfs:comment xml:lang="en">Links system infrastructure to the communication protocols it supports.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: protocolAllocatedToInfrastructure (CommunicationProtocol -> SystemInfrastructure) -->
<owl:ObjectProperty rdf:about="#protocolAllocatedToInfrastructure">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <owl:inverseOf rdf:resource="#supportsProtocol"/>
    <rdfs:label xml:lang="en">protocol allocated to infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates which communication protocols are allocated to specific infrastructure components.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: executesPipelineStage (SystemInfrastructure -> NSLPipeline) -->
<owl:ObjectProperty rdf:about="#executesPipelineStage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">executes pipeline stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links system infrastructure to the stages of the NSLPipeline that it executes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: pipelineUsesInfrastructure (NSLPipeline -> SystemInfrastructure) -->
<owl:ObjectProperty rdf:about="#pipelineUsesInfrastructure">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <owl:inverseOf rdf:resource="#executesPipelineStage"/>
    <rdfs:label xml:lang="en">pipeline uses infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates which infrastructure components are used by specific NSLPipeline stages.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: communicatesForPipelineStage (CommunicationProtocol -> NSLPipeline) -->
<owl:ObjectProperty rdf:about="#communicatesForPipelineStage">
    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">communicates for pipeline stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links communication protocols to the pipeline stages they are used to support communication for.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: pipelineStageUsesProtocol (NSLPipeline -> CommunicationProtocol) -->
<owl:ObjectProperty rdf:about="#pipelineStageUsesProtocol">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#CommunicationProtocol"/>
    <owl:inverseOf rdf:resource="#communicatesForPipelineStage"/>
    <rdfs:label xml:lang="en">pipeline stage uses protocol</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates which communication protocols are used by specific stages of the NSLPipeline.</rdfs:comment>
</owl:ObjectProperty>



