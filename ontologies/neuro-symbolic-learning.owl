    <rdfs:domain rdf:resource="#CommunicationProtocol"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">communicates for pipeline stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links communication protocols to the pipeline stages they are used to support communication for.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: pipelineStageUsesProtocol (NSLPipeline -> CommunicationProtocol) -->
<owl:ObjectProperty rdf:about="#pipelineStageUsesProtocol">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#CommunicationProtocol"/>
    <owl:inverseOf rdf:resource="#communicatesForPipelineStage"/>
