</owl:ObjectProperty>

<!-- Property: evaluatesSymbolicReasoningModel (LogicConsistencyMetric -> SymbolicReasoningModel) -->
<owl:ObjectProperty rdf:about="#evaluatesSymbolicReasoningModel">
    <rdfs:domain rdf:resource="#LogicConsistencyMetric"/>
    <rdfs:range rdf:resource="#SymbolicReasoningModel"/>
    <rdfs:label xml:lang="en">evaluates symbolic reasoning model</rdfs:label>
    <rdfs:comment xml:lang="en">Links logic consistency metrics to symbolic reasoning models.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByLogicConsistencyMetric (SymbolicReasoningModel -> LogicConsistencyMetric) -->
<owl:ObjectProperty rdf:about="#evaluatedByLogicConsistencyMetric">
    <rdfs:domain rdf:resource="#SymbolicReasoningModel"/>
    <rdfs:range rdf:resource="#LogicConsistencyMetric"/>
    <rdfs:inverseOf rdf:resource="#evaluatesSymbolicReasoningModel"/>
    <rdfs:label xml:lang="en">evaluated by logic consistency metric</rdfs:label>
    <rdfs:comment xml:lang="en">Links symbolic reasoning models to the logic consistency metrics used to evaluate them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesDataProcessingStage (ProcessingEfficiencyMetric -> DataProcessingStage) -->
<owl:ObjectProperty rdf:about="#evaluatesDataProcessingStage">
    <rdfs:domain rdf:resource="#ProcessingEfficiencyMetric"/>
    <rdfs:range rdf:resource="#DataProcessingStage"/>
    <rdfs:label xml:lang="en">evaluates data processing stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links processing efficiency metrics to the data processing stage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByProcessingMetric (DataProcessingStage -> ProcessingEfficiencyMetric) -->
<owl:ObjectProperty rdf:about="#evaluatedByProcessingMetric">
    <rdfs:domain rdf:resource="#DataProcessingStage"/>
    <rdfs:range rdf:resource="#ProcessingEfficiencyMetric"/>
    <rdfs:inverseOf rdf:resource="#evaluatesDataProcessingStage"/>
    <rdfs:label xml:lang="en">evaluated by processing metric</rdfs:label>
    <rdfs:comment xml:lang="en">Links data processing stages to the metrics that evaluate them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesModelTrainingStage (TrainingAccuracyMetric -> ModelTrainingStage) -->
<owl:ObjectProperty rdf:about="#evaluatesModelTrainingStage">
    <rdfs:domain rdf:resource="#TrainingAccuracyMetric"/>
    <rdfs:range rdf:resource="#ModelTrainingStage"/>
    <rdfs:label xml:lang="en">evaluates model training stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links training accuracy metrics to the model training stage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByTrainingAccuracyMetric (ModelTrainingStage -> TrainingAccuracyMetric) -->
<owl:ObjectProperty rdf:about="#evaluatedByTrainingAccuracyMetric">
    <rdfs:domain rdf:resource="#ModelTrainingStage"/>
    <rdfs:range rdf:resource="#TrainingAccuracyMetric"/>
    <rdfs:inverseOf rdf:resource="#evaluatesModelTrainingStage"/>
    <rdfs:label xml:lang="en">evaluated by training accuracy metric</rdfs:label>
    <rdfs:comment xml:lang="en">Links model training stages to the metrics that evaluate them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: evaluatesInferenceStage (InferenceStage -> EvaluationMetrics) -->
<owl:ObjectProperty rdf:about="#evaluatesInferenceStage">
    <rdfs:domain rdf:resource="#InferenceStage"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">evaluates inference stage</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the inference stage to the evaluation metrics that assess it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByInferenceMetric (EvaluationMetrics -> InferenceStage) -->
<owl:ObjectProperty rdf:about="#evaluatedByInferenceMetric">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#InferenceStage"/>
    <rdfs:inverseOf rdf:resource="#evaluatesInferenceStage"/>
    <rdfs:label xml:lang="en">evaluated by inference metric</rdfs:label>
    <rdfs:comment xml:lang="en">This reverse property links evaluation metrics to the inference stage they evaluate.</rdfs:comment>
</owl:ObjectProperty>

<!-- Roles for DataProcessingStage -->

<!-- Property: playsRoleInDataProcessingStage (NSLModel -> DataProcessingStage) -->
<owl:ObjectProperty rdf:about="#playsRoleInDataProcessingStage">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#DataProcessingStage"/>
    <rdfs:label xml:lang="en">plays role in data processing stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLModel to its role in the DataProcessingStage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Roles for ModelTrainingStage -->

<!-- Property: playsRoleInModelTrainingStage (NSLModel -> ModelTrainingStage) -->
<owl:ObjectProperty rdf:about="#playsRoleInModelTrainingStage">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#ModelTrainingStage"/>
    <rdfs:label xml:lang="en">plays role in model training stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLModel to its role in the ModelTrainingStage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Roles for ReasoningStage -->

<!-- Property: playsRoleInReasoningStage (NSLModel -> ReasoningStage) -->
<owl:ObjectProperty rdf:about="#playsRoleInReasoningStage">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#ReasoningStage"/>
    <rdfs:label xml:lang="en">plays role in reasoning stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLModel to its role in the ReasoningStage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Roles for InferenceStage -->

<!-- Property: playsRoleInInferenceStage (NSLModel -> InferenceStage) -->
<owl:ObjectProperty rdf:about="#playsRoleInInferenceStage">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#InferenceStage"/>
    <rdfs:label xml:lang="en">plays role in inference stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLModel to its role in the InferenceStage.</rdfs:comment>
</owl:ObjectProperty>

<!-- Implementation of Feedback Loop -->

<!-- Corrected Property: triggersPipelineReevaluation (NSLPipeline -> EvaluationStage) -->
<owl:ObjectProperty rdf:about="#triggersPipelineReevaluation">
    <rdfs:domain rdf:resource="#NSLPipeline"/> <!-- Now, the pipeline is the entity triggering reevaluation -->
    <rdfs:range rdf:resource="#EvaluationStage"/> <!-- Evaluation stage is where the reevaluation is triggered -->
    <rdfs:label xml:lang="en">triggers pipeline reevaluation</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLPipeline to the evaluation stage, indicating that a reevaluation or retraining process is triggered by the evaluation results.</rdfs:comment>
</owl:ObjectProperty>

<!-- Corrected Property: triggersTaskReevaluation (NSLPipeline -> NSLTask) -->
<owl:ObjectProperty rdf:about="#triggersTaskReevaluation">
    <rdfs:domain rdf:resource="#NSLPipeline"/> <!-- NSLPipeline triggers the task reevaluation -->
    <rdfs:range rdf:resource="#NSLTask"/> <!-- NSLTask is the task being reevaluated -->
    <rdfs:label xml:lang="en">triggers task reevaluation</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLPipeline to the tasks that must be reevaluated based on feedback or evaluation results.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: adjustsModelBasedOnFeedback (NSLPipeline -> NSLModel) -->
<owl:ObjectProperty rdf:about="#adjustsModelBasedOnFeedback">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">adjusts model based on feedback</rdfs:label>
    <rdfs:comment xml:lang="en">Links the feedback loop in the pipeline to the models that are adjusted based on feedback.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsModelBasedOnFeedback (NSLPipeline -> NSLModel) -->
<owl:ObjectProperty rdf:about="#selectsModelBasedOnFeedback">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">selects model based on feedback</rdfs:label>
    <rdfs:comment xml:lang="en">Links the feedback loop to the dynamic selection of models based on the evaluation metrics.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: adjustsTaskBasedOnFeedback (NSLPipeline -> NSLTask) -->
<owl:ObjectProperty rdf:about="#adjustsTaskBasedOnFeedback">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">adjusts task based on feedback</rdfs:label>
    <rdfs:comment xml:lang="en">Links the feedback loop to the reevaluation or adjustment of tasks based on performance feedback.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: trainsModelBasedOnFeedback (NSLPipeline -> NSLModel) -->
<owl:ObjectProperty rdf:about="#trainsModelBasedOnFeedback">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">trains model based on feedback</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the feedback loop to retraining of models based on performance metrics and feedback.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: dependsOnTask (NSLTask -> NSLTask) -->
<owl:ObjectProperty rdf:about="#dependsOnTaskBasedOnFeedback">
    <rdfs:domain rdf:resource="#NSLTask"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">depends on task based on feedback</rdfs:label>
    <rdfs:comment xml:lang="en">Links tasks based on feedback, establishing dynamic dependencies between tasks depending on the feedback from earlier stages.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data class -->

<!-- Property: usedForTesting (Data -> NSLModel) -->
<owl:ObjectProperty rdf:about="#usedForTesting">
    <rdfs:domain rdf:resource="#TestingData"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">used for testing</rdfs:label>
    <rdfs:comment xml:lang="en">Links testing data to the models or tasks it is used to evaluate.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasMetadata (Data -> MetadataEnhancedData) -->
<owl:ObjectProperty rdf:about="#hasMetadata">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="#MetadataEnhancedData"/>
