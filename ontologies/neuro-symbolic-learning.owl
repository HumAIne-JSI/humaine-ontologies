<!-- Relationships Between NSLModel and NSLPipeline -->

	
<!-- Object Property: usesModel (NSLPipeline -> NSLModel) -->
<owl:ObjectProperty rdf:about="#usesModel">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:inverseOf rdf:resource="#usedByPipeline"/>
    <rdfs:label xml:lang="en">uses model</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLPipeline to the NSLModel it uses.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: usedByPipeline (NSLModel -> NSLPipeline) -->
<owl:ObjectProperty rdf:about="#usedByPipeline">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">used by pipeline</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLModel to the NSLPipeline that uses it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: trainedOnData (NSLModel -> Data) -->
<owl:ObjectProperty rdf:about="#trainedOnData">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:inverseOf rdf:resource="#trainsModel"/>
    <rdfs:label xml:lang="en">trained on data</rdfs:label>
    <rdfs:comment xml:lang="en">This property links an NSLModel to the data it is trained on.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: trainsModel (Data -> NSLModel) -->
<owl:ObjectProperty rdf:about="#trainsModel">
    <rdfs:domain rdf:resource="#Data"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">trains model</rdfs:label>
</owl:ObjectProperty>

<!-- Property: involvesData (NSLPipeline -> Data) -->
<owl:ObjectProperty rdf:about="#involvesData">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">involves data</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the NSLPipeline to the data involved in the process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: requiresModel (NSLTask -> NSLModel) -->
<owl:ObjectProperty rdf:about="#requiresModel">
    <rdfs:domain rdf:resource="#NSLTask"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:inverseOf rdf:resource="#requiredForTask"/>
    <rdfs:label xml:lang="en">requires model</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLTask to the NSLModel required to accomplish the task.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: requiredForTask (NSLModel -> NSLTask) -->
<owl:ObjectProperty rdf:about="#requiredForTask">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">required for task</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLModel to the NSLTask for which it is required.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: executedInPipeline (NSLTask -> NSLPipeline) -->
<owl:ObjectProperty rdf:about="#executedInPipeline">
    <rdfs:domain rdf:resource="#NSLTask"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:inverseOf rdf:resource="#executesTask"/>
    <rdfs:label xml:lang="en">executed in pipeline</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLTask to the NSLPipeline where it is executed.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: executesTask (NSLPipeline -> NSLTask) -->
<owl:ObjectProperty rdf:about="#executesTask">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">executes task</rdfs:label>
    <rdfs:comment xml:lang="en">Links an NSLPipeline to the NSLTask it executes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Relationships for the NSLPipeline stages -->

<!-- Property: processesData (DataProcessingStage -> Data) -->
<owl:ObjectProperty rdf:about="#processesData">
    <rdfs:domain rdf:resource="#DataProcessingStage"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">processes data</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the DataProcessingStage to the data it processes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: trainsModel (ModelTrainingStage -> NSLModel) -->
<owl:ObjectProperty rdf:about="#trainsModel">
    <rdfs:domain rdf:resource="#ModelTrainingStage"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">trains model</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the ModelTrainingStage to the NSLModel it trains.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: reasoningWithModel (ReasoningStage -> NSLModel) -->
<owl:ObjectProperty rdf:about="#reasoningWithModel">
    <rdfs:domain rdf:resource="#ReasoningStage"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">reasoning with model</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the ReasoningStage to the NSLModel used for reasoning.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: infersData (InferenceStage -> Data) -->
<owl:ObjectProperty rdf:about="#infersData">
    <rdfs:domain rdf:resource="#InferenceStage"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:label xml:lang="en">infers data</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the InferenceStage to the data it infers from.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: evaluatesPipelineStage (NSLPipeline -> EvaluationMetrics) -->
<owl:ObjectProperty rdf:about="#evaluatesPipelineStage">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:label xml:lang="en">evaluates pipeline stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links the NSLPipeline to the evaluation metrics that assess each stage.</rdfs:comment>
</owl:ObjectProperty>  

<!-- Property: calculatedForModel (EvaluationMetrics -> NSLModel) -->
<owl:ObjectProperty rdf:about="#calculatedForModel">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">calculated for model</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the evaluation metrics to the model they are calculated for.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: calculatesMetric (NSLModel -> EvaluationMetrics) -->
<owl:ObjectProperty rdf:about="#calculatesMetricForModel">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:inverseOf rdf:resource="#calculatedForModel"/>
    <rdfs:label xml:lang="en">calculates metric</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the model to the metrics calculated for it.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesModel (EvaluationMetrics -> NSLModel) -->
<owl:ObjectProperty rdf:about="#evaluatesModel">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#NSLModel"/>
    <rdfs:label xml:lang="en">evaluates model</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the evaluation metrics to the model they are designed to evaluate.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByMetric (NSLModel -> EvaluationMetrics) -->
<owl:ObjectProperty rdf:about="#evaluatedByMetricForModel">
    <rdfs:domain rdf:resource="#NSLModel"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:inverseOf rdf:resource="#evaluatesModel"/>
    <rdfs:label xml:lang="en">evaluated by metric</rdfs:label>
    <rdfs:comment xml:lang="en">This property links the NSLModel to the metrics that evaluate the model.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesTask (TaskSpecificMetrics -> NSLTask) -->
<owl:ObjectProperty rdf:about="#evaluatesTask">
    <rdfs:domain rdf:resource="#TaskSpecificMetrics"/>
    <rdfs:range rdf:resource="#NSLTask"/>
    <rdfs:label xml:lang="en">evaluates task</rdfs:label>
    <rdfs:comment xml:lang="en">This property links task-specific evaluation metrics to specific NSL tasks.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByMetricForTask (NSLTask -> TaskSpecificMetrics) -->
<owl:ObjectProperty rdf:about="#evaluatedByMetricForTask">
    <rdfs:domain rdf:resource="#NSLTask"/>
    <rdfs:range rdf:resource="#TaskSpecificMetrics"/>
    <rdfs:inverseOf rdf:resource="#evaluatesTask"/>
    <rdfs:label xml:lang="en">evaluated by metric for task</rdfs:label>
    <rdfs:comment xml:lang="en">This property links NSL tasks to the metrics used to evaluate them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesClassificationTask (ClassificationMetric -> ClassificationTask) -->
<owl:ObjectProperty rdf:about="#evaluatesClassificationTask">
    <rdfs:domain rdf:resource="#ClassificationMetric"/>
    <rdfs:range rdf:resource="#ClassificationTask"/>
    <rdfs:label xml:lang="en">evaluates classification task</rdfs:label>
    <rdfs:comment xml:lang="en">Links classification metrics to classification tasks.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByClassificationMetric (ClassificationTask -> ClassificationMetric) -->
<owl:ObjectProperty rdf:about="#evaluatedByClassificationMetric">
    <rdfs:domain rdf:resource="#ClassificationTask"/>
    <rdfs:range rdf:resource="#ClassificationMetric"/>
    <rdfs:inverseOf rdf:resource="#evaluatesClassificationTask"/>
    <rdfs:label xml:lang="en">evaluated by classification metric</rdfs:label>
    <rdfs:comment xml:lang="en">This property links classification tasks to the metrics that evaluate them.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesNeuralNetworkModel (ConvergenceTimeMetric -> NeuralNetworkModel) -->
<owl:ObjectProperty rdf:about="#evaluatesNeuralNetworkModel">
    <rdfs:domain rdf:resource="#ConvergenceTimeMetric"/>
    <rdfs:range rdf:resource="#NeuralNetworkModel"/>
    <rdfs:label xml:lang="en">evaluates neural network model</rdfs:label>
    <rdfs:comment xml:lang="en">Links convergence time metrics to neural network models.</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: evaluatedByConvergenceMetric (NeuralNetworkModel -> ConvergenceTimeMetric) -->
<owl:ObjectProperty rdf:about="#evaluatedByConvergenceMetric">
    <rdfs:domain rdf:resource="#NeuralNetworkModel"/>
    <rdfs:range rdf:resource="#ConvergenceTimeMetric"/>
    <rdfs:inverseOf rdf:resource="#evaluatesNeuralNetworkModel"/>
    <rdfs:label xml:lang="en">evaluated by convergence metric</rdfs:label>
