</owl:ObjectProperty>

<!-- Inverse Property for communicatesWithPipeline -->
<owl:ObjectProperty rdf:about="#communicatesWithPipeline">
    <owl:inverseOf rdf:resource="#communicatedByProtocol"/>
</owl:ObjectProperty>

<!-- Reverse Property: NSLPipeline is communicated by protocol -->
<owl:ObjectProperty rdf:about="#communicatedByProtocol">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#CommunicationProtocol"/>
    <rdfs:label xml:lang="en">communicated by protocol</rdfs:label>
</owl:ObjectProperty>

