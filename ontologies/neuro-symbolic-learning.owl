</owl:ObjectProperty>

<!-- Object Property: executesPipelineStage (SystemInfrastructure -> NSLPipeline) -->
<owl:ObjectProperty rdf:about="#executesPipelineStage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#NSLPipeline"/>
    <rdfs:label xml:lang="en">executes pipeline stage</rdfs:label>
    <rdfs:comment xml:lang="en">Links system infrastructure to the NSLPipeline stages it executes (e.g., DataProcessingStage, ModelTrainingStage).</rdfs:comment>
</owl:ObjectProperty>

<!-- Reverse Property: pipelineUsesInfrastructure (NSLPipeline -> SystemInfrastructure) -->
<owl:ObjectProperty rdf:about="#pipelineUsesInfrastructure">
    <rdfs:domain rdf:resource="#NSLPipeline"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <owl:inverseOf rdf:resource="#executesPipelineStage"/>
    <rdfs:label xml:lang="en">pipeline uses infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates which infrastructure components are used by specific NSLPipeline stages.</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Property: communicatesForPipelineStage (CommunicationProtocol -> NSLPipeline) -->
