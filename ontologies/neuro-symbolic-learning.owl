    <rdfs:comment xml:lang="en">This property defines the unit in which the metric is measured (e.g., percentage, seconds).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: threshold (EvaluationMetrics -> float) -->
<owl:DatatypeProperty rdf:about="#threshold">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">threshold</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the threshold value for the metric, such as a minimum acceptable score (e.g., accuracy of 0.8).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: calculatedForNode (EvaluationMetrics -> string) -->
<owl:DatatypeProperty rdf:about="#calculatedForNode">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">calculated for node</rdfs:label>
    <rdfs:comment xml:lang="en">This property specifies which node or system element the metric is calculated for.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: dataProcessingEfficiencyValue (ProcessingEfficiencyMetric -> float) -->
<owl:DatatypeProperty rdf:about="#dataProcessingEfficiencyValue">
    <rdfs:domain rdf:resource="#ProcessingEfficiencyMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">data processing efficiency value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the value of data processing efficiency, typically measured as a percentage.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: trainingAccuracyValue (TrainingAccuracyMetric -> float) -->
<owl:DatatypeProperty rdf:about="#trainingAccuracyValue">
    <rdfs:domain rdf:resource="#TrainingAccuracyMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">training accuracy value</rdfs:label>
    <rdfs:comment xml:lang="en">This property defines the accuracy value during the training phase of a model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: reasoningLatencyValue (ReasoningLatencyMetric -> float) -->
