</owl:ObjectProperty>

<!-- Property: canUseTransferLearningModel -->
<owl:ObjectProperty rdf:about="#canUseTransferLearningModel">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#TransferLearningModel"/>
    <rdfs:comment>Allows any Active Learning task to use a transfer learning model.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: hasDataset -->
<owl:ObjectProperty rdf:about="#hasDataset">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#Dataset"/>
    <rdfs:comment>Links an Active Learning task to the dataset used to train or evaluate the task.</rdfs:comment>
</owl:ObjectProperty>



<!-- Existing Property: hasQueryStrategy -->
<owl:ObjectProperty rdf:about="#hasQueryStrategy">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>Links the ALTask to the query strategy used for selecting instances to be labeled.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: executedInPipeline -->
<owl:ObjectProperty rdf:about="#executedInPipeline">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>Links an Active Learning task to the pipeline where it is executed.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: evaluatesUsingMetric -->
<owl:ObjectProperty rdf:about="#evaluatesUsingMetric">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:comment>This property links an Active Learning task to the evaluation metrics used to measure model performance.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: processesData -->
<owl:ObjectProperty rdf:about="#processesData">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:comment>This property links an Active Learning task to the data it processes, such as instances being labeled or predicted.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: requiresHumanAnnotator -->
<owl:ObjectProperty rdf:about="#requiresHumanAnnotator">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>This property links an Active Learning task to the human annotators required for labeling the selected instances.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: supportedBySystemInfrastructure -->
<owl:ObjectProperty rdf:about="#supportedBySystemInfrastructure">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:comment>This property links an Active Learning task to the system infrastructure necessary for task execution.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: performedInScenario -->
<owl:ObjectProperty rdf:about="#performedInScenario">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>This property links an Active Learning task to the scenario where it is performed.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for ALTask -->
