</owl:ObjectProperty>

<!-- Property: canUseHybridModel -->
<owl:ObjectProperty rdf:about="#canUseHybridModel">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#HybridModel"/>
