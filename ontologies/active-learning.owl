<!-- Object Properties for Model Class -->

<!-- Existing Property: isTrainedOn -->
<owl:ObjectProperty rdf:about="#isTrainedOn">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#Dataset"/>
    <rdfs:comment>Links a model to the dataset it has been trained on.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: usesQueryStrategy -->
<owl:ObjectProperty rdf:about="#usesQueryStrategy">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>Links a model to the query strategy used for instance selection in active learning.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: receivesFeedbackFrom -->
<owl:ObjectProperty rdf:about="#receivesFeedbackFrom">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#FeedbackLoop"/>
    <rdfs:comment>Links a model to the feedback loop from which it receives feedback for performance improvement.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: isEvaluatedBy -->
<owl:ObjectProperty rdf:about="#isEvaluatedBy">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:comment>Links a model to the evaluation metrics used to assess its performance.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: isUpdatedWith -->
<owl:ObjectProperty rdf:about="#isUpdatedWith">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#LabeledDataset"/>
    <rdfs:comment>Links a model to the labeled dataset used for updating the model.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: operatesInScenario -->
<owl:ObjectProperty rdf:about="#operatesInScenario">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>Links a model to the Active Learning scenario in which it operates, such as pool-based or stream-based scenarios.</rdfs:comment>
</owl:ObjectProperty>
<!-- New Property: receivesAnnotationsFrom -->
<owl:ObjectProperty rdf:about="#receivesAnnotationsFrom">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>Links a model to the human annotator responsible for providing annotations during the learning process.</rdfs:comment>
</owl:ObjectProperty>

<!-- ObjectProperty: usesPreTrainedModel -->
<owl:ObjectProperty rdf:about="#usesPreTrainedModel">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links a model to a pre-trained model it uses.</rdfs:comment>
</owl:ObjectProperty>

<!-- Restrict the use of usesPreTrainedModel to TransferLearningModel -->
<owl:Class rdf:about="#TransferLearningModel">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usesPreTrainedModel"/>
            <owl:someValuesFrom rdf:resource="#Model"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Restrict the use of usesPreTrainedModel to TransferLearningHybrid -->
<owl:Class rdf:about="#TransferLearningHybrid">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#usesPreTrainedModel"/>
            <owl:someValuesFrom rdf:resource="#Model"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Data Properties for Model Class -->
<!-- Property: hasTrainingTime -->
<owl:DatatypeProperty rdf:about="#hasTrainingTime">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the time taken to train the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAccuracy -->
<owl:DatatypeProperty rdf:about="#hasAccuracy">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the accuracy of the model, typically measured on a test set.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasParameterCount -->
<owl:DatatypeProperty rdf:about="#hasParameterCount">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of parameters in the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasLearningRate -->
<owl:DatatypeProperty rdf:about="#hasLearningRate">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the learning rate of the model during training.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasLossValue -->
<owl:DatatypeProperty rdf:about="#hasLossValue">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the loss value of the model, typically minimized during training.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: isWeakLearner -->
<owl:DatatypeProperty rdf:about="#isWeakLearner">
    <rdfs:domain rdf:resource="#Model"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>This property indicates whether a model is acting as a weak learner in the context of an ensemble method, such as boosting.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for ClassificationModel and Subclasses -->
<!-- Property: usesBinaryClassifier -->
<owl:ObjectProperty rdf:about="#usesBinaryClassifier">
    <rdfs:domain rdf:resource="#BinaryClassificationModel"/>
    <rdfs:range rdf:resource="#BinaryClassificationModel"/>
    <rdfs:comment>Links a binary classification model to a specific binary classifier, such as Logistic Regression or Support Vector Machine.</rdfs:comment>
</owl:ObjectProperty>

<!-- An instance of LogisticRegression -->
<owl:NamedIndividual rdf:about="#MyLogisticModel">
    <rdf:type rdf:resource="#LogisticRegression"/>
</owl:NamedIndividual>

<!-- An instance of SupportVectorMachine -->
<owl:NamedIndividual rdf:about="#MySVMModel">
    <rdf:type rdf:resource="#SupportVectorMachine"/>
</owl:NamedIndividual>

<!-- Property: handlesMultipleLabels -->
<owl:ObjectProperty rdf:about="#handlesMultipleLabels">
    <rdfs:domain rdf:resource="#MultiLabelClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Indicates whether the model is capable of handling multiple labels per instance.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for ClassificationModel and Subclasses -->
<!-- Property: hasClassCount -->
<owl:DatatypeProperty rdf:about="#hasClassCount">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of classes in a classification model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Data Property: hasMulticlassClassifier for MultiClassClassificationModel -->

<owl:DatatypeProperty rdf:about="#hasMulticlassClassifier">
    <rdfs:domain rdf:resource="#MultiClassClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property specifies the type of multiclass classifier used by the model (e.g., Random Forest, Neural Network, Decision Tree).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasPrecision -->
<owl:DatatypeProperty rdf:about="#hasPrecision">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the precision of the classification model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasRecall -->
<owl:DatatypeProperty rdf:about="#hasRecall">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the recall of the classification model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasF1Score -->
<owl:DatatypeProperty rdf:about="#hasF1Score">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the F1 score of the classification model, combining precision and recall.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAUC -->
<owl:DatatypeProperty rdf:about="#hasAUC">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the Area Under the ROC Curve (AUC) of the classification model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: handlesImbalancedData -->
<owl:DatatypeProperty rdf:about="#handlesImbalancedData">
    <rdfs:domain rdf:resource="#ClassificationModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>This property indicates whether the classification model is designed to handle imbalanced datasets.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for ClusteringModel and Subclasses -->

<!-- Property: usesClusteringModel -->
<owl:ObjectProperty rdf:about="#usesClusteringModel">
    <rdfs:domain rdf:resource="#ClusteringTask"/>
    <rdfs:range rdf:resource="#ClusteringModel"/>
    <rdfs:comment>Links a clustering task to the clustering model being used, such as KMeans or DBSCAN.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for ClusteringModel -->
<!-- Property: hasNumberOfClusters -->
<owl:DatatypeProperty rdf:about="#hasNumberOfClusters">
    <rdfs:domain rdf:resource="#ClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of clusters the model generates or expects.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasClusterInertia -->
<owl:DatatypeProperty rdf:about="#hasClusterInertia">
    <rdfs:domain rdf:resource="#ClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the inertia (or within-cluster sum of squares) of the clustering model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasSilhouetteScore -->
<owl:DatatypeProperty rdf:about="#hasSilhouetteScore">
    <rdfs:domain rdf:resource="#ClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the silhouette score of the clustering model, measuring how well instances are clustered.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: supportsSoftClustering -->
<owl:DatatypeProperty rdf:about="#supportsSoftClustering">
    <rdfs:domain rdf:resource="#ClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>This property indicates whether the clustering model supports soft clustering, where instances can belong to multiple clusters.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for HardClusteringModel -->

<!-- Property: usesHardClusteringModel -->
<owl:ObjectProperty rdf:about="#usesHardClusteringModel">
    <rdfs:domain rdf:resource="#HardClusteringTask"/>
    <rdfs:range rdf:resource="#HardClusteringModel"/>
    <rdfs:comment>Links a hard clustering task to the specific hard clustering model (e.g., KMeans, DBSCAN).</rdfs:comment>
</owl:ObjectProperty>

<!-- Object Properties for SoftClusteringModel -->

<!-- Property: usesSoftClusteringModel -->
<owl:ObjectProperty rdf:about="#usesSoftClusteringModel">
    <rdfs:domain rdf:resource="#SoftClusteringTask"/>
    <rdfs:range rdf:resource="#SoftClusteringModel"/>
    <rdfs:comment>Links a soft clustering task to the specific soft clustering model (e.g., Gaussian Mixture Model, FuzzyCMeans).</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for SoftClusteringModel -->

<!-- Property: hasMembershipProbability -->
<owl:DatatypeProperty rdf:about="#hasMembershipProbability">
    <rdfs:domain rdf:resource="#SoftClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the membership probability of instances in each cluster, specific to soft clustering models.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for HierarchicalClusteringModel -->

<!-- Property: usesHierarchicalClusteringModel -->
<owl:ObjectProperty rdf:about="#usesHierarchicalClusteringModel">
    <rdfs:domain rdf:resource="#HierarchicalClusteringTask"/>
    <rdfs:range rdf:resource="#HierarchicalClusteringModel"/>
    <rdfs:comment>Links a hierarchical clustering task to the specific hierarchical clustering model (e.g., Agglomerative Clustering, Divisive Clustering).</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for HierarchicalClusteringModel -->
<!-- Property: hasLinkageCriterion -->
<owl:DatatypeProperty rdf:about="#hasLinkageCriterion">
    <rdfs:domain rdf:resource="#HierarchicalClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property represents the linkage criterion used in hierarchical clustering (e.g., single, complete, average linkage).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasDendrogramDepth -->
<owl:DatatypeProperty rdf:about="#hasDendrogramDepth">
    <rdfs:domain rdf:resource="#HierarchicalClusteringModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the depth of the dendrogram generated by the hierarchical clustering model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for RegressionModel -->
<!-- Data Property: hasRegressionAlgorithm for RegressionModel -->
<owl:DatatypeProperty rdf:about="#hasRegressionAlgorithm">
    <rdfs:domain rdf:resource="#RegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property represents the type of regression algorithm used by the model (e.g., Linear Regression, Decision Tree Regression).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasMeanSquaredError -->
<owl:DatatypeProperty rdf:about="#hasMeanSquaredError">
    <rdfs:domain rdf:resource="#RegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the Mean Squared Error (MSE) of the regression model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasR2Score -->
<owl:DatatypeProperty rdf:about="#hasR2Score">
    <rdfs:domain rdf:resource="#RegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the R² score of the regression model, indicating the proportion of variance explained.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasRootMeanSquaredError -->
<owl:DatatypeProperty rdf:about="#hasRootMeanSquaredError">
    <rdfs:domain rdf:resource="#RegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the Root Mean Squared Error (RMSE) of the regression model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasMeanAbsoluteError -->
<owl:DatatypeProperty rdf:about="#hasMeanAbsoluteError">
    <rdfs:domain rdf:resource="#RegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the Mean Absolute Error (MAE) of the regression model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for SimpleRegressionModel -->
<!-- Data Property: hasSimpleRegressionAlgorithm for SimpleRegressionModel -->
<owl:DatatypeProperty rdf:about="#hasSimpleRegressionAlgorithm">
    <rdfs:domain rdf:resource="#SimpleRegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property specifies the algorithm type for a simple regression model (e.g., Linear Regression).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for MultiOutputRegressionModel -->

<!-- Data Properties for MultiOutputRegressionModel -->
<!-- Data Property: hasMultiOutputRegressionAlgorithm for MultiOutputRegressionModel -->
<owl:DatatypeProperty rdf:about="#hasMultiOutputRegressionAlgorithm">
    <rdfs:domain rdf:resource="#MultiOutputRegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property specifies the type of regression algorithm used in the multi-output regression model (e.g., Multi-Task Neural Network, Multi-Output Linear Regression).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasNumberOfOutputs -->
<owl:DatatypeProperty rdf:about="#hasNumberOfOutputs">
    <rdfs:domain rdf:resource="#MultiOutputRegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of output variables predicted by the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for RobustRegressionModel -->

<!-- Data Properties for RobustRegressionModel -->

<!-- Data Property: hasRobustRegressionAlgorithm for RobustRegressionModel -->
<owl:DatatypeProperty rdf:about="#hasRobustRegressionAlgorithm">
    <rdfs:domain rdf:resource="#RobustRegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property specifies the type of robust regression algorithm used in the model (e.g., RANSAC, Huber Regression).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasOutlierHandlingCapability -->
<owl:DatatypeProperty rdf:about="#hasOutlierHandlingCapability">
    <rdfs:domain rdf:resource="#RobustRegressionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>This property indicates whether the regression model is capable of handling outliers effectively.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for HybridModel -->

<!-- Property: combinesModels -->
<owl:ObjectProperty rdf:about="#combinesModels">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the hybrid model to the individual models it combines, which may be of different types (e.g., decision tree, neural network).</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for HybridModel -->
<!-- Data Property: hasEnsembleStrategy for HybridModel -->
<owl:DatatypeProperty rdf:about="#hasEnsembleStrategy">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property specifies the ensemble strategy (e.g., stacking, voting, bagging) used by the hybrid model to combine the outputs of individual models.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasModelDiversity -->
<owl:DatatypeProperty rdf:about="#hasModelDiversity">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the diversity of models in the hybrid model, measured by the number of different types of models combined (e.g., decision tree, neural network).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasCombiningEfficiency -->
<owl:DatatypeProperty rdf:about="#hasCombiningEfficiency">
    <rdfs:domain rdf:resource="#HybridModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the efficiency of combining models in the hybrid approach, often reflected in terms of resource usage or speed.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for DeepLearningHybrid -->

<!-- Property: combinesDeepLearningAndTraditionalModels -->
<owl:ObjectProperty rdf:about="#combinesDeepLearningAndTraditionalModels">
    <rdfs:domain rdf:resource="#DeepLearningHybrid"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links a deep learning hybrid model to the traditional and deep learning models it combines.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for DeepLearningHybrid -->

<!-- Property: hasTrainingTime -->
<owl:DatatypeProperty rdf:about="#hasTrainingTime">
    <rdfs:domain rdf:resource="#DeepLearningHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the time taken to train the deep learning component of the hybrid model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for ProbabilisticHybrid -->

<!-- Property: usesProbabilisticAndOtherModels -->
<owl:ObjectProperty rdf:about="#usesProbabilisticAndOtherModels">
    <rdfs:domain rdf:resource="#ProbabilisticHybrid"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the probabilistic hybrid model to both probabilistic and non-probabilistic models it combines.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for ProbabilisticHybrid -->

<!-- Property: hasProbabilityEstimationAccuracy -->
<owl:DatatypeProperty rdf:about="#hasProbabilityEstimationAccuracy">
    <rdfs:domain rdf:resource="#ProbabilisticHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the accuracy of probability estimations made by the probabilistic component of the hybrid model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- TransferLearningHybrid Subclass -->
<owl:Class rdf:about="#TransferLearningHybrid">
    <rdfs:subClassOf rdf:resource="#HybridModel"/>
    <rdfs:comment>This class represents hybrid models that combine transfer learning techniques with other models.</rdfs:comment>
</owl:Class>

<!-- Object Properties for TransferLearningHybrid -->

<!-- Data Properties for TransferLearningHybrid -->

<!-- Data Property: hasTransferMechanism for TransferLearningHybrid -->
<owl:DatatypeProperty rdf:about="#hasTransferMechanism">
    <rdfs:domain rdf:resource="#TransferLearningHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property specifies the transfer mechanism used (e.g., fine-tuning, feature extraction) for transferring knowledge from the pre-trained model to the new task.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasFineTuningLevel -->
<owl:DatatypeProperty rdf:about="#hasFineTuningLevel">
    <rdfs:domain rdf:resource="#TransferLearningHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the degree of fine-tuning applied to the pre-trained model in the transfer learning process.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasTransferAccuracy -->
<owl:DatatypeProperty rdf:about="#hasTransferAccuracy">
    <rdfs:domain rdf:resource="#TransferLearningHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the accuracy achieved after transfer learning and fine-tuning of the model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- EnsembleHybrid Subclass -->
<owl:Class rdf:about="#EnsembleHybrid">
    <rdfs:subClassOf rdf:resource="#HybridModel"/>
    <rdfs:comment>This class represents hybrid models that combine ensemble techniques with other models.</rdfs:comment>
</owl:Class>

<!-- Object Properties for EnsembleHybrid -->

<!-- Data Properties for EnsembleHybrid -->

<!-- Data Property: hasCombinationMethod for EnsembleHybrid -->
<owl:DatatypeProperty rdf:about="#hasCombinationMethod">
    <rdfs:domain rdf:resource="#EnsembleHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property describes the method used to combine the predictions of the base models in the ensemble hybrid model (e.g., voting, averaging).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasVotingStrategy -->
<owl:DatatypeProperty rdf:about="#hasVotingStrategy">
    <rdfs:domain rdf:resource="#EnsembleHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property defines the voting strategy (e.g., majority voting, weighted voting) used by the ensemble hybrid model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasEnsembleDiversity -->
<owl:DatatypeProperty rdf:about="#hasEnsembleDiversity">
    <rdfs:domain rdf:resource="#EnsembleHybrid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property measures the diversity of the base models in the ensemble hybrid, often important for improving robustness.</rdfs:comment>
</owl:DatatypeProperty>

<!-- EnsembleModel Subclass -->
<owl:Class rdf:about="#EnsembleModel">
    <rdfs:subClassOf rdf:resource="#Model"/>
    <rdfs:comment>This class represents models that combine multiple base models to improve performance and robustness.</rdfs:comment>
</owl:Class>

<!-- Object Properties for EnsembleModel -->

<!-- Property: usesBaseModels -->
<owl:ObjectProperty rdf:about="#usesBaseModels">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="#Model"/> <!-- Directly linking to Model -->
    <rdfs:comment>This property links the ensemble model to the individual base models it uses.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for EnsembleModel -->

<!-- Data Property: hasCombinationMethod for EnsembleModel -->
<owl:DatatypeProperty rdf:about="#hasCombinationMethod">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This data property describes the method used to combine the predictions of the base models in the ensemble model (e.g., voting, averaging).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasEnsembleDiversity -->
<owl:DatatypeProperty rdf:about="#hasEnsembleDiversity">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property measures the diversity of the base models in the ensemble, which is important for robustness.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasVotingStrategy -->
<owl:DatatypeProperty rdf:about="#hasVotingStrategy">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property defines the voting strategy (e.g., majority voting, weighted voting) used by the ensemble model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasBaggingFraction -->
<owl:DatatypeProperty rdf:about="#hasBaggingFraction">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the fraction of training data used for each base model in bagging methods.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasBoostingRate -->
<owl:DatatypeProperty rdf:about="#hasBoostingRate">
    <rdfs:domain rdf:resource="#EnsembleModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the rate at which the boosting method learns from misclassified instances.</rdfs:comment>
</owl:DatatypeProperty>
	
	<!-- BaggingModel Subclass -->
<owl:Class rdf:about="#BaggingModel">
    <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
    <rdfs:comment>This class represents bagging models, such as Random Forest, that train multiple models on random subsets of the data.</rdfs:comment>
</owl:Class>

<!-- Object Properties for BaggingModel -->

<!-- Property: usesRandomSubset -->
<owl:ObjectProperty rdf:about="#usesRandomSubset">
    <rdfs:domain rdf:resource="#BaggingModel"/>
    <rdfs:range rdf:resource="#Dataset"/>
    <rdfs:comment>This property links a bagging model to the random subsets of the data it uses for training base models.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for BaggingModel -->

<!-- Property: hasBaggingFraction -->
<owl:DatatypeProperty rdf:about="#hasBaggingFraction">
    <rdfs:domain rdf:resource="#BaggingModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the fraction of the training data used for each base model in the bagging model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- BoostingModel Subclass -->
<owl:Class rdf:about="#BoostingModel">
    <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
    <rdfs:comment>This class represents boosting models, such as XGBoost and AdaBoost, where models are trained sequentially to correct the errors of previous models.</rdfs:comment>
</owl:Class>

<!-- Refined Object Property: usesWeakLearners -->

<owl:ObjectProperty rdf:about="#usesWeakLearners">
    <rdfs:domain rdf:resource="#BoostingModel"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links a boosting model to the models used as weak learners for sequential training.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for BoostingModel -->

<!-- Property: hasBoostingRate -->
<owl:DatatypeProperty rdf:about="#hasBoostingRate">
    <rdfs:domain rdf:resource="#BoostingModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the learning rate for adjusting the weights of misclassified instances in the boosting model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- StackingModel Subclass -->
<owl:Class rdf:about="#StackingModel">
    <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
    <rdfs:comment>This class represents stacking models, where the predictions of multiple models are combined using a meta-model (also known as a meta-learner).</rdfs:comment>
</owl:Class>

<!-- Object Properties for StackingModel -->

<!-- Property: usesBaseModels -->
<owl:ObjectProperty rdf:about="#usesBaseModels">
    <rdfs:domain rdf:resource="#StackingModel"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the stacking model to the base models whose predictions are combined by the meta-model.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for StackingModel -->

<!-- Property: hasMetaModelDetails -->
<owl:DatatypeProperty rdf:about="#hasMetaModelDetails">
    <rdfs:domain rdf:resource="#StackingModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property provides further details about the meta-model (e.g., its specific configuration or hyperparameters).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasBaseModelCount -->
<owl:DatatypeProperty rdf:about="#hasBaseModelCount">
    <rdfs:domain rdf:resource="#StackingModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of base models used in the stacking model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasCrossValidationFolds -->
<owl:DatatypeProperty rdf:about="#hasCrossValidationFolds">
    <rdfs:domain rdf:resource="#StackingModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property defines the number of cross-validation folds used during the training of the stacking model.</rdfs:comment>
</owl:DatatypeProperty>

<!-- TransferLearningModel Subclass -->
<owl:Class rdf:about="#TransferLearningModel">
    <rdfs:subClassOf rdf:resource="#Model"/>
    <rdfs:comment>This class represents models that use transfer learning to adapt pre-trained models for new tasks.</rdfs:comment>
</owl:Class>

<!-- FineTunedModel Subclass -->
<owl:Class rdf:about="#FineTunedModel">
    <rdfs:subClassOf rdf:resource="#TransferLearningModel"/>
    <rdfs:comment>This class represents models that are fine-tuned on a specific task after being pre-trained on a different dataset or task.</rdfs:comment>
</owl:Class>

<!-- PreTrainedNeuralNetwork Subclass -->
<owl:Class rdf:about="#PreTrainedNeuralNetwork">
    <rdfs:subClassOf rdf:resource="#TransferLearningModel"/>
    <rdfs:comment>This class represents pre-trained neural networks that are fine-tuned for a new task.</rdfs:comment>
</owl:Class>

<!-- Property: usesBaseTask -->
<owl:ObjectProperty rdf:about="#usesBaseTask">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>This property links the transfer learning model to the original task or domain it was trained on before transfer learning.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: adaptedForNewTask -->
<owl:ObjectProperty rdf:about="#adaptedForNewTask">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>This property links the transfer learning model to the new task or domain it is fine-tuned or adapted for.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasPreTrainingAccuracy -->
<owl:DatatypeProperty rdf:about="#hasPreTrainingAccuracy">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the accuracy of the model on the original pre-training task or domain.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasFineTuningAccuracy -->
<owl:DatatypeProperty rdf:about="#hasFineTuningAccuracy">
    <rdfs:domain rdf:resource="#FineTunedModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the accuracy of the fine-tuned model on the new task or domain.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasPreTrainingDatasetSize -->
<owl:DatatypeProperty rdf:about="#hasPreTrainingDatasetSize">
    <rdfs:domain rdf:resource="#PreTrainedNeuralNetwork"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the size of the dataset used to pre-train the neural network.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasTransferLearningIterations -->
<owl:DatatypeProperty rdf:about="#hasTransferLearningIterations">
    <rdfs:domain rdf:resource="#TransferLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of iterations or epochs used for fine-tuning the model on the new task.</rdfs:comment>
</owl:DatatypeProperty>


<!-- Object Properties for QueryStrategy Class -->

<!-- Property: isPartOfALPipeline -->
<owl:ObjectProperty rdf:about="#isPartOfALPipeline">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>This property links the query strategy to the ALPipeline, indicating that the strategy is part of the pipeline process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: isUsedInScenario -->
<owl:ObjectProperty rdf:about="#isUsedInScenario">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>This property links a query strategy to specific Active Learning scenarios where it is applied.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatedByMetric -->
<owl:ObjectProperty rdf:about="#evaluatedByMetric">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:comment>This property links the query strategy to the evaluation metrics used to measure its effectiveness.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: collaboratesWithAnnotator -->
<owl:ObjectProperty rdf:about="#collaboratesWithAnnotator">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>This property links a query strategy to human annotators involved in the labeling process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: operatesWithinInfrastructure -->
<owl:ObjectProperty rdf:about="#operatesWithinInfrastructure">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:comment>This property links the query strategy to the system infrastructure it operates within, potentially impacting its real-time or resource-limited application.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsInstance -->
<owl:ObjectProperty rdf:about="#selectsInstance">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links a query strategy to the instances it selects for labeling in Active Learning.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: evaluatesUncertainty -->
<owl:ObjectProperty rdf:about="#evaluatesUncertainty">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the query strategy to the model for uncertainty evaluation, as in uncertainty-based strategies.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: usesCommittee -->
<owl:ObjectProperty rdf:about="#usesCommittee">
    <rdfs:domain rdf:resource="#QueryByCommittee"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links a query-by-committee strategy to the set of models (committee) used for selecting instances.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: reducesError -->
<owl:ObjectProperty rdf:about="#reducesError">
    <rdfs:domain rdf:resource="#ExpectedErrorReduction"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links an expected error reduction strategy to the model where error reduction is targeted.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties for QueryStrategy Class -->

<!-- Property: hasConfidenceThreshold -->
<owl:DatatypeProperty rdf:about="#hasConfidenceThreshold">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the confidence threshold used by the strategy for selecting uncertain instances.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasCommitteeDisagreement -->
<owl:DatatypeProperty rdf:about="#hasCommitteeDisagreement">
    <rdfs:domain rdf:resource="#QueryByCommittee"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the level of disagreement among committee members in query-by-committee strategies.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasExpectedErrorReduction -->
<owl:DatatypeProperty rdf:about="#hasExpectedErrorReduction">
    <rdfs:domain rdf:resource="#ExpectedErrorReduction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the expected reduction in error that the strategy aims to achieve with selected instances.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasUncertaintyMargin -->
<owl:DatatypeProperty rdf:about="#hasUncertaintyMargin">
    <rdfs:domain rdf:resource="#UncertaintySampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the margin between top class probabilities in margin sampling strategies.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasEntropy -->
<owl:DatatypeProperty rdf:about="#hasEntropy">
    <rdfs:domain rdf:resource="#UncertaintySampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the entropy of the model’s predictions in entropy-based sampling strategies.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasUncertaintyMargin for MarginSampling -->
<owl:DatatypeProperty rdf:about="#hasUncertaintyMargin">
    <rdfs:domain rdf:resource="#MarginSampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the uncertainty margin between the top two class probabilities used in margin sampling.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasEntropy for EntropySampling -->
<owl:DatatypeProperty rdf:about="#hasEntropy">
    <rdfs:domain rdf:resource="#EntropySampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the entropy score used for selecting instances in entropy-based sampling.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasCommitteeDisagreement for VoteEntropy -->
<owl:DatatypeProperty rdf:about="#hasCommitteeDisagreement">
    <rdfs:domain rdf:resource="#VoteEntropy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the level of disagreement among committee models in vote entropy.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasKLScore for KLDivergence -->
<owl:DatatypeProperty rdf:about="#hasKLScore">
    <rdfs:domain rdf:resource="#KLDivergence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the KL-divergence score used in query-by-committee strategies to measure disagreement.</rdfs:comment>
</owl:DatatypeProperty>
	
	<!-- Property: selectsLowConfidenceInstance -->
<owl:ObjectProperty rdf:about="#selectsLowConfidenceInstance">
    <rdfs:domain rdf:resource="#LeastConfidenceSampling"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links least confidence sampling to instances where the model has the lowest prediction confidence.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsSmallMarginInstance -->
<owl:ObjectProperty rdf:about="#selectsSmallMarginInstance">
    <rdfs:domain rdf:resource="#MarginSampling"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links margin sampling to instances with the smallest margin between the top two predicted class probabilities.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighEntropyInstance -->
<owl:ObjectProperty rdf:about="#selectsHighEntropyInstance">
    <rdfs:domain rdf:resource="#EntropySampling"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links entropy sampling to instances with the highest prediction entropy.</rdfs:comment>
	</owl:ObjectProperty>
	
	<!-- Property: selectsHighVoteEntropyInstance -->
<owl:ObjectProperty rdf:about="#selectsHighVoteEntropyInstance">
    <rdfs:domain rdf:resource="#VoteEntropy"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links vote entropy-based sampling to instances where committee members' votes are highly divergent.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighKLDivergenceInstance -->
<owl:ObjectProperty rdf:about="#selectsHighKLDivergenceInstance">
    <rdfs:domain rdf:resource="#KLDivergence"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links KL-divergence-based sampling to instances where the KL-divergence between committee members is high.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighGradientMagnitudeInstance -->
<owl:ObjectProperty rdf:about="#selectsHighGradientMagnitudeInstance">
    <rdfs:domain rdf:resource="#GradientMagnitude"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links gradient magnitude-based sampling to instances expected to cause the largest gradient changes.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighFisherInformationInstance -->
<owl:ObjectProperty rdf:about="#selectsHighFisherInformationInstance">
    <rdfs:domain rdf:resource="#FisherInformation"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links Fisher Information-based sampling to instances that have high Fisher Information.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighInfluenceInstance -->
<owl:ObjectProperty rdf:about="#selectsHighInfluenceInstance">
    <rdfs:domain rdf:resource="#InfluenceFunction"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links influence function-based sampling to instances expected to have the most influence on model parameters.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsRiskReducingInstance -->
<owl:ObjectProperty rdf:about="#selectsRiskReducingInstance">
    <rdfs:domain rdf:resource="#RiskReduction"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links risk-reduction-based sampling to instances expected to reduce future prediction risk.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsVarianceReducingInstance -->
<owl:ObjectProperty rdf:about="#selectsVarianceReducingInstance">
    <rdfs:domain rdf:resource="#VarianceReduction"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links variance reduction-based sampling to instances that reduce prediction variance.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsPosteriorRiskReducingInstance -->
<owl:ObjectProperty rdf:about="#selectsPosteriorRiskReducingInstance">
    <rdfs:domain rdf:resource="#PosteriorRiskReduction"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links posterior risk reduction strategies to instances that reduce posterior risk in a Bayesian model.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsHighUncertaintyDensityInstance -->
<owl:ObjectProperty rdf:about="#selectsHighUncertaintyDensityInstance">
    <rdfs:domain rdf:resource="#UncertaintyDensity"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links uncertainty-density sampling to instances that balance uncertainty and density.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: selectsClusterCentroidInstance -->
<owl:ObjectProperty rdf:about="#selectsClusterCentroidInstance">
    <rdfs:domain rdf:resource="#ClusterCentroidSampling"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links cluster centroid-based sampling to instances closest to the cluster centroids in the dataset.</rdfs:comment>
</owl:ObjectProperty>

