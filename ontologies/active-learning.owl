    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>Represents the overall performance score of the task, measured by appropriate evaluation metrics.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Object Properties for ClassificationTask -->--
<owl:ObjectProperty rdf:about="#hasModel">
