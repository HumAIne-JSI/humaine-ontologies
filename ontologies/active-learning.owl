</owl:ObjectProperty>

<!-- Property: hasClusteringModel -->
<owl:ObjectProperty rdf:about="#hasClusteringModel">
    <rdfs:domain rdf:resource="#ClusteringTask"/>
    <rdfs:range rdf:resource="#ClusteringModel"/>
    <rdfs:comment>Links a clustering task to the specific clustering model used.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasClassificationModel -->
<owl:ObjectProperty rdf:about="#hasClassificationModel">
    <rdfs:domain rdf:resource="#ClassificationTask"/>
    <rdfs:range rdf:resource="#ClassificationModel"/>
    <rdfs:comment>Links a classification task to the specific classification model used.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#canUseEnsembleModel">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="#EnsembleModel"/>
