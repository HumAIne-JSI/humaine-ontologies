    <rdfs:comment>Represents the type of task being performed (e.g., classification, clustering, regression).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFeatureCount">
    <rdfs:domain rdf:resource="#ALTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
