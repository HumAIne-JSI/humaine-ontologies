<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns="http://www.example.org/activelearningontology#">
 	    
		<rdf:Description rdf:nodeID="genid1">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	<rdfs:comment>A formal ontology representing generic concepts and processes in Active Learning systems for HumAIne project. V.01</rdfs:comment>
</rdf:Description>
		
		<!-- ActiveLearning Top Class -->
    <owl:Class rdf:about="#ActiveLearning">
        <rdfs:comment>This class represents the overarching concept of Active Learning, under which all key components fall.</rdfs:comment>
    </owl:Class>
		  <!-- Main Classes -->
      <!-- ALPipeline Class as Subclass of ActiveLearning -->
    <owl:Class rdf:about="#ALPipeline">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents the entire Active Learning pipeline, which includes core steps such as data collection, model training, annotation, and feedback.</rdfs:comment>
    </owl:Class>
    <!-- Data Collection Step as Subclass -->
    <owl:Class rdf:about="#DataCollection">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the process of collecting data for the Active Learning pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Data Collection -->
    <owl:Class rdf:about="#ManualDataCollection">
        <rdfs:subClassOf rdf:resource="#DataCollection"/>
        <rdfs:comment>Represents manual methods of collecting data for the Active Learning process.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#WebScrapingDataCollection">
        <rdfs:subClassOf rdf:resource="#DataCollection"/>
        <rdfs:comment>Represents data collection through web scraping.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#SensorDataCollection">
        <rdfs:subClassOf rdf:resource="#DataCollection"/>
        <rdfs:comment>Represents data collection through sensors in IoT scenarios.</rdfs:comment>
    </owl:Class>
    <!-- Model Training Step as Subclass -->
    <owl:Class rdf:about="#ModelTraining">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the process of training machine learning models in the pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Model Training -->
    <owl:Class rdf:about="#InitialTraining">
        <rdfs:subClassOf rdf:resource="#ModelTraining"/>
        <rdfs:comment>Represents the initial model training process.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#IncrementalTraining">
        <rdfs:subClassOf rdf:resource="#ModelTraining"/>
        <rdfs:comment>Represents incremental model training where the model is retrained with new data over time.</rdfs:comment>
    </owl:Class>
    <!-- Annotation Step as Subclass -->
    <owl:Class rdf:about="#Annotation">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the process of labeling instances in the pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Annotation -->
    <owl:Class rdf:about="#ManualAnnotation">
        <rdfs:subClassOf rdf:resource="#Annotation"/>
        <rdfs:comment>Represents manual annotation by human annotators.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#AutomatedPreAnnotation">
        <rdfs:subClassOf rdf:resource="#Annotation"/>
        <rdfs:comment>Represents pre-annotation using automated tools, followed by human review.</rdfs:comment>
    </owl:Class>
    <!-- Model Update Step as Subclass -->
    <owl:Class rdf:about="#ModelUpdate">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the process of updating machine learning models with new labeled data.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Model Update -->
    <owl:Class rdf:about="#Retraining">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents retraining the model using newly labeled instances.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#FineTuning">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents fine-tuning the model based on new labeled data.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#IncrementalLearning">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents incremental learning where the model is continuously updated with new data over time.</rdfs:comment>
    </owl:Class>
    <!-- Feedback Loop as Subclass -->
    <owl:Class rdf:about="#FeedbackLoop">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the feedback loop in the Active Learning pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Feedback Loop -->
    <owl:Class rdf:about="#ModelPerformanceFeedback">
        <rdfs:subClassOf rdf:resource="#FeedbackLoop"/>
        <rdfs:comment>This class represents feedback based on the model's performance during real-world deployment.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#UserFeedback">
        <rdfs:subClassOf rdf:resource="#FeedbackLoop"/>
        <rdfs:comment>This class represents feedback provided by users or human annotators, helping improve the learning process.</rdfs:comment>
    </owl:Class> 	
	    <!-- UserFeedback -->
    <owl:Class rdf:about="#UserFeedback">
        <rdfs:subClassOf rdf:resource="#FeedbackLoop"/>
        <rdfs:comment>This class represents feedback from human annotators or end users, influencing the next steps in the pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Model Update Step as Subclass -->
    <owl:Class rdf:about="#ModelUpdate">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the process of updating machine learning models with new labeled data.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Model Update -->
    <owl:Class rdf:about="#Retraining">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents retraining the model using newly labeled instances.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#FineTuning">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents fine-tuning the model based on new labeled data.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#IncrementalLearning">
        <rdfs:subClassOf rdf:resource="#ModelUpdate"/>
        <rdfs:comment>Represents incremental learning where the model is continuously updated with new data over time.</rdfs:comment>
    </owl:Class>
    <!-- Feedback Loop as Subclass -->
    <owl:Class rdf:about="#FeedbackLoop">
        <rdfs:subClassOf rdf:resource="#ALPipeline"/>
        <rdfs:comment>This class represents the feedback loop in the Active Learning pipeline.</rdfs:comment>
    </owl:Class>
    <!-- Subclasses for Feedback Loop -->
    <owl:Class rdf:about="#ModelPerformanceFeedback">
        <rdfs:subClassOf rdf:resource="#FeedbackLoop"/>
        <rdfs:comment>This class represents feedback based on the model's performance during real-world deployment.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#UserFeedback">
        <rdfs:subClassOf rdf:resource="#FeedbackLoop"/>
        <rdfs:comment>This class represents feedback provided by users or human annotators, helping improve the learning process.</rdfs:comment>
    </owl:Class>
 <!-- ALScenario as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#ALScenario">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents different scenarios of Active Learning, defining how instances are selected for labeling.</rdfs:comment>
    </owl:Class>
    <!-- Pool-Based Scenario -->
    <owl:Class rdf:about="#PoolBasedScenario">
        <rdfs:subClassOf rdf:resource="#ALScenario"/>
        <rdfs:comment>Represents a pool-based Active Learning scenario where a large pool of unlabeled data is used for instance selection.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#FixedPoolScenario">
        <rdfs:subClassOf rdf:resource="#PoolBasedScenario"/>
        <rdfs:comment>Represents a pool-based scenario where the pool of unlabeled data remains fixed throughout the process.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#DynamicPoolScenario">
        <rdfs:subClassOf rdf:resource="#PoolBasedScenario"/>
        <rdfs:comment>Represents a pool-based scenario where the pool of unlabeled data changes dynamically during the process.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#BatchSelectionScenario">
        <rdfs:subClassOf rdf:resource="#PoolBasedScenario"/>
        <rdfs:comment>Represents a pool-based scenario where instances are selected in batches for labeling, increasing efficiency.</rdfs:comment>
    </owl:Class>
    <!-- Stream-Based Scenario -->
    <owl:Class rdf:about="#StreamBasedScenario">
        <rdfs:subClassOf rdf:resource="#ALScenario"/>
        <rdfs:comment>Represents a stream-based Active Learning scenario where data arrives continuously and the system must decide whether to label or discard each instance.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#OnlineLearningScenario">
        <rdfs:subClassOf rdf:resource="#StreamBasedScenario"/>
        <rdfs:comment>Represents a stream-based scenario where the model is updated incrementally as new data arrives.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#PeriodicUpdateScenario">
        <rdfs:subClassOf rdf:resource="#StreamBasedScenario"/>
        <rdfs:comment>Represents a stream-based scenario where the model is updated periodically with a batch of newly labeled instances.</rdfs:comment>
    </owl:Class>
    <!-- Query Synthesis Scenario -->
    <owl:Class rdf:about="#QuerySynthesisScenario">
        <rdfs:subClassOf rdf:resource="#ALScenario"/>
        <rdfs:comment>Represents a query synthesis scenario where synthetic instances are generated by the system for labeling.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#AdversarialQueryScenario">
        <rdfs:subClassOf rdf:resource="#QuerySynthesisScenario"/>
        <rdfs:comment>Represents a query synthesis scenario where synthetic instances are generated to challenge the model’s decision boundaries.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#UncertaintyBasedQueryScenario">
        <rdfs:subClassOf rdf:resource="#QuerySynthesisScenario"/>
        <rdfs:comment>Represents a query synthesis scenario where synthetic instances are generated in areas where the model is least confident.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#DomainExpansionScenario">
        <rdfs:subClassOf rdf:resource="#QuerySynthesisScenario"/>
        <rdfs:comment>Represents a query synthesis scenario where synthetic instances are generated to expand the model's knowledge of the data space.</rdfs:comment>
    </owl:Class>
	    <!-- ALTask Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#ALTask">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents the task performed within Active Learning, such as classification, clustering, or regression.</rdfs:comment>
    </owl:Class>
    <!-- Classification Task -->
    <owl:Class rdf:about="#ClassificationTask">
        <rdfs:subClassOf rdf:resource="#ALTask"/>
        <rdfs:comment>This class represents classification tasks in Active Learning.</rdfs:comment>
    </owl:Class>
 <owl:Class rdf:about="#BinaryClassificationTask">
    <rdfs:subClassOf rdf:resource="#ClassificationTask"/>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasClassCount"/>
            <owl:allValuesFrom>
                <rdfs:Datatype>
                    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                    <owl:withRestrictions rdf:parseType="Collection">
                        <rdf:Description>
                            <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</xsd:minInclusive>
                            <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</xsd:maxInclusive>
                        </rdf:Description>
                    </owl:withRestrictions>
                </rdfs:Datatype>
            </owl:allValuesFrom>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This class represents binary classification tasks, where there are exactly two classes.</rdfs:comment>
</owl:Class>
	<owl:Class rdf:about="#MultiClassClassificationTask">
    <rdfs:subClassOf rdf:resource="#ClassificationTask"/>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#hasClassCount"/>
            <owl:allValuesFrom>
                <rdfs:Datatype>
                    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                    <owl:withRestrictions rdf:parseType="Collection">
                        <rdf:Description>
                            <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</xsd:minInclusive>
                        </rdf:Description>
                    </owl:withRestrictions>
                </rdfs:Datatype>
            </owl:allValuesFrom>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This class represents multi-class classification tasks, where there are three or more classes.</rdfs:comment>
</owl:Class>
	

    <owl:Class rdf:about="#MultiLabelClassificationTask">
        <rdfs:subClassOf rdf:resource="#ClassificationTask"/>
        <rdfs:comment>This class represents multilabel classification tasks, where instances can belong to multiple classes simultaneously.</rdfs:comment>
    </owl:Class>
    <!-- Clustering Task -->
    <owl:Class rdf:about="#ClusteringTask">
        <rdfs:subClassOf rdf:resource="#ALTask"/>
        <rdfs:comment>This class represents clustering tasks in Active Learning.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#HardClusteringTask">
        <rdfs:subClassOf rdf:resource="#ClusteringTask"/>
        <rdfs:comment>This class represents hard clustering tasks, where each instance belongs to exactly one cluster.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#SoftClusteringTask">
        <rdfs:subClassOf rdf:resource="#ClusteringTask"/>
        <rdfs:comment>This class represents soft clustering tasks, where instances can belong to multiple clusters with varying degrees of membership.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#HierarchicalClusteringTask">
        <rdfs:subClassOf rdf:resource="#ClusteringTask"/>
        <rdfs:comment>This class represents hierarchical clustering tasks, where clusters are arranged in a hierarchy.</rdfs:comment>
    </owl:Class>

    <!-- Regression Task -->
    <owl:Class rdf:about="#RegressionTask">
        <rdfs:subClassOf rdf:resource="#ALTask"/>
        <rdfs:comment>This class represents regression tasks in Active Learning.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SimpleRegressionTask">
        <rdfs:subClassOf rdf:resource="#RegressionTask"/>
        <rdfs:comment>This class represents simple regression tasks, predicting a single continuous value.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MultiOutputRegressionTask">
        <rdfs:subClassOf rdf:resource="#RegressionTask"/>
        <rdfs:comment>This class represents multi-output regression tasks, predicting multiple continuous values simultaneously.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RobustRegressionTask">
        <rdfs:subClassOf rdf:resource="#RegressionTask"/>
        <rdfs:comment>This class represents robust regression tasks, designed to handle outliers effectively.</rdfs:comment>
    </owl:Class>

    <!-- QueryStrategy Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#QueryStrategy">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents different strategies used for selecting the most informative instances in Active Learning.</rdfs:comment>
    </owl:Class>

    <!-- UncertaintySampling -->
    <owl:Class rdf:about="#UncertaintySampling">
        <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
        <rdfs:comment>This class represents strategies that select instances based on uncertainty in model predictions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LeastConfidenceSampling">
        <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
        <rdfs:comment>This class represents least confidence sampling, selecting instances where the model has the lowest confidence.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MarginSampling">
        <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
        <rdfs:comment>This class represents margin sampling, selecting instances with the smallest margin between the top two class probabilities.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#EntropySampling">
        <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
        <rdfs:comment>This class represents entropy-based sampling, selecting instances with the highest prediction entropy.</rdfs:comment>
    </owl:Class>

    <!-- QueryByCommittee -->
    <owl:Class rdf:about="#QueryByCommittee">
        <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
        <rdfs:comment>This class represents query by committee strategies, where multiple models vote on the most informative instances.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VoteEntropy">
        <rdfs:subClassOf rdf:resource="#QueryByCommittee"/>
        <rdfs:comment>This class represents vote entropy, where instances are selected based on disagreement among committee members.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#KLDivergence">
        <rdfs:subClassOf rdf:resource="#QueryByCommittee"/>
        <rdfs:comment>This class represents KL-divergence-based strategies for selecting instances based on committee disagreement.</rdfs:comment>
    </owl:Class>

    <!-- ExpectedModelChange -->
    <owl:Class rdf:about="#ExpectedModelChange">
        <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
        <rdfs:comment>This class represents strategies that select instances expected to cause the largest change in model parameters.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GradientMagnitude">
        <rdfs:subClassOf rdf:resource="#ExpectedModelChange"/>
        <rdfs:comment>This class represents gradient magnitude-based selection, where instances are chosen based on their expected impact on model gradients.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FisherInformation">
        <rdfs:subClassOf rdf:resource="#ExpectedModelChange"/>
        <rdfs:comment>This class represents strategies that select instances based on Fisher Information, measuring the sensitivity of the model parameters.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InfluenceFunction">
        <rdfs:subClassOf rdf:resource="#ExpectedModelChange"/>
        <rdfs:comment>This class represents influence function-based selection, where instances are chosen based on their influence on model parameters.</rdfs:comment>
    </owl:Class>

    <!-- ExpectedErrorReduction -->
    <owl:Class rdf:about="#ExpectedErrorReduction">
        <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
        <rdfs:comment>This class represents strategies that select instances expected to reduce the model's prediction error the most.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RiskReduction">
        <rdfs:subClassOf rdf:resource="#ExpectedErrorReduction"/>
        <rdfs:comment>This class represents risk reduction-based selection, focusing on minimizing future prediction risks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VarianceReduction">
        <rdfs:subClassOf rdf:resource="#ExpectedErrorReduction"/>
        <rdfs:comment>This class represents variance reduction-based selection, focusing on reducing prediction variance for the model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PosteriorRiskReduction">
        <rdfs:subClassOf rdf:resource="#ExpectedErrorReduction"/>
        <rdfs:comment>This class represents posterior risk reduction strategies, selecting instances that reduce posterior risk in a Bayesian model.</rdfs:comment>
    </owl:Class>

    <!-- DensityWeightedSampling -->
    <owl:Class rdf:about="#DensityWeightedSampling">
        <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
        <rdfs:comment>This class represents strategies that balance uncertainty with data density when selecting instances.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#UncertaintyDensity">
        <rdfs:subClassOf rdf:resource="#DensityWeightedSampling"/>
        <rdfs:comment>This class represents uncertainty-density sampling, balancing uncertainty and representativeness of instances.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ClusterCentroidSampling">
        <rdfs:subClassOf rdf:resource="#DensityWeightedSampling"/>
        <rdfs:comment>This class represents cluster centroid sampling, selecting instances closest to cluster centroids in a dataset.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DiverseDensitySampling">
        <rdfs:subClassOf rdf:resource="#DensityWeightedSampling"/>
        <rdfs:comment>This class represents diverse density sampling, focusing on selecting diverse and representative instances in dense regions of the data.</rdfs:comment>
    </owl:Class>
		
    <!-- Data Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#Data">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents the data used in Active Learning, including datasets and instances.</rdfs:comment>
    </owl:Class>

    <!-- Dataset Class -->
    <owl:Class rdf:about="#Dataset">
        <rdfs:subClassOf rdf:resource="#Data"/>
        <rdfs:comment>This class represents datasets used for training, labeling, or testing in an Active Learning pipeline.</rdfs:comment>
    </owl:Class>

    <!-- LabeledDataset -->
    <owl:Class rdf:about="#LabeledDataset">
        <rdfs:subClassOf rdf:resource="#Dataset"/>
        <rdfs:comment>This class represents a dataset where each instance is associated with a label.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FullyLabeledDataset">
        <rdfs:subClassOf rdf:resource="#LabeledDataset"/>
        <rdfs:comment>This class represents a fully labeled dataset where all instances have labels.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PartiallyLabeledDataset">
        <rdfs:subClassOf rdf:resource="#LabeledDataset"/>
        <rdfs:comment>This class represents a partially labeled dataset where only some instances have labels.</rdfs:comment>
    </owl:Class>

    <!-- UnlabeledDataset -->
    <owl:Class rdf:about="#UnlabeledDataset">
        <rdfs:subClassOf rdf:resource="#Dataset"/>
        <rdfs:comment>This class represents a dataset where instances do not have labels and are candidates for labeling.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PoolDataset">
        <rdfs:subClassOf rdf:resource="#UnlabeledDataset"/>
        <rdfs:comment>This class represents a static pool of unlabeled instances, used in pool-based scenarios.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#StreamDataset">
        <rdfs:subClassOf rdf:resource="#UnlabeledDataset"/>
        <rdfs:comment>This class represents a dynamic stream of unlabeled instances, used in stream-based scenarios.</rdfs:comment>
    </owl:Class>

    <!-- Optional: MetadataEnhancedDataset -->
    <owl:Class rdf:about="#MetadataEnhancedDataset">
        <rdfs:subClassOf rdf:resource="#Dataset"/>
        <rdfs:comment>This optional class represents datasets where instances are enhanced with metadata (e.g., timestamps, quality scores).</rdfs:comment>
    </owl:Class>

    <!-- Instance Class -->
    <owl:Class rdf:about="#Instance">
        <rdfs:subClassOf rdf:resource="#Data"/>
        <rdfs:comment>This class represents an individual data point within a dataset, either labeled or unlabeled.</rdfs:comment>
    </owl:Class>

    <!-- LabeledInstance -->
    <owl:Class rdf:about="#LabeledInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This class represents an instance that has been assigned a label by a human annotator.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PreLabeledInstance">
        <rdfs:subClassOf rdf:resource="#LabeledInstance"/>
        <rdfs:comment>This class represents instances that were labeled prior to the start of the Active Learning process.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FullyLabeledInstance">
        <rdfs:subClassOf rdf:resource="#LabeledInstance"/>
        <rdfs:comment>This class represents fully labeled instances with definitive labels.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AmbiguousLabeledInstance">
        <rdfs:subClassOf rdf:resource="#LabeledInstance"/>
        <rdfs:comment>This class represents instances with conflicting or uncertain labels, which may need further review.</rdfs:comment>
    </owl:Class>

    <!-- UnlabeledInstance -->
    <owl:Class rdf:about="#UnlabeledInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This class represents an instance that has not yet been assigned a label and is a candidate for labeling.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#QueriedInstance">
        <rdfs:subClassOf rdf:resource="#UnlabeledInstance"/>
        <rdfs:comment>This class represents an instance that has been selected by the Active Learning system for labeling.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RejectedInstance">
        <rdfs:subClassOf rdf:resource="#UnlabeledInstance"/>
        <rdfs:comment>This class represents an instance that was reviewed by the model but not selected for labeling.</rdfs:comment>
    </owl:Class>

    <!-- Optional: MetadataEnhancedInstance -->
    <owl:Class rdf:about="#MetadataEnhancedInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This optional class represents instances that are enhanced with metadata such as timestamps or confidence scores.</rdfs:comment>
    </owl:Class>

    <!-- SyntheticInstance -->
    <owl:Class rdf:about="#SyntheticInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This class represents an instance generated artificially by the system during query synthesis.</rdfs:comment>
    </owl:Class>

    <!-- OutlierInstance -->
    <owl:Class rdf:about="#OutlierInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This class represents an instance that deviates significantly from the majority of the data.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#HighUncertaintyOutlier">
        <rdfs:subClassOf rdf:resource="#OutlierInstance"/>
        <rdfs:comment>This class represents an outlier instance with high uncertainty in predictions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LowUncertaintyOutlier">
        <rdfs:subClassOf rdf:resource="#OutlierInstance"/>
        <rdfs:comment>This class represents an outlier instance with low uncertainty but significant deviation from the data distribution.</rdfs:comment>
    </owl:Class>

    <!-- Optional: AugmentedInstance -->
    <owl:Class rdf:about="#AugmentedInstance">
        <rdfs:subClassOf rdf:resource="#Instance"/>
        <rdfs:comment>This optional class represents an instance that has been artificially modified through data augmentation techniques.</rdfs:comment>
    </owl:Class>
	
	<!-- HumanAnnotator Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#HumanAnnotator">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents human annotators responsible for labeling instances in the Active Learning process.</rdfs:comment>
    </owl:Class>

    <!-- ExpertAnnotator -->
    <owl:Class rdf:about="#ExpertAnnotator">
        <rdfs:subClassOf rdf:resource="#HumanAnnotator"/>
        <rdfs:comment>This class represents expert annotators who are highly skilled and experienced in labeling tasks.</rdfs:comment>
    </owl:Class>

    <!-- NoviceAnnotator -->
    <owl:Class rdf:about="#NoviceAnnotator">
        <rdfs:subClassOf rdf:resource="#HumanAnnotator"/>
        <rdfs:comment>This class represents novice annotators who have limited experience in labeling tasks.</rdfs:comment>
    </owl:Class>

    <!-- CrowdsourcedAnnotator -->
    <owl:Class rdf:about="#CrowdsourcedAnnotator">
        <rdfs:subClassOf rdf:resource="#HumanAnnotator"/>
        <rdfs:comment>This class represents annotators from a crowdsourcing platform, typically used for large-scale labeling tasks.</rdfs:comment>
    </owl:Class>

    <!-- AssistedAnnotator -->
    <owl:Class rdf:about="#AssistedAnnotator">
        <rdfs:subClassOf rdf:resource="#HumanAnnotator"/>
        <rdfs:comment>This class represents human annotators who work in conjunction with automated tools to label instances.</rdfs:comment>
    </owl:Class>
	
	    <!-- Model Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#Model">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents machine learning models used in the Active Learning process.</rdfs:comment>
    </owl:Class>

    <!-- ClassificationModel -->
    <owl:Class rdf:about="#ClassificationModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents models used for classification tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BinaryClassificationModel">
        <rdfs:subClassOf rdf:resource="#ClassificationModel"/>
        <rdfs:comment>This class represents models used for binary classification tasks.</rdfs:comment>
    </owl:Class>
	
  <owl:Class rdf:about="#SupportVectorMachine">
        <rdfs:subClassOf rdf:resource="#BinaryClassificationModel"/>
        <rdfs:comment>This class represents a Support Vector Machine used for binary classification.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LogisticRegression">
        <rdfs:subClassOf rdf:resource="#BinaryClassificationModel"/>
        <rdfs:comment>This class represents a Logistic Regression model used for binary classification.</rdfs:comment>
    </owl:Class> 

    <owl:Class rdf:about="#MultiClassClassificationModel">
        <rdfs:subClassOf rdf:resource="#ClassificationModel"/>
        <rdfs:comment>This class represents models used for multi-class classification tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RandomForest">
        <rdfs:subClassOf rdf:resource="#MultiClassClassificationModel"/>
        <rdfs:comment>This class represents a Random Forest model used for multi-class classification.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#NeuralNetworkClassifier">
        <rdfs:subClassOf rdf:resource="#MultiClassClassificationModel"/>
        <rdfs:comment>This class represents a Neural Network classifier used for multi-class classification tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MultiLabelClassificationModel">
        <rdfs:subClassOf rdf:resource="#ClassificationModel"/>
        <rdfs:comment>This class represents models used for multi-label classification tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#kNearestNeighbors">
        <rdfs:subClassOf rdf:resource="#MultiLabelClassificationModel"/>
        <rdfs:comment>This class represents a k-Nearest Neighbors model used for multi-label classification tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#NeuralNetworkMultiLabel">
        <rdfs:subClassOf rdf:resource="#MultiLabelClassificationModel"/>
        <rdfs:comment>This class represents a Neural Network model used for multi-label classification tasks.</rdfs:comment>
    </owl:Class>

    <!-- ClusteringModel -->
    <owl:Class rdf:about="#ClusteringModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents models used for clustering tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#HardClusteringModel">
        <rdfs:subClassOf rdf:resource="#ClusteringModel"/>
        <rdfs:comment>This class represents hard clustering models where each instance belongs to exactly one cluster.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#KMeans">
        <rdfs:subClassOf rdf:resource="#HardClusteringModel"/>
        <rdfs:comment>This class represents a K-Means model used for hard clustering tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DBSCAN">
        <rdfs:subClassOf rdf:resource="#HardClusteringModel"/>
        <rdfs:comment>This class represents a DBSCAN model used for density-based clustering tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SoftClusteringModel">
        <rdfs:subClassOf rdf:resource="#ClusteringModel"/>
        <rdfs:comment>This class represents soft clustering models where instances can belong to multiple clusters.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GaussianMixtureModel">
        <rdfs:subClassOf rdf:resource="#SoftClusteringModel"/>
        <rdfs:comment>This class represents a Gaussian Mixture Model used for soft clustering tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FuzzyCMeans">
        <rdfs:subClassOf rdf:resource="#SoftClusteringModel"/>
        <rdfs:comment>This class represents a Fuzzy C-Means model used for soft clustering tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#HierarchicalClusteringModel">
        <rdfs:subClassOf rdf:resource="#ClusteringModel"/>
        <rdfs:comment>This class represents hierarchical clustering models where clusters are arranged in a hierarchy.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AgglomerativeClustering">
        <rdfs:subClassOf rdf:resource="#HierarchicalClusteringModel"/>
        <rdfs:comment>This class represents an agglomerative clustering model, where clusters are recursively merged.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DivisiveClustering">
        <rdfs:subClassOf rdf:resource="#HierarchicalClusteringModel"/>
        <rdfs:comment>This class represents a divisive clustering model, where clusters are recursively split.</rdfs:comment>
    </owl:Class>

    <!-- RegressionModel -->
    <owl:Class rdf:about="#RegressionModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents models used for regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SimpleRegressionModel">
        <rdfs:subClassOf rdf:resource="#RegressionModel"/>
        <rdfs:comment>This class represents models used for simple regression tasks, predicting a single continuous output.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LinearRegression">
        <rdfs:subClassOf rdf:resource="#SimpleRegressionModel"/>
        <rdfs:comment>This class represents a Linear Regression model used for simple regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DecisionTreeRegression">
        <rdfs:subClassOf rdf:resource="#SimpleRegressionModel"/>
        <rdfs:comment>This class represents a Decision Tree Regression model used for simple regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MultiOutputRegressionModel">
        <rdfs:subClassOf rdf:resource="#RegressionModel"/>
        <rdfs:comment>This class represents models used for multi-output regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MultiOutputLinearRegression">
        <rdfs:subClassOf rdf:resource="#MultiOutputRegressionModel"/>
        <rdfs:comment>This class represents a Multi-Output Linear Regression model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MultiTaskNeuralNetwork">
        <rdfs:subClassOf rdf:resource="#MultiOutputRegressionModel"/>
        <rdfs:comment>This class represents a Multi-Task Neural Network model used for multi-output regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RobustRegressionModel">
        <rdfs:subClassOf rdf:resource="#RegressionModel"/>
        <rdfs:comment>This class represents models designed to be robust against outliers in regression tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RANSACRegression">
        <rdfs:subClassOf rdf:resource="#RobustRegressionModel"/>
        <rdfs:comment>This class represents a RANSAC Regression model designed to handle outliers.</rdfs:comment>
    </owl:Class>

 <!-- HuberRegression -->
    <owl:Class rdf:about="#HuberRegression">
        <rdfs:subClassOf rdf:resource="#RobustRegressionModel"/>
        <rdfs:comment>This class represents a Huber Regression model that is robust to outliers, combining the strengths of linear regression and robust regression.</rdfs:comment>
    </owl:Class>

    <!-- EnsembleModel -->
    <owl:Class rdf:about="#EnsembleModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents ensemble models that combine multiple base models to improve performance and robustness.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BaggingModel">
        <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
        <rdfs:comment>This class represents bagging models, such as RandomForest, that are based on training multiple models on random subsets of the data.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BoostingModel">
        <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
        <rdfs:comment>This class represents boosting models, such as XGBoost and AdaBoost, where models are trained sequentially to correct the errors of previous models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#StackingModel">
        <rdfs:subClassOf rdf:resource="#EnsembleModel"/>
        <rdfs:comment>This class represents stacking models, where the predictions of multiple models are combined using a meta-model.</rdfs:comment>
    </owl:Class>

    <!-- HybridModel -->
    <owl:Class rdf:about="#HybridModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents hybrid models that combine different types of models to leverage their strengths.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DeepLearningHybrid">
        <rdfs:subClassOf rdf:resource="#HybridModel"/>
        <rdfs:comment>This class represents hybrid models that combine deep learning models with other types of models (e.g., decision trees or probabilistic models).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ProbabilisticHybrid">
        <rdfs:subClassOf rdf:resource="#HybridModel"/>
        <rdfs:comment>This class represents hybrid models that combine probabilistic models (e.g., Bayesian networks) with other learning models.</rdfs:comment>
    </owl:Class>

    <!-- TransferLearningModel -->
    <owl:Class rdf:about="#TransferLearningModel">
        <rdfs:subClassOf rdf:resource="#Model"/>
        <rdfs:comment>This class represents models that use transfer learning to adapt pre-trained models for new tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PreTrainedNeuralNetwork">
        <rdfs:subClassOf rdf:resource="#TransferLearningModel"/>
        <rdfs:comment>This class represents pre-trained neural networks that are fine-tuned for a new task.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FineTunedModel">
        <rdfs:subClassOf rdf:resource="#TransferLearningModel"/>
        <rdfs:comment>This class represents models that are fine-tuned on a specific task after being pre-trained on a different dataset or task.</rdfs:comment>
    </owl:Class>
	
 <!-- EvaluationMetrics Class as a Subclass of ActiveLearning -->
	  
   <owl:Class rdf:about="#EvaluationMetrics">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents the metrics used to evaluate model performance in Active Learning tasks.</rdfs:comment>
    </owl:Class>

    <!-- Task-Specific Metrics -->

    <!-- ClassificationMetrics -->
    <owl:Class rdf:about="#ClassificationMetrics">
        <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
        <rdfs:comment>This class represents the metrics used to evaluate classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Accuracy">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the accuracy metric for classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Precision">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the precision metric for classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Recall">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the recall metric for classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#F1Score">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the F1 Score metric for classification models, which is the harmonic mean of precision and recall.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AUC_ROC">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the Area Under the ROC Curve (AUC-ROC) metric for classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LogLoss">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the Logarithmic Loss (LogLoss) metric for probabilistic classification models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MCC">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents the Matthews Correlation Coefficient (MCC) metric, especially useful for imbalanced datasets.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CohenKappa">
        <rdfs:subClassOf rdf:resource="#ClassificationMetrics"/>
        <rdfs:comment>This class represents Cohen's Kappa metric, which measures agreement between predicted and actual labels.</rdfs:comment>
    </owl:Class>

    <!-- ClusteringMetrics -->
    <owl:Class rdf:about="#ClusteringMetrics">
        <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
        <rdfs:comment>This class represents the metrics used to evaluate clustering models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SilhouetteScore">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Silhouette Score metric, which measures how well instances are clustered.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#IntraClusterDistance">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Intra-Cluster Distance metric, which measures the compactness of clusters.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InterClusterDistance">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Inter-Cluster Distance metric, which measures the separation between clusters.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DaviesBouldinIndex">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Davies-Bouldin Index metric, which measures the ratio of intra-cluster and inter-cluster distances.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ARI">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Adjusted Rand Index (ARI), which measures clustering similarity by adjusting for random chance.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#NMI">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Normalized Mutual Information (NMI) metric, which measures the shared information between clustering assignments.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CalinskiHarabaszIndex">
        <rdfs:subClassOf rdf:resource="#ClusteringMetrics"/>
        <rdfs:comment>This class represents the Calinski-Harabasz Index metric, which evaluates the ratio of between-cluster and within-cluster dispersion.</rdfs:comment>
    </owl:Class>

    <!-- RegressionMetrics -->
    <owl:Class rdf:about="#RegressionMetrics">
        <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
        <rdfs:comment>This class represents the metrics used to evaluate regression models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MeanSquaredError">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Mean Squared Error (MSE) metric for regression models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#R2Score">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the R² Score metric for regression models, which measures the proportion of variance explained by the model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MeanAbsoluteError">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Mean Absolute Error (MAE) metric for regression models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RootMeanSquaredError">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Root Mean Squared Error (RMSE) metric for regression models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ExplainedVariance">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Explained Variance metric for regression models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MBD">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Mean Bias Deviation (MBD) metric, which measures the bias in a model’s predictions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#HeteroscedasticityScore">
        <rdfs:subClassOf rdf:resource="#RegressionMetrics"/>
        <rdfs:comment>This class represents the Heteroscedasticity Score, which measures variability in prediction errors across different levels of the target variable.</rdfs:comment>
    </owl:Class>

    <!-- GeneralMetrics -->
    <owl:Class rdf:about="#GeneralMetrics">
        <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
        <rdfs:comment>This class represents general evaluation metrics that apply across various models and tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CrossValidationScore">
        <rdfs:subClassOf rdf:resource="#GeneralMetrics"/>
        <rdfs:comment>This class represents the Cross-Validation Score metric, which measures the model’s performance across multiple splits of the data.</rdfs:comment>
    </owl:Class>

   <owl:Class rdf:about="#ComputationalEfficiency">
        <rdfs:subClassOf rdf:resource="#GeneralMetrics"/>
        <rdfs:comment>This class represents the Computational Efficiency metric, which measures the computational resources consumed during model training and evaluation.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LearningCurve">
        <rdfs:subClassOf rdf:resource="#GeneralMetrics"/>
        <rdfs:comment>This class represents the Learning Curve metric, which tracks the model's performance over time as more data is labeled and the model is updated.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AnnotationEfficiency">
        <rdfs:subClassOf rdf:resource="#GeneralMetrics"/>
        <rdfs:comment>This class represents the Annotation Efficiency metric, which measures the number of human annotations required to achieve a specific model performance level.</rdfs:comment>
    </owl:Class>

    <!-- Scenario-Specific Metrics -->
    <owl:Class rdf:about="#ScenarioSpecificMetrics">
        <rdfs:subClassOf rdf:resource="#EvaluationMetrics"/>
        <rdfs:comment>This class represents evaluation metrics specific to different Active Learning scenarios.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#QueryEfficiency">
        <rdfs:subClassOf rdf:resource="#ScenarioSpecificMetrics"/>
        <rdfs:comment>This class represents the Query Efficiency metric, which measures how effectively the selected instances improve the model’s performance relative to the number of queries made.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LabelingCost">
        <rdfs:subClassOf rdf:resource="#ScenarioSpecificMetrics"/>
        <rdfs:comment>This class represents the Labeling Cost metric, which quantifies the cost (monetary, time, or effort) associated with labeling instances in Active Learning scenarios.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InstanceDiversity">
        <rdfs:subClassOf rdf:resource="#ScenarioSpecificMetrics"/>
        <rdfs:comment>This class represents the Instance Diversity metric, which measures the diversity of the instances selected for labeling in Active Learning scenarios.</rdfs:comment>
    </owl:Class>

<!-- SystemInfrastructure Class as a Subclass of ActiveLearning -->
    <owl:Class rdf:about="#SystemInfrastructure">
        <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
        <rdfs:comment>This class represents the system infrastructure that supports the Active Learning pipeline, including data storage, computation, GUI, communication protocols, and middleware.</rdfs:comment>
    </owl:Class>

    <!-- DataStorage -->
    <owl:Class rdf:about="#DataStorage">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents the infrastructure responsible for storing datasets, models, and logs.</rdfs:comment>
    </owl:Class>

    <!-- LocalStorage -->
    <owl:Class rdf:about="#LocalStorage">
        <rdfs:subClassOf rdf:resource="#DataStorage"/>
        <rdfs:comment>This class represents data storage on local servers or physical machines.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ServerStorage">
        <rdfs:subClassOf rdf:resource="#LocalStorage"/>
        <rdfs:comment>This class represents storage on dedicated servers in on-premise systems.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PersonalMachineStorage">
        <rdfs:subClassOf rdf:resource="#LocalStorage"/>
        <rdfs:comment>This class represents data stored on personal machines or workstations.</rdfs:comment>
    </owl:Class>

    <!-- CloudStorage -->
    <owl:Class rdf:about="#CloudStorage">
        <rdfs:subClassOf rdf:resource="#DataStorage"/>
        <rdfs:comment>This class represents cloud-based storage, such as AWS S3 or Google Cloud Storage.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ObjectStorage">
        <rdfs:subClassOf rdf:resource="#CloudStorage"/>
        <rdfs:comment>This class represents object storage in cloud environments.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RelationalStorage">
        <rdfs:subClassOf rdf:resource="#CloudStorage"/>
        <rdfs:comment>This class represents relational database storage in cloud environments.</rdfs:comment>
    </owl:Class>

    <!-- ModelStorage -->
    <owl:Class rdf:about="#ModelStorage">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents infrastructure for storing machine learning models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#LocalModelStorage">
        <rdfs:subClassOf rdf:resource="#ModelStorage"/>
        <rdfs:comment>This class represents model storage on local servers.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CloudModelStorage">
        <rdfs:subClassOf rdf:resource="#ModelStorage"/>
        <rdfs:comment>This class represents model storage in cloud environments.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#VersionControlledModelStorage">
        <rdfs:subClassOf rdf:resource="#ModelStorage"/>
        <rdfs:comment>This class represents model storage with version control to track changes and updates to models over time.</rdfs:comment>
    </owl:Class>

    <!-- ComputationalInfrastructure -->
    <owl:Class rdf:about="#ComputationalInfrastructure">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents computational resources for training, evaluating, and updating models.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#OnPremiseComputation">
        <rdfs:subClassOf rdf:resource="#ComputationalInfrastructure"/>
        <rdfs:comment>This class represents computation performed on physical machines located on-premise.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#GPUCluster">
        <rdfs:subClassOf rdf:resource="#OnPremiseComputation"/>
        <rdfs:comment>This class represents a cluster of GPUs used for model training, especially in deep learning tasks.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CPUCluster">
        <rdfs:subClassOf rdf:resource="#OnPremiseComputation"/>
        <rdfs:comment>This class represents a cluster of CPUs used for general computational tasks in Active Learning.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CloudComputation">
        <rdfs:subClassOf rdf:resource="#ComputationalInfrastructure"/>
        <rdfs:comment>This class represents computational resources in cloud environments, such as AWS EC2 or Google Cloud Compute.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AutoScalingComputation">
        <rdfs:subClassOf rdf:resource="#CloudComputation"/>
        <rdfs:comment>This class represents cloud-based computation systems that scale automatically with demand.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DedicatedInstanceComputation">
        <rdfs:subClassOf rdf:resource="#CloudComputation"/>
        <rdfs:comment>This class represents cloud-based systems that use dedicated hardware instances for computation.</rdfs:comment>
    </owl:Class>

    <!-- GUIInfrastructure -->
    <owl:Class rdf:about="#GUIInfrastructure">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents the infrastructure that provides user interfaces for human annotators to interact with the Active Learning system.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#WebBasedGUI">
        <rdfs:subClassOf rdf:resource="#GUIInfrastructure"/>
        <rdfs:comment>This class represents a web-based interface for annotators to interact with the Active Learning system.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DesktopGUI">
        <rdfs:subClassOf rdf:resource="#GUIInfrastructure"/>
        <rdfs:comment>This class represents a desktop-based interface for annotators, often used in specialized environments.</rdfs:comment>
    </owl:Class>

    <!-- CommunicationProtocol -->
    <owl:Class rdf:about="#CommunicationProtocol">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents communication protocols that handle interactions between different components of the system.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#RESTfulAPI">
        <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
        <rdfs:comment>This class represents communication using REST (Representational State Transfer), commonly used in web services.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#MessageQueue">
        <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
        <rdfs:comment>This class represents communication using message queues like RabbitMQ or Kafka for distributed systems.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#gRPCProtocol">
        <rdfs:subClassOf rdf:resource="#CommunicationProtocol"/>
        <rdfs:comment>This class represents communication using gRPC (Remote Procedure Call) for high-performance interactions between services.</rdfs:comment>
    </owl:Class>

    <!-- Middleware -->
    <owl:Class rdf:about="#Middleware">
        <rdfs:subClassOf rdf:resource="#SystemInfrastructure"/>
        <rdfs:comment>This class represents the middleware that facilitates communication and coordination between system components.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#DataPipelineMiddleware">
        <rdfs:subClassOf rdf:resource="#Middleware"/>
        <rdfs:comment>This class represents middleware responsible for managing data flow between different parts of the Active Learning system.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TaskSchedulingMiddleware">
        <rdfs:subClassOf rdf:resource="#Middleware"/>
        <rdfs:comment>This class represents middleware that handles task scheduling, including retraining and evaluation tasks in the Active Learning workflow.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AnnotationManagementMiddleware">
        <rdfs:subClassOf rdf:resource="#Middleware"/>
        <rdfs:comment>This class represents middleware responsible for managing the interactions between human annotators and the system, ensuring that labeling queries are efficiently routed for annotation.</rdfs:comment>
    </owl:Class>
	 
	 <!-- Property: for Active Learning supportedByInfrastructure (Consolidated) -->
	 <!-- Property: supportedByInfrastructure (Consolidated) -->
<owl:ObjectProperty rdf:about="#supportedByInfrastructure">
    <rdfs:domain rdf:resource="#ActiveLearning"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:comment>This property links ALPipeline, models, and data to the system infrastructure that supports their execution.</rdfs:comment>
</owl:ObjectProperty>

<!-- Restrict the use of supportedByInfrastructure for ALPipeline -->
<owl:Class rdf:about="#ALPipeline">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#supportedByInfrastructure"/>
            <owl:someValuesFrom rdf:resource="#SystemInfrastructure"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Restrict the use of supportedByInfrastructure for Model -->
<owl:Class rdf:about="#Model">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#supportedByInfrastructure"/>
            <owl:someValuesFrom rdf:resource="#SystemInfrastructure"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>

<!-- Restrict the use of supportedByInfrastructure for Data (Dataset specifically) -->
<owl:Class rdf:about="#Dataset">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="#supportedByInfrastructure"/>
            <owl:someValuesFrom rdf:resource="#SystemInfrastructure"/>
        </owl:Restriction>
    </rdfs:subClassOf>
</owl:Class>
	 <!-- WHERE IS THIS FROM???? -->
	
    <!-- Property: hasMultipleLabels -->
    <owl:DatatypeProperty rdf:about="#hasMultipleLabels">
        <rdfs:domain rdf:resource="#ClassificationTask"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>This property indicates whether an instance can belong to multiple labels simultaneously.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasLabelStatus -->
    <owl:DatatypeProperty rdf:about="#hasLabelStatus">
        <rdfs:domain rdf:resource="#LabeledInstance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property describes the label status of an instance (e.g., complete, ambiguous).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasQueryStatus -->
    <owl:DatatypeProperty rdf:about="#hasQueryStatus">
        <rdfs:domain rdf:resource="#UnlabeledInstance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property indicates whether an instance has been queried for labeling.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasUncertaintyMeasure -->
    <owl:DatatypeProperty rdf:about="#hasUncertaintyMeasure">
        <rdfs:domain rdf:resource="#UncertaintySampling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property represents the measure of uncertainty used in instance selection (e.g., least-confidence).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasSource -->
    <owl:DatatypeProperty rdf:about="#hasSource">
        <rdfs:domain rdf:resource="#FeedbackLoop"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property indicates the source of feedback in the pipeline (e.g., model performance or user feedback).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasLocation -->
    <owl:DatatypeProperty rdf:about="#hasLocation">
        <rdfs:domain rdf:resource="#DataStorage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property specifies the location of data storage (e.g., on-premise or cloud).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasEvaluationType -->
    <owl:DatatypeProperty rdf:about="#hasEvaluationType">
        <rdfs:domain rdf:resource="#EvaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property represents the type of evaluation metric used (e.g., cross-validation).</rdfs:comment>
    </owl:DatatypeProperty>
	
	<!-- Disjointness Axioms for Top-Level Classes -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#ALPipeline"/>
        <rdf:Description rdf:about="#ALScenario"/>
        <rdf:Description rdf:about="#ALTask"/>
        <rdf:Description rdf:about="#QueryStrategy"/>
        <rdf:Description rdf:about="#Data"/>
        <rdf:Description rdf:about="#HumanAnnotator"/>
        <rdf:Description rdf:about="#Model"/>
        <rdf:Description rdf:about="#EvaluationMetrics"/>
        <rdf:Description rdf:about="#SystemInfrastructure"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for ALPipeline Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#DataCollection"/>
        <rdf:Description rdf:about="#ModelTraining"/>
        <rdf:Description rdf:about="#Annotation"/>
        <rdf:Description rdf:about="#ModelUpdate"/>
        <rdf:Description rdf:about="#FeedbackLoop"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for ALScenario Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#PoolBasedScenario"/>
        <rdf:Description rdf:about="#StreamBasedScenario"/>
        <rdf:Description rdf:about="#QuerySynthesisScenario"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for ALTask Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#ClassificationTask"/>
        <rdf:Description rdf:about="#ClusteringTask"/>
        <rdf:Description rdf:about="#RegressionTask"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for QueryStrategy Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#UncertaintySampling"/>
        <rdf:Description rdf:about="#QueryByCommittee"/>
        <rdf:Description rdf:about="#ExpectedModelChange"/>
        <rdf:Description rdf:about="#ExpectedErrorReduction"/>
        <rdf:Description rdf:about="#DensityWeightedSampling"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for Data Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#LabeledDataset"/>
        <rdf:Description rdf:about="#UnlabeledDataset"/>
        <rdf:Description rdf:about="#Instance"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for HumanAnnotator Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#ExpertAnnotator"/>
        <rdf:Description rdf:about="#NoviceAnnotator"/>
        <rdf:Description rdf:about="#CrowdsourcedAnnotator"/>
        <rdf:Description rdf:about="#AssistedAnnotator"/>
    </owl:members>
</owl:AllDisjointClasses>

<!-- Disjointness for Model Subclasses -->
<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
        <rdf:Description rdf:about="#ClassificationModel"/>
        <rdf:Description rdf:about="#ClusteringModel"/>
        <rdf:Description rdf:about="#RegressionModel"/>
