<owl:DatatypeProperty rdf:about="#hasDataQuality">
    <rdfs:domain rdf:resource="#MetadataEnhancedDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property represents the quality of the dataset, based on the metadata associated with it.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Properties for SyntheticInstance Object Properties -->

<!-- Property: generatedBy -->
<owl:ObjectProperty rdf:about="#generatedBy">
    <rdfs:domain rdf:resource="#SyntheticInstance"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>This property links a synthetic instance to the query strategy used to generate it (e.g., query synthesis strategies).</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasOriginalInstance -->
<owl:ObjectProperty rdf:about="#hasOriginalInstance">
    <rdfs:domain rdf:resource="#SyntheticInstance"/>
    <rdfs:range rdf:resource="#Instance"/>
    <rdfs:comment>This property links a synthetic instance to its original instance, from which it was derived or generated.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties -->

<!-- Property: hasGenerationScore -->
<owl:DatatypeProperty rdf:about="#hasGenerationScore">
    <rdfs:domain rdf:resource="#SyntheticInstance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the score or probability that an instance was generated as part of the query synthesis process.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Properties for OutlierInstance Object Properties -->

<!-- Property: detectedBy -->
<owl:ObjectProperty rdf:about="#detectedBy">
    <rdfs:domain rdf:resource="#OutlierInstance"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links an outlier instance to the model that detected it as an outlier.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties -->

<!-- Property: hasOutlierScore -->
<owl:DatatypeProperty rdf:about="#hasOutlierScore">
    <rdfs:domain rdf:resource="#OutlierInstance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the score or confidence that the instance is an outlier.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Properties for PoolDataset and StreamDataset Object Properties -->
 
<!-- Property: isQueriedBy -->
<owl:ObjectProperty rdf:about="#isQueriedBy">
    <rdfs:domain rdf:resource="#PoolDataset"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>This property links a pool dataset to the query strategy that selects instances from it for labeling.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isStreamedThrough">
    <rdfs:domain rdf:resource="#StreamDataset"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:comment>This property links a stream dataset to the system infrastructure responsible for streaming the data during the Active Learning process.</rdfs:comment>
</owl:ObjectProperty>

 <!-- Object Properties for SystemInfrastructure and its Subclasses -->
 
 <!-- Interaction Properties between SystemInfrastructure and Other Top Classes -->

<!-- Property: supportsALPipeline -->
<owl:ObjectProperty rdf:about="#supportsALPipeline">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>Links the system infrastructure to the Active Learning pipeline it supports.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: storesDataForTask -->
<owl:ObjectProperty rdf:about="#storesDataForTask">
    <rdfs:domain rdf:resource="#DataStorage"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>This property links data storage to the specific Active Learning task for which data is being stored.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: trainsModel -->
<owl:ObjectProperty rdf:about="#trainsModel">
    <rdfs:domain rdf:resource="#ComputationalInfrastructure"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links computational resources to the machine learning model being trained.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: supportsHumanAnnotator -->
<owl:ObjectProperty rdf:about="#supportsHumanAnnotator">
    <rdfs:domain rdf:resource="#GUIInfrastructure"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>This property links the GUI infrastructure to the human annotators who use it for labeling tasks.</rdfs:comment>
</owl:ObjectProperty>
	
<!-- Property: supportsScenario -->
<owl:ObjectProperty rdf:about="#supportsScenario">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>This property links the system infrastructure to the specific Active Learning scenarios it supports, such as pool-based or stream-based scenarios.</rdfs:comment>
</owl:ObjectProperty>

 <!-- Object Properties for SystemInfrastructure and its Subclasses -->

<!-- Property: supportsPipeline -->
<owl:ObjectProperty rdf:about="#supportsPipeline">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>This property links the system infrastructure to the Active Learning pipeline it supports.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: handlesDataStorage -->
<owl:ObjectProperty rdf:about="#handlesDataStorage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#DataStorage"/>
    <rdfs:comment>This property indicates the infrastructure responsible for handling data storage within the system.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: handlesModelStorage -->
<owl:ObjectProperty rdf:about="#handlesModelStorage">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#ModelStorage"/>
    <rdfs:comment>This property links the system infrastructure to the model storage facilities it provides.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: providesComputation -->
<owl:ObjectProperty rdf:about="#providesComputation">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#ComputationalInfrastructure"/>
    <rdfs:comment>This property links the system infrastructure to the computational resources it provides for model training and evaluation.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: enablesAnnotationInterface -->
<owl:ObjectProperty rdf:about="#enablesAnnotationInterface">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#GUIInfrastructure"/>
    <rdfs:comment>This property links the system infrastructure to the GUI that supports human annotators in the Active Learning process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: facilitatesCommunication -->
<owl:ObjectProperty rdf:about="#facilitatesCommunication">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#CommunicationProtocol"/>
    <rdfs:comment>This property links the system infrastructure to the communication protocols used to handle interactions between different components of the system.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: managesMiddleware -->
<owl:ObjectProperty rdf:about="#managesMiddleware">
    <rdfs:domain rdf:resource="#SystemInfrastructure"/>
    <rdfs:range rdf:resource="#Middleware"/>
    <rdfs:comment>This property links the system infrastructure to the middleware components that manage coordination and data flow within the system.</rdfs:comment>
</owl:ObjectProperty>

<!--  Data Properties for SystemInfrastructure and its Subclasses -->
 
<!-- Property: hasStorageCapacity -->
<owl:DatatypeProperty rdf:about="#hasStorageCapacity">
    <rdfs:domain rdf:resource="#DataStorage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the storage capacity (in terabytes) available in the data storage infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasComputationPower -->
<owl:DatatypeProperty rdf:about="#hasComputationPower">
    <rdfs:domain rdf:resource="#ComputationalInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the computational power (in TFLOPS) available in the computational infrastructure.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasMaxConcurrentTasks -->
<owl:DatatypeProperty rdf:about="#hasMaxConcurrentTasks">
    <rdfs:domain rdf:resource="#TaskSchedulingMiddleware"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property defines the maximum number of tasks that can be concurrently scheduled by the task scheduling middleware.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasAnnotationEfficiency -->
<owl:DatatypeProperty rdf:about="#hasAnnotationEfficiency">
    <rdfs:domain rdf:resource="#AnnotationManagementMiddleware"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property defines the efficiency of the annotation management system, measured as the average time taken per annotation.</rdfs:comment>
</owl:DatatypeProperty>

</rdf:RDF>

