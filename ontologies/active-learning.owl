  <!-- Equivalence Axioms -->
 <!-- MultiLabelClassificationTask -->
    <owl:Class rdf:about="#MultiLabelClassificationTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#ClassificationTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasMultipleLabels"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- FullyLabeledInstance -->
    <owl:Class rdf:about="#FullyLabeledInstance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#LabeledInstance"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasLabelStatus"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">complete</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- AmbiguousLabeledInstance -->
    <owl:Class rdf:about="#AmbiguousLabeledInstance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#LabeledInstance"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasLabelStatus"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ambiguous</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- QueriedInstance -->
    <owl:Class rdf:about="#QueriedInstance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#UnlabeledInstance"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasQueryStatus"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">queried</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- LeastConfidenceSampling -->
    <owl:Class rdf:about="#LeastConfidenceSampling">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#UncertaintySampling"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasUncertaintyMeasure"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">least-confidence</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ModelPerformanceFeedback -->
    <owl:Class rdf:about="#ModelPerformanceFeedback">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#FeedbackLoop"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasSource"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">model-performance</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- CloudStorage -->
    <owl:Class rdf:about="#CloudStorage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#DataStorage"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasLocation"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cloud</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- LocalStorage -->
    <owl:Class rdf:about="#LocalStorage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#DataStorage"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasLocation"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">on-premise</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- CrossValidationScore -->
    <owl:Class rdf:about="#CrossValidationScore">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#GeneralMetrics"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasEvaluationType"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cross-validation</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
	
	 <!-- Refined Object Properties for ALPipeline class -->

<!-- Property: hasInstanceSelection -->
<owl:ObjectProperty rdf:about="#hasInstanceSelection">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>Links the ALPipeline to the instance selection process based on a specific query strategy.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasEvaluation -->
<owl:ObjectProperty rdf:about="#hasEvaluation">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:comment>Links the ALPipeline to the evaluation process, specifying the metrics used to assess the performance of the pipeline and the model.</rdfs:comment>
</owl:ObjectProperty>

<!-- Refined Property: hasFeedback -->
<owl:ObjectProperty rdf:about="#hasFeedback">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#FeedbackLoop"/>
    <rdfs:comment>Links the ALPipeline to feedback loops, which incorporate feedback from model performance and human annotators for continuous improvement.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: usesHumanAnnotator -->
<owl:ObjectProperty rdf:about="#usesHumanAnnotator">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>Links the ALPipeline to human annotators, who are involved in labeling instances or providing feedback on uncertain cases.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: hasData -->
<owl:ObjectProperty rdf:about="#hasData">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:comment>Links the ALPipeline to the data used for training, evaluating, and querying in the active learning process.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: managesTask -->
<owl:ObjectProperty rdf:about="#managesTask">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>Links the ALPipeline to the specific tasks (classification, clustering, or regression) that are managed within the pipeline.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: includesModel -->
<owl:ObjectProperty rdf:about="#includesModel">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>Links the ALPipeline to the model used in the active learning process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: supportsALScenario -->
<owl:ObjectProperty rdf:about="#supportsALScenario">
    <rdfs:domain rdf:resource="#ALPipeline"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>Links the ALPipeline to the specific scenarios supported, such as pool-based or stream-based scenarios.</rdfs:comment>
</owl:ObjectProperty>

    <!-- Data Properties -->
    <!-- Property: hasAnnotationEfficiency -->
    <owl:DatatypeProperty rdf:about="#hasAnnotationEfficiency">
        <rdfs:domain rdf:resource="#Annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This property represents the efficiency of annotation in the Active Learning process.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasModelPerformance -->
    <owl:DatatypeProperty rdf:about="#hasModelPerformance">
        <rdfs:domain rdf:resource="#ModelTraining"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This property represents the performance of the model during training, typically measured by evaluation metrics.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Property: hasQueryEfficiency -->
    <owl:DatatypeProperty rdf:about="#hasQueryEfficiency">
        <rdfs:domain rdf:resource="#ALPipeline"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This property represents the efficiency of the query process in Active Learning.</rdfs:comment>
    </owl:DatatypeProperty>
	
	<!-- Property: hasInstanceSelectionCriteria -->
<owl:ObjectProperty rdf:about="#hasInstanceSelectionCriteria">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property links the query strategy to the criteria used for selecting instances, such as uncertainty, diversity, or representativeness.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: isPartOfPipeline -->
<owl:ObjectProperty rdf:about="#isPartOfPipeline">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>This property links the query strategy to the active learning pipeline in which it is used.</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: isUsedForTask -->
<owl:ObjectProperty rdf:about="#isUsedForTask">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>This property links the query strategy to the specific active learning task (classification, clustering, regression).</rdfs:comment>
</owl:ObjectProperty>

<!-- Existing Property: hasPerformanceImpact -->
<owl:ObjectProperty rdf:about="#hasPerformanceImpact">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#EvaluationMetrics"/>
    <rdfs:comment>This property links the query strategy to performance evaluation metrics.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: queriesData -->
<owl:ObjectProperty rdf:about="#queriesData">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdfs:comment>This property links the query strategy to the data (dataset or instances) it selects for labeling or review.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: assistedByHumanAnnotator -->
<owl:ObjectProperty rdf:about="#assistedByHumanAnnotator">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>This property links the query strategy to the human annotator, if human input is required for certain selections.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: optimizedByModel -->
<owl:ObjectProperty rdf:about="#optimizedByModel">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the query strategy to the model used to optimize or guide the instance selection process.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: implementedInScenario -->
<owl:ObjectProperty rdf:about="#implementedInScenario">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>This property links the query strategy to the specific active learning scenario where it is implemented (e.g., pool-based, stream-based).</rdfs:comment>
</owl:ObjectProperty>

<!-- Property: hasCommittee -->
<owl:ObjectProperty rdf:about="#hasCommittee">
    <rdfs:domain rdf:resource="#QueryByCommittee"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>This property links the QueryByCommittee strategy to the committee of models used for instance selection.</rdfs:comment>
</owl:ObjectProperty>

<!-- Data Properties -->
<!-- Property: hasUncertaintyMeasure -->
<owl:DatatypeProperty rdf:about="#hasUncertaintyMeasure">
    <rdfs:domain rdf:resource="#UncertaintySampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property represents the uncertainty measure used in uncertainty sampling (e.g., least-confidence, margin, entropy).</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasDiversityMeasure -->
<owl:DatatypeProperty rdf:about="#hasDiversityMeasure">
    <rdfs:domain rdf:resource="#DensityWeightedSampling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>This property represents the diversity measure used in density-weighted sampling.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasImpactScore -->
<owl:DatatypeProperty rdf:about="#hasImpactScore">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property represents the estimated impact of the query strategy on model performance.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasNumberOfQueries -->
<owl:DatatypeProperty rdf:about="#hasNumberOfQueries">
    <rdfs:domain rdf:resource="#QueryStrategy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>This property represents the number of queries made by the strategy.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasExpectedModelChange -->
<owl:DatatypeProperty rdf:about="#hasExpectedModelChange">
    <rdfs:domain rdf:resource="#ExpectedModelChange"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property quantifies the expected model change from the query strategy.</rdfs:comment>
</owl:DatatypeProperty>

<!-- Property: hasRiskReduction -->
<owl:DatatypeProperty rdf:about="#hasRiskReduction">
    <rdfs:domain rdf:resource="#ExpectedErrorReduction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>This property quantifies the expected risk reduction from the strategy in terms of error reduction.</rdfs:comment>
</owl:DatatypeProperty>

 <!-- Object Properties Evaluation metrics class -->
<!-- Refined Property: hasEvaluatedModel -->
<owl:ObjectProperty rdf:about="#hasEvaluatedModel">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#Model"/>
    <rdfs:comment>Links the evaluation metric to the specific model being evaluated.</rdfs:comment>
</owl:ObjectProperty>

<!-- Refined Property: hasEvaluationStrategy -->
<owl:ObjectProperty rdf:about="#hasEvaluationStrategy">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#QueryStrategy"/>
    <rdfs:comment>Links the evaluation metric to the query strategy used during the evaluation process.</rdfs:comment>
</owl:ObjectProperty>

<!-- Refined Property: hasEvaluationScenario -->
<owl:ObjectProperty rdf:about="#hasEvaluationScenario">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#ALScenario"/>
    <rdfs:comment>Links the evaluation metric to the scenario under which the evaluation was performed (e.g., pool-based, stream-based).</rdfs:comment>
</owl:ObjectProperty>

<!-- Refined Property: evaluatesTask -->
<owl:ObjectProperty rdf:about="#evaluatesTask">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#ALTask"/>
    <rdfs:comment>Links the evaluation metric to the specific Active Learning task being evaluated (e.g., classification, clustering, regression).</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: isDerivedFromDataset -->
<owl:ObjectProperty rdf:about="#isDerivedFromDataset">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#Dataset"/>
    <rdfs:comment>Links the evaluation metric to the dataset from which the performance metrics are derived.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: isInformedByHumanAnnotator -->
<owl:ObjectProperty rdf:about="#isInformedByHumanAnnotator">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#HumanAnnotator"/>
    <rdfs:comment>Links the evaluation metric to the human annotators who contributed annotations used in the evaluation.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: measuresPipelinePerformance -->
<owl:ObjectProperty rdf:about="#measuresPipelinePerformance">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#ALPipeline"/>
    <rdfs:comment>Links the evaluation metric to the overall pipeline performance it is assessing.</rdfs:comment>
</owl:ObjectProperty>

<!-- New Property: supportsInfrastructureRequirements -->
<owl:ObjectProperty rdf:about="#supportsInfrastructureRequirements">
    <rdfs:domain rdf:resource="#EvaluationMetrics"/>
    <rdfs:range rdf:resource="#SystemInfrastructure"/>
    <rdfs:comment>Links the evaluation metric to the system infrastructure requirements it measures, ensuring the model's scalability and operational capabilities.</rdfs:comment>
</owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="#hasAccuracy">
        <rdfs:domain rdf:resource="#ClassificationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the accuracy of the classification model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasPrecision">
        <rdfs:domain rdf:resource="#ClassificationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the precision of the classification model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasRecall">
        <rdfs:domain rdf:resource="#ClassificationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the recall of the classification model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasF1Score">
        <rdfs:domain rdf:resource="#ClassificationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the F1 score of the classification model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasMSE">
        <rdfs:domain rdf:resource="#RegressionMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the Mean Squared Error of the regression model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasR2Score">
        <rdfs:domain rdf:resource="#RegressionMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the R² score of the regression model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasSilhouetteScore">
        <rdfs:domain rdf:resource="#ClusteringMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the silhouette score of the clustering model.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasAnnotationCost">
        <rdfs:domain rdf:resource="#ScenarioSpecificMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the cost of human annotation.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasQueryEfficiency">
        <rdfs:domain rdf:resource="#ScenarioSpecificMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the efficiency of the query process in Active Learning.</rdfs:comment>
    </owl:DatatypeProperty>
	
	<!-- Object Properties for ALTask -->
<!-- Property: hasRegressionModel -->
<owl:ObjectProperty rdf:about="#hasRegressionModel">
    <rdfs:domain rdf:resource="#RegressionTask"/>
    <rdfs:range rdf:resource="#RegressionModel"/>
